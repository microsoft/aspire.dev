<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Prototype (E2E driver and browser alternatives): a slice of src/frontend/tests/e2e ported to xUnit on
    Jint.Browser's own .NET API, in process, without CDP or a browser binary. It runs against StaticHost
    at E2E_BASE_URL (default http://127.0.0.1:4322), like the Playwright suite.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jint 5 is not on nuget.org yet; NuGet.config maps Jint.* to the Jint preview feed. -->
    <PackageReference Include="Jint.Browser" Version="5.0.0-preview.2503" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
