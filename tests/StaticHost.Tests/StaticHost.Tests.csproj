<Project Sdk="Microsoft.NET.Sdk">

  <!-- Supply orchestration metadata for the fixture's standalone testing builder. -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <TreatProjectReferencesAsResources>false</TreatProjectReferencesAsResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Redis" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.5.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      We deliberately do NOT reference frontend.esproj. The agent-readiness
      middlewares operate on IWebHostEnvironment.WebRootFileProvider, so each
      test fixture provides its own temp wwwroot directory with the exact
      static layout it wants to assert on.
    -->
    <ProjectReference Include="..\..\src\statichost\StaticHost\StaticHost.csproj" />
  </ItemGroup>

</Project>
