{
  "name": "aspire.dev - Codespaces Dev Container",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.4.3"
    }
  },
  "containerEnv": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "CODESPACES.md"
      ]
    },
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "unifiedjs.vscode-mdx"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [
    4321
  ],
  "portsAttributes": {
    "4321": {
      "label": "Astro dev server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bun install --cwd ./src/frontend && echo '\n✨ Ready to go! Run \"bun run dev\" to start the dev server.\n'",
  "remoteUser": "node"
}