<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>false</SelfContained>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ContainerFamily>noble-chiseled</ContainerFamily>

    <!-- Disable default compression formats to specify only brotli. -->
    <EnableDefaultCompressionFormats>false</EnableDefaultCompressionFormats>
    <PublishCompressionFormats>brotli</PublishCompressionFormats>
    <!-- Optimize build times with Optimal Brotli instead of SmallestSize; publish ignores BrotliCompressionLevel: https://github.com/dotnet/sdk/issues/56679 -->
    <_BlazorBrotliCompressionLevel>Optimal</_BlazorBrotliCompressionLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.4.0" />
    <PackageReference Include="Aspire.Azure.Security.KeyVault" Version="13.6.0" />
    <PackageReference Include="Aspire.Microsoft.Azure.StackExchangeRedis" Version="13.6.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.10.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    <None Include="..\..\site\assets\css\aspire-brand.css"
          Link="aspire-brand.css"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The site is built into wwwroot by Douze (src/site/douze.yml): `douze -s src/site -o src/statichost/StaticHost/wwwroot`. -->

  <Import Project="Caching.targets" />
</Project>
