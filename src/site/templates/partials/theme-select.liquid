{%- comment -%}
  Starlight's ThemeSelect.astro: <starlight-theme-select> (scripts/client/theme-select.ts) and the inline call that
  shows the stored theme before paint. Root class: cid-sl-theme-select.
{%- endcomment -%}
<starlight-theme-select class="cid-sl-theme-select"><label style="--sl-select-width: 6.25em" class="cid-sl-select"><span class="sr-only">{{ "themeSelect.accessibleLabel" | t }}</span>{% icon "laptop", class: "icon label-icon", label: nil, size: nil, color: nil %}<select autocomplete="off"><option value="dark">{{ "themeSelect.dark" | t }}</option><option value="light">{{ "themeSelect.light" | t }}</option><option value="auto" selected>{{ "themeSelect.auto" | t }}</option></select>{% icon "down-caret", class: "icon caret", label: nil, size: nil, color: nil %}</label></starlight-theme-select>
<script>StarlightThemeProvider.updatePickers();</script>
