{%- comment -%}
  The site's MobileSiteLinks helper (src/frontend/src/components/starlight/MobileSiteLinks.astro): the site links of
  the mobile menu (docs, resources hub, live streams, install, cookies). The environment badge (PUBLIC_ENVIRONMENT_BADGE)
  and the site tour entry (PUBLIC_ENABLE_SITE_TOUR) read `site.environment_badge` and `site.site_tour` (unset: off).
  Reads base.liquid's sl_prefix, sl_url. Root class: cid-starlight-mobile-site-links.
{%- endcomment -%}
<div class="mobile-site-links not-content cid-starlight-mobile-site-links">
<ul aria-label="{{ 'footer.resources' | t }}">
<li><a href="{{ sl_prefix }}/docs/">{% icon "open-book" %}{{ "header.docs" | t }}</a></li>
<li><a href="/hub/" aria-label="Aspire resources"{% if sl_url contains "/hub/" %} aria-current="page"{% endif %}>{% include "partials/svg/dev-hub" %}Aspire resources</a></li>
<li><a href="/community/videos/" class="live-btn" data-live="false" data-source="none" data-tour-target="live-status"{% if sl_url == "/community/videos/" %} aria-current="page"{% endif %}>{% include "partials/svg/live" %}<span>Watch Aspire live streams</span><span class="live-dot" aria-hidden="true"></span></a></li>
<li><a href="{{ sl_prefix }}/get-started/install-cli/" data-tour-target="install-cli" data-tour-step="install-cli">{% icon "download" %}{{ "home.closing.install" | t }}</a></li>
<li><button type="button" data-cookie-manage-consent data-tour-target="cookie-preferences" data-tour-step="cookie-preferences">{% icon "setting" %}{{ "footer.manageCookies" | t }}</button></li>
{%- if site.site_tour %}
<li><button type="button" data-tour-trigger data-tour-target="tour-help" data-tour-step="tour-help">{% icon "information" %}{{ "siteTour.eyebrow" | t }}</button></li>
{%- endif %}
</ul>
{%- if site.environment_badge and site.environment_badge != "" %}{% badge site.environment_badge, variant: "tip", size: "small" %}{% endif %}
</div>
