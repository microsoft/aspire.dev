{%- comment -%}
  The filter box of the site's Sidebar override (scripts/client/sidebar.ts), shared by the topic and API sidebars.
{%- endcomment -%}
<div class="sidebar-filter sidebar-filter-row"><div class="sidebar-filter-wrap search-field search-field-wrap" data-search-size="sm"><svg class="search-field-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg><label class="sr-only" for="sidebar-filter-input">{{ "catalogSearch.sidebarLabel" | t }}</label><input type="search" name="sidebar-search" spellcheck="false" id="sidebar-filter-input" class="sidebar-filter-input search-field-input" placeholder="{{ 'catalogSearch.sidebarPlaceholder' | t }}" autocomplete="off" aria-label="{{ 'catalogSearch.sidebarLabel' | t }}"><button type="button" id="sidebar-filter-clear" class="sidebar-filter-clear search-field-clear" aria-label="{{ 'catalogSearch.clearSearch' | t }}" hidden><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 6-12 12M6 6l12 12"></path></svg></button></div><div id="sidebar-filter-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-count-template="{{ 'catalogSearch.sidebarCount' | t }}"></div></div>
<div class="sidebar-filter-empty search-empty" id="sidebar-filter-empty" data-message="{{ 'catalogSearch.sidebarEmpty' | t }}" aria-labelledby="sidebar-filter-empty-copy" hidden><p class="sidebar-filter-empty-copy search-empty-title" id="sidebar-filter-empty-copy"></p><p class="search-empty-hint">{{ "catalogSearch.queryGuidance" | t }}</p><button type="button" class="sidebar-filter-empty-action search-action" id="sidebar-filter-empty-action">{{ "catalogSearch.clearSearch" | t }}</button></div>
