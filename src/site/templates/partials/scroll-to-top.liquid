{%- comment -%} The site's ScrollToTop.astro (<aspire-scroll-to-top>, scripts/client/scroll-to-top.ts); label per language. Root class: cid-scroll-to-top. {%- endcomment -%}
{%- case sl_locale_key -%}
{%- when "da" -%}{%- assign st_label = "Rul op" -%}{%- when "de" -%}{%- assign st_label = "Nach oben scrollen" -%}{%- when "es" -%}{%- assign st_label = "Ir arriba" -%}{%- when "fr" -%}{%- assign st_label = "Retour en haut" -%}{%- when "hi" -%}{%- assign st_label = "ऊपर स्क्रॉल करें" -%}{%- when "id" -%}{%- assign st_label = "Gulir ke atas" -%}{%- when "it" -%}{%- assign st_label = "Torna su" -%}{%- when "ja" -%}{%- assign st_label = "トップへ戻る" -%}{%- when "ko" -%}{%- assign st_label = "맨 위로" -%}{%- when "pt-br" -%}{%- assign st_label = "Voltar ao topo" -%}{%- when "ru" -%}{%- assign st_label = "Наверх" -%}{%- when "tr" -%}{%- assign st_label = "Başa dön" -%}{%- when "uk" -%}{%- assign st_label = "Прокрутити вгору" -%}{%- when "zh-cn" -%}{%- assign st_label = "回到顶部" -%}
{%- else -%}{%- assign st_label = "Scroll to top" -%}
{%- endcase -%}
<aspire-scroll-to-top class="cid-scroll-to-top"><button id="scroll-to-top-button" class="scroll-to-top-button" type="button" aria-label="{{ st_label }}"><svg width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 16L12 8L20 16"></path></svg><span class="tooltip" aria-hidden="true">{{ st_label }}</span></button></aspire-scroll-to-top>
