{%- comment -%}
  The site's MobileMenuToggle override: <starlight-menu-button> (scripts/client/menu-button.ts).
  Root class: cid-starlight-mobile-menu-toggle.
{%- endcomment -%}
<starlight-menu-button class="print:hidden cid-starlight-mobile-menu-toggle" aria-expanded="false"><button type="button" aria-expanded="false" aria-controls="starlight__sidebar" aria-label="{{ 'menuButton.accessibleLabel' | t }}" class="sl-flex md:sl-hidden">{% icon "bars", class: "open-menu" %}{% icon "close", class: "close-menu" %}</button></starlight-menu-button>
