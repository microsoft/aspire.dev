{%- comment -%}
  The site's PageFrame override (src/frontend/src/components/starlight/PageFrame.astro): header, the sidebar column
  (the topic sidebar, or the mobile site links menu on pages without a sidebar) and the main frame, which holds
  base.liquid's captured `sl_main`. Root class: cid-starlight-page-frame.
{%- endcomment -%}
<div class="page sl-flex cid-starlight-page-frame">
<header class="header">{% include "partials/header" %}</header>
<nav class="sidebar print:hidden{% unless has_sidebar %} site-menu md:sl-hidden{% endunless %}" aria-label="{{ 'sidebarNav.accessibleLabel' | t }}">
{% include "partials/mobile-menu-toggle" %}
<div id="starlight__sidebar" class="sidebar-pane{% unless has_sidebar %} site-menu-panel{% endunless %}">
<div class="sidebar-content sl-flex">
{%- if has_sidebar %}
{% include "partials/sidebar" %}
{%- else %}
{% include "partials/mobile-site-links" %}
{%- endif %}
</div>
</div>
</nav>
<div class="main-frame">{{ sl_main }}</div>
</div>
