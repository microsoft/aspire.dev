{%- comment -%}
  The site's SkipLink override (a <nav> around Starlight's SkipLink.astro). Root classes: cid-starlight-skip-link
  (the nav), cid-sl-skip-link (the link). The target is the page title, #_top.
{%- endcomment -%}
<nav aria-label="Skip links" class="cid-starlight-skip-link"><a class="sl-skip-link cid-sl-skip-link" href="#_top">{{ "skipLink.label" | t }}</a></nav>
