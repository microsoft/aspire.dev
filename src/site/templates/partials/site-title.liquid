{%- comment -%}
  Starlight's SiteTitle.astro: the logo (one image for both themes: site.logo.light == site.logo.dark, so no
  light/dark pair) and the site title. Reads base.liquid's sl_prefix. Root class: cid-sl-site-title.
{%- endcomment -%}
<a href="{{ sl_prefix }}/" class="site-title sl-flex cid-sl-site-title">
{%- if site.logo.light != site.logo.dark %}
<img class="light:sl-hidden print:hidden" alt="{{ site.logo.alt }}" src="{{ site.logo.dark }}" width="32" height="32"><img class="dark:sl-hidden print:block" alt="{{ site.logo.alt }}" src="{{ site.logo.light }}" width="32" height="32">
{%- else %}
<img alt="{{ site.logo.alt }}" src="{{ site.logo.dark }}" width="32" height="32">
{%- endif %}
<span{% if site.logo.replacesTitle %} class="sr-only"{% endif %} translate="no">{{ site.title }}</span></a>
