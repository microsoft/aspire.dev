{%- comment -%}
  The site's PageTitle override (src/frontend/src/components/starlight/PageTitle.astro): the resources hub index
  pages (/hub/, /hub/browse/, /hub/glossary/) get the dev directory title; every other page starlight-page-actions'
  PageTitle (the h1, then the page actions). The h1 is #_top (the skip link's target). The inline script of the
  override (tour attributes, `api-page-title` class) is replaced by markup: the attributes are on the actions
  container, the class is set here from `api`. The title has ReadableText's <wbr> hints (partials/readable-text).
  Root class: cid-starlight-page-title.
{%- endcomment -%}
{%- if sl_locale_url == "/hub/" or sl_locale_url == "/hub/browse/" or sl_locale_url == "/hub/glossary/" -%}
<style>.content-panel:has(.dev-directory-title) > .sl-container { padding: 1.5rem 1rem; } .dev-directory-title { margin: 0; margin-inline-start: -1rem; } @media (min-width: 72rem) { .content-panel:has(.dev-directory-title) > .sl-container { padding-inline: 1.5rem; } .dev-directory-title { margin-inline-start: -1.5rem; } }</style>
<h1 id="_top" data-page-title class="dev-directory-title cid-starlight-page-title">{% if sl_locale_url == "/hub/" %}{% include "partials/svg/dev-hub" %}{% endif %}<span>{%- assign rt_text = title -%}{%- include "partials/readable-text" -%}</span></h1>
{%- else -%}
<h1 id="_top" class="page-title{% if api_page %} api-page-title{% endif %} cid-starlight-page-title">{%- assign rt_text = title -%}{%- include "partials/readable-text" -%}</h1>
{% include "partials/page-actions" %}
{%- endif -%}
