{%- comment -%}
  A topic of the resources hub (src/frontend/src/utils/dev-center/topics.ts): tp_id -> tp_title, tp_icon, tp_color
  (nil for an unknown id). The topics in order are dev_hub.topics (content/hub/dev-hub.yml).
{%- endcomment -%}
{%- assign tp_title = nil -%}{%- assign tp_icon = nil -%}{%- assign tp_color = nil -%}
{%- case tp_id -%}
  {%- when "foundations" -%}{%- assign tp_title = "Foundations" -%}{%- assign tp_icon = "open-book" -%}{%- assign tp_color = "var(--sl-color-purple)" -%}
  {%- when "integrations" -%}{%- assign tp_title = "Integrations" -%}{%- assign tp_icon = "puzzle" -%}{%- assign tp_color = "var(--sl-color-green)" -%}
  {%- when "dashboard" -%}{%- assign tp_title = "Dashboard" -%}{%- assign tp_icon = "seti:happenings" -%}{%- assign tp_color = "var(--sl-color-blue)" -%}
  {%- when "deployment" -%}{%- assign tp_title = "Deployment" -%}{%- assign tp_icon = "rocket" -%}{%- assign tp_color = "var(--sl-color-orange)" -%}
  {%- when "reference" -%}{%- assign tp_title = "Reference" -%}{%- assign tp_icon = "seti:json" -%}{%- assign tp_color = "var(--color-cyan)" -%}
  {%- when "community" -%}{%- assign tp_title = "Community" -%}{%- assign tp_icon = "heart" -%}{%- assign tp_color = "var(--color-magenta)" -%}
{%- endcase -%}
