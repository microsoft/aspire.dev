{%- comment -%}
  BrowseDropdown.astro (src/frontend/src/components/dev-center/): a filter or sort menu of the resource browser.
  Inputs: bd_name, bd_label, bd_multiple (false for the sort menu), bd_options (the HTML of its options, the
  .browse-filter-option labels or .browse-sort-row rows). Root class: cid-dev-center-browse-dropdown.
{%- endcomment -%}
<details class="browse-filter-group cid-dev-center-browse-dropdown" data-filter-group="{{ bd_name }}"><summary aria-label="{{ bd_label }}"><span data-dropdown-label>{{ bd_label }}</span>{% if bd_multiple %}<span class="browse-filter-active" data-filter-active="{{ bd_name }}" aria-hidden="true" hidden></span>{% endif %}{% icon "down-caret", size: "1rem", class: nil, label: nil, color: nil %}</summary><span class="browse-filter-backdrop" data-filter-dismiss aria-hidden="true"></span><div class="browse-filter-panel"><div class="browse-filter-mobile-header"><strong>{{ bd_label }}</strong><button type="button" data-filter-dismiss aria-label="Close {{ bd_label }}">{% icon "close", size: "1.25rem", class: nil, label: nil, color: nil %}</button></div><fieldset><legend class="sr-only">{{ bd_label }}</legend>{{ bd_options }}</fieldset></div></details>
