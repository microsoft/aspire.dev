{%- comment -%}
  An image of a resource card (resource-card-html.ts imageHtml): one <img>, or a light and a dark one, inside a
  <template data-resource-image> that the browser script materializes and a <noscript> copy. Inputs: ri_light,
  ri_dark (urls), ri_width, ri_height, ri_class (extra class or nil).
{%- endcomment -%}
{%- capture ri_markup -%}
{%- if ri_light == ri_dark -%}<img class="resource-image{% if ri_class %} {{ ri_class }}{% endif %}" src="{{ ri_light }}" alt="" width="{{ ri_width }}" height="{{ ri_height }}" loading="lazy" decoding="async">
{%- else -%}<img class="resource-image{% if ri_class %} {{ ri_class }}{% endif %} browse-image-light" src="{{ ri_light }}" alt="" width="{{ ri_width }}" height="{{ ri_height }}" loading="lazy" decoding="async"><img class="resource-image{% if ri_class %} {{ ri_class }}{% endif %} browse-image-dark" src="{{ ri_dark }}" alt="" width="{{ ri_width }}" height="{{ ri_height }}" loading="lazy" decoding="async">
{%- endif -%}
{%- endcapture -%}
<template data-resource-image>{{ ri_markup }}</template><noscript>{{ ri_markup }}</noscript>
