{%- comment -%}
  The label of a sample tag or resource facet (src/frontend/src/utils/sample-tags.ts tagLabel, and
  utils/dev-center/resource-search.ts resourceFacetLabel with tl_facet: true): tl_tag -> tl_label.
{%- endcomment -%}
{%- assign tl_label = nil -%}
{%- if tl_facet -%}
  {%- case tl_tag -%}
    {%- when "aws" -%}{%- assign tl_label = "AWS" -%}
    {%- when "gcp" -%}{%- assign tl_label = "Google Cloud" -%}
    {%- when "youtube" -%}{%- assign tl_label = "YouTube" -%}
  {%- endcase -%}
{%- endif -%}
{%- unless tl_label -%}
{%- case tl_tag -%}
  {%- when "csharp" -%}{%- assign tl_label = "C#" -%}
  {%- when "fsharp" -%}{%- assign tl_label = "F#" -%}
  {%- when "cpp" -%}{%- assign tl_label = "C++" -%}
  {%- when "python" -%}{%- assign tl_label = "Python" -%}
  {%- when "javascript" -%}{%- assign tl_label = "JavaScript" -%}
  {%- when "typescript" -%}{%- assign tl_label = "TypeScript" -%}
  {%- when "node" -%}{%- assign tl_label = "Node.js" -%}
  {%- when "go" -%}{%- assign tl_label = "Go" -%}
  {%- when "java" -%}{%- assign tl_label = "Java" -%}
  {%- when "redis" -%}{%- assign tl_label = "Redis" -%}
  {%- when "postgresql" -%}{%- assign tl_label = "PostgreSQL" -%}
  {%- when "sql-server" -%}{%- assign tl_label = "SQL Server" -%}
  {%- when "mysql" -%}{%- assign tl_label = "MySQL" -%}
  {%- when "mongodb" -%}{%- assign tl_label = "MongoDB" -%}
  {%- when "rabbitmq" -%}{%- assign tl_label = "RabbitMQ" -%}
  {%- when "kafka" -%}{%- assign tl_label = "Kafka" -%}
  {%- when "prometheus" -%}{%- assign tl_label = "Prometheus" -%}
  {%- when "grafana" -%}{%- assign tl_label = "Grafana" -%}
  {%- when "docker" -%}{%- assign tl_label = "Docker" -%}
  {%- when "azure" -%}{%- assign tl_label = "Azure" -%}
  {%- when "azure-functions" -%}{%- assign tl_label = "Azure Functions" -%}
  {%- when "azure-storage" -%}{%- assign tl_label = "Azure Storage" -%}
  {%- when "azure-service-bus" -%}{%- assign tl_label = "Service Bus" -%}
  {%- when "blazor" -%}{%- assign tl_label = "Blazor" -%}
  {%- when "orleans" -%}{%- assign tl_label = "Orleans" -%}
  {%- when "grpc" -%}{%- assign tl_label = "gRPC" -%}
  {%- when "ef-core" -%}{%- assign tl_label = "EF Core" -%}
  {%- when "metrics" -%}{%- assign tl_label = "Metrics" -%}
  {%- when "health-checks" -%}{%- assign tl_label = "Health Checks" -%}
  {%- when "containers" -%}{%- assign tl_label = "Containers" -%}
  {%- when "databases" -%}{%- assign tl_label = "Databases" -%}
  {%- when "migrations" -%}{%- assign tl_label = "Migrations" -%}
  {%- when "volumes" -%}{%- assign tl_label = "Volumes" -%}
  {%- when "dashboard" -%}{%- assign tl_label = "Dashboard" -%}
  {%- else -%}
    {%- capture tl_label -%}{%- assign tl_words = tl_tag | split: "-" -%}{%- for tl_word in tl_words -%}{% unless forloop.first %} {% endunless %}{{ tl_word | slice: 0 | upcase }}{{ tl_word | slice: 1, 1000 }}{%- endfor -%}{%- endcapture -%}
{%- endcase -%}
{%- endunless -%}
