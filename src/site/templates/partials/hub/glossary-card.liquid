{%- comment -%}
  GlossaryCard.astro (src/frontend/src/components/dev-center/): a term of the glossary index. Inputs: gc_term (the
  term's data), gc_id (its id, the last segment of its url), gc_search (the normalized search text), gc_group_anchor
  (the legacy group anchor of the first term of a group, else nil). Root class: cid-dev-center-glossary-card.
{%- endcomment -%}
{%- assign tp_id = gc_term.topics | first -%}{%- include "partials/hub/topic" -%}
{%- assign gc_href = "/hub/glossary/" | append: gc_id | append: "/" -%}
<article{% if gc_term.legacyAnchors.size > 0 %} id="{{ gc_term.legacyAnchors | first }}"{% endif %} class="glossary-card cid-dev-center-glossary-card" data-glossary-card data-search="{{ gc_search }}" data-letter="{{ gc_term.title | slice: 0 | upcase }}" data-topics="{{ gc_term.topics | join: ' ' }}" data-preview="false" style="--term-accent: {{ tp_color | default: 'var(--sl-color-purple)' }}"><div class="glossary-card-heading"><h3>{% if gc_group_anchor %}<span id="{{ gc_group_anchor }}"></span>{% endif %}{% for gc_anchor in gc_term.legacyAnchors offset: 1 %}<span id="{{ gc_anchor }}"></span>{% endfor %}<a href="{{ gc_href }}" data-term-link>{{ gc_term.title }}</a></h3><div class="glossary-topics">
{%- for tp_id in gc_term.topics -%}{%- include "partials/hub/topic" -%}<span class="glossary-topic" style="--topic-color: {{ tp_color }}">{% icon tp_icon, size: "0.9rem", class: nil, label: nil, color: nil %}{{ tp_title }}</span>{%- endfor -%}
</div></div><div class="glossary-copy"><div class="glossary-definition" data-definition><p>{{ gc_term.description }}</p></div><div id="context-{{ gc_id }}" class="glossary-context" data-context-panel aria-hidden="true" inert><p>{{ gc_term.context }}</p></div></div><div class="glossary-card-footer"><button type="button" data-glossary-context aria-expanded="false" aria-controls="context-{{ gc_id }}"><span data-context-label>In practice</span><span class="sr-only">: {{ gc_term.title }}</span>{% icon "right-arrow", size: "1rem", class: nil, label: nil, color: nil %}</button><a href="{{ gc_href }}" data-term-link class="term-detail-link" aria-label="Read the full definition of {{ gc_term.title }}">Full definition</a></div><noscript><p class="glossary-noscript-context"><strong>In practice:</strong> {{ gc_term.context }}</p></noscript></article>
