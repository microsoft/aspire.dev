{%- comment -%}
  The languages of a sample (src/frontend/src/utils/sample-tags.ts sampleLanguages): its language tags, plus
  typescript for a TypeScript AppHost and csharp for a C# one, unique and sorted. sl_sample -> sl_languages (array).
{%- endcomment -%}
{%- capture sl_list -%}
{%- for sl_tag in sl_sample.tags -%}{%- case sl_tag -%}{%- when "csharp", "typescript", "javascript", "python", "go", "java", "rust" -%}{{ sl_tag }},{%- endcase -%}{%- endfor -%}
{%- if sl_sample.appHost == "typescript" -%}typescript,{%- elsif sl_sample.appHost == "csproj" or sl_sample.appHost == "file-based" -%}csharp,{%- endif -%}
{%- endcapture -%}
{%- assign sl_languages = sl_list | split: "," | where_exp: "sl_item", "sl_item != ''" | uniq | sort -%}
