{%- comment -%} A filter option of BrowseDropdown.astro: bo_name, bo_id, bo_label, bo_color (or nil). {%- endcomment -%}
<label class="browse-filter-option" data-option-label="{{ bo_label }}"><input type="checkbox" name="{{ bo_name }}" value="{{ bo_id }}">{% if bo_color %}<span class="browse-topic-dot" style="background: {{ bo_color }}" aria-hidden="true"></span>{% endif %}<span>{{ bo_label }}</span><span class="browse-facet-count" data-facet-count="{{ bo_name }}:{{ bo_id }}" aria-hidden="true"></span></label>