{%- comment -%}
  Ported from src/frontend/src/components/QuickStartJourney.astro. Root class (components.css scope): cid-quick-start-journey.
  Argument: journey_steps, an array of { icon, title, description, href, label? } (from the page's front matter).
  Used by content/docs.md and, after M5, deployment/index.md.
{%- endcomment -%}
<div class="journey not-content cid-quick-start-journey">
  <div class="journey-track" aria-hidden="true"></div>
  <ol class="journey-steps">
    {%- for step in journey_steps %}
    <li class="journey-step">
      <div class="step-marker">
        <div class="step-icon-ring">
          {% icon step.icon, size: "1.5rem" %}
        </div>
      </div>
      <a href="{{ step.href }}" class="step-content">
        <h3 class="step-title">{{ step.title }}</h3>
        <p class="step-desc">{{ step.description }}</p>
        <span class="step-link">
          {{ step.label | default: "Learn more" }}
          {% icon "right-arrow", size: "0.85rem" %}
        </span>
      </a>
    </li>
    {%- endfor %}
  </ol>
</div>
