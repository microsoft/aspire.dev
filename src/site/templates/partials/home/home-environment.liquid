                    </span>
                  </span>
                </div>
                <div class="topology-node node-database" style="--topology-cycle-duration: 11.9s; --topology-idle-duration: 7.3s; --topology-idle-delay: -4.1s; --topology-radar-delay: -2.8s; --topology-cycle-enter-x: -0.38rem; --topology-cycle-exit-x: 0.38rem">
                  <span class="topology-node-card">
                    <span class="topology-node-icon-cycle cycle-2">
                    <img src="/assets/images/icons/azure-postgresql-icon.png" alt="" class="topology-node-icon" width="30" height="30" style="--topology-cycle-delay: -8.2s" loading="lazy" decoding="async">
                    <img src="/assets/images/icons/aws.svg" alt="" class="topology-node-icon topology-node-icon-aws" width="30" height="30" style="--topology-cycle-delay: -2.249999999999999s" loading="lazy" decoding="async">
                    </span>
                    <span class="topology-node-copy">
                      <strong>{{ "home.environments.resourceDatabase" | t }}</strong>
                      <span class="topology-detail-cycle cycle-2">
                      <small style="--topology-cycle-delay: -8.2s">Azure Database</small>
                      <small style="--topology-cycle-delay: -2.249999999999999s">AWS RDS</small>
                      </span>
                    </span>
                  </span>
                </div>
                <div class="topology-node node-cache" style="--topology-cycle-duration: 15.2s; --topology-idle-duration: 5.4s; --topology-idle-delay: -3.7s; --topology-radar-delay: -3.6s; --topology-cycle-enter-x: 0.38rem; --topology-cycle-exit-x: -0.38rem">
                  <span class="topology-node-card">
                    <span class="topology-node-icon-cycle cycle-2">
                    <img src="/assets/images/icons/azure-cacheredis-icon.png" alt="" class="topology-node-icon" width="30" height="30" style="--topology-cycle-delay: -3.3s" loading="lazy" decoding="async">
                    <img src="/assets/images/icons/aws.svg" alt="" class="topology-node-icon topology-node-icon-aws" width="30" height="30" style="--topology-cycle-delay: 4.3s" loading="lazy" decoding="async">
                    </span>
                    <span class="topology-node-copy">
                      <strong>{{ "home.environments.resourceCache" | t }}</strong>
                      <span class="topology-detail-cycle cycle-2">
                      <small style="--topology-cycle-delay: -3.3s">Azure Managed Redis</small>
                      <small style="--topology-cycle-delay: 4.3s">AWS ElastiCache</small>
                      </span>
                    </span>
                  </span>
                </div>
              </div>
            </div>
          </article>
        </div>

        <button
          type="button"
          class="environment-motion-control"
          data-environment-motion-control
          aria-label="{{ env_pause }}"
          aria-pressed="false"
          title="{{ env_pause }}"
          data-label-pause="{{ env_pause }}"
          data-label-play="{{ "home.environments.playAnimation" | t }}"
        >
          <span data-environment-control-pause aria-hidden="true">
            {% include "partials/home/svg/pause.liquid", svg_width: "20", svg_height: "20" %}
          </span>
          <span data-environment-control-play aria-hidden="true" hidden>
            {% include "partials/home/svg/play.liquid", svg_width: "20", svg_height: "20" %}
          </span>
        </button>
      </div>
    </div>
  </div>
</section>
