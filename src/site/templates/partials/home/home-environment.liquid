{%- comment -%}
  Generated once from src/frontend/src/components/home/HomeEnvironment.astro (M3, then hand maintained). Root class
  (components.css scope): cid-home-home-environment. Needs `lp` (locale-prefix.liquid).
  Script: scripts/client/home/home-environment.ts ([data-home-environments], [data-environment-trigger],
  [data-environment-panel], [data-environment-stage-label], [data-environment-motion-control]).
  The environments, their resources and the animation delays (computed from fixed tables in the component) are
  unrolled here; strings come from the home.environments.* keys.
{%- endcomment -%}
{%- assign env_join = "home.environments.detailJoin" | t -%}
{%- assign env_resource_frontend = "home.environments.resourceFrontend" | t -%}
{%- assign env_resource_api = "home.environments.resourceApi" | t -%}
{%- assign env_resource_database = "home.environments.resourceDatabase" | t -%}
{%- assign env_resource_cache = "home.environments.resourceCache" | t -%}
{%- assign env_detail_local_process = "home.environments.detailLocalProcess" | t -%}
{%- assign env_detail_local_container = "home.environments.detailLocalContainer" | t -%}
{%- assign env_detail_dev_tunnel = "home.environments.detailDevTunnel" | t -%}
{%- assign env_detail_staging_environment = "home.environments.detailStagingEnvironment" | t -%}
{%- assign env_detail_staged_database = "home.environments.detailStagedDatabase" | t -%}
{%- assign env_detail_short_lived_container = "home.environments.detailShortLivedContainer" | t -%}
{%- assign env_pause = "home.environments.pauseAnimation" | t -%}
<section
  class="home-section home-environment cid-home-home-environment"
  aria-labelledby="home-environment-title"
  data-home-environments
  data-environment-state="local"
>
  <div class="environment-grid" aria-hidden="true"></div>
  <div class="home-shell">
    <header class="environment-heading" data-home-reveal>
      <p class="section-index"><span>04</span> {{ "home.environments.index" | t }}</p>
      <div>
        <h2 id="home-environment-title">{{ "home.environments.title" | t }}</h2>
        <p>{{ "home.environments.body" | t }}</p>
        {%- assign badge_label = "home.environments.badgeLabel" | t %}
        {%- assign badge_description = "home.environments.badgeDescription" | t %}
        {% include "partials/home/home-agent-badge.liquid", badge_id: "environment-ai-context", badge_label: badge_label, badge_description: badge_description %}
      </div>
    </header>

    <div class="environment-switcher" data-home-reveal>
      <div
        class="environment-controls"
        role="group"
        aria-label="{{ "home.environments.controlsLabel" | t }}"
      >
        <button
          type="button"
          data-environment-trigger="local"
          aria-controls="home-environment-local"
          aria-pressed="true"
          style="--environment-accent-dark: #75dca8; --environment-accent-light: #137a4b"
        >
          <span>01</span>
          {{ "home.environments.localLabel" | t }}
        </button>
        <button
          type="button"
          data-environment-trigger="test"
          aria-controls="home-environment-test"
          aria-pressed="false"
          style="--environment-accent-dark: #7db9ff; --environment-accent-light: #2667a8"
        >
          <span>02</span>
          {{ "home.environments.testLabel" | t }}
        </button>
        <button
          type="button"
          data-environment-trigger="production"
          aria-controls="home-environment-production"
          aria-pressed="false"
          style="--environment-accent-dark: #c3adff; --environment-accent-light: #6741c2"
        >
          <span>03</span>
          {{ "home.environments.productionLabel" | t }}
        </button>
      </div>

