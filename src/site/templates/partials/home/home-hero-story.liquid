{%- comment -%}
  Ported from src/frontend/src/components/home/HomeHero.astro. Root class (components.css scope): cid-home-home-hero.
  The Hero override rendered it instead of Starlight's hero on the homepages (the root index and the locale indexes:
  isHomepage()). It is part of the page's body (home-body.liquid), so that the code worker highlights the AppHost
  builder's example, and home-hero.liquid moves it to the hero's place in the layout.
  Script: scripts/client/home/home-hero.ts ([data-home-hero], --home-hero-progress).
  The hero image: Astro emitted a WebP srcset (widths 480, 640, 960, 1280) with the sizes below; it is served as is
  until the images step (Douze 3.8) can produce the variants.
{%- endcomment -%}
{%- include "partials/home/locale-prefix.liquid" -%}
<section
  class="home-hero-story not-content cid-home-home-hero"
  aria-labelledby="_top"
  data-home-hero
  style="--home-hero-progress: 0"
>
  <div class="home-hero-sticky">
    <div class="home-hero-grid" aria-hidden="true"></div>

    <div class="home-hero-copy">
      <p class="home-hero-eyebrow">
        <span aria-hidden="true"></span>
        {{ "home.hero.eyebrow" | t }}
      </p>
      <h1 id="_top">{{ "home.hero.title" | t | raw }}</h1>
      <p class="home-hero-summary">
        {{ "home.hero.summary" | t }}
      </p>
      <div class="home-hero-actions">
        <a class="home-hero-action primary" href="{{ lp }}/get-started/first-app/">
          {{ "home.hero.tryAspire" | t }}
          {% icon "right-arrow", size: "1.05rem" %}
        </a>
        <a class="home-hero-action secondary" href="{{ lp }}/docs/">
          {{ "home.hero.exploreDocs" | t }}
        </a>
      </div>
    </div>

    <div class="home-hero-mark" aria-hidden="true">
      <div class="home-hero-orbit orbit-one"></div>
      <div class="home-hero-orbit orbit-two"></div>
      <img src="/assets/images/aspire-hero.png" alt="" sizes="(max-width: 799px) 84vw, (max-width: 1151px) 18rem, 30rem" width="2350" height="1808" loading="eager" fetchpriority="high" decoding="async">
    </div>
  </div>

  <div class="home-hero-product" data-home-reveal data-home-reveal-distance="major">
    <div class="home-product-bar" aria-hidden="true">
      <span class="window-controls"><i></i><i></i><i></i></span>
      <span class="product-name">AppHost</span>
      <span class="product-meta">{{ "home.hero.livePreview" | t }}</span>
    </div>
    {%- assign ahb_heading = "home.hero.appHostHeading" | t %}
    {% include "partials/home/apphost-builder.liquid", ahb_heading_level: "h2", ahb_heading: ahb_heading, ahb_description: false %}
  </div>
</section>
