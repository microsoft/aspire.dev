{%- comment -%}
  Sets `lp`, the locale prefix of the current page ("" for the root locale, "/ja" for Japanese), used like
  localizedHref(path, locale) in the Astro components: href="{{ lp }}/docs/". Include it (not render) so `lp` is set
  in the caller's scope.
{%- endcomment -%}
{%- assign lp = "" -%}
{%- if locale and locale != "default" and locale != "en" -%}{%- assign lp = "/" | append: locale -%}{%- endif -%}
