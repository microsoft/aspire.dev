    aria-label="{{ rail_pause }}"
    aria-pressed="false"
    title="{{ rail_pause }}"
    data-label-pause="{{ rail_pause }}"
    data-label-play="{{ "home.integrationRail.playAnimation" | t }}"
  >
    <span data-rail-control-pause aria-hidden="true">
      {% include "partials/home/svg/pause.liquid", svg_width: "20", svg_height: "20" %}
    </span>
    <span data-rail-control-play aria-hidden="true" hidden>
      {% include "partials/home/svg/play.liquid", svg_width: "20", svg_height: "20" %}
    </span>
  </button>
</div>
