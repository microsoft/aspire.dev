    <div class="home-shell">
      <header class="section-heading dashboard-heading" data-home-reveal>
        <p class="section-index"><span>05</span> {{ "home.observability.index" | t }}</p>
        <h2 id="home-dashboard-title">{{ "home.observability.title" | t }}</h2>
        <p>{{ "home.observability.body" | t }}</p>
        {%- assign badge_label = "home.observability.badgeLabel" | t %}
          {%- assign badge_description = "home.observability.badgeDescription" | t %}
          {% include "partials/home/home-agent-badge.liquid", badge_id: "dashboard-ai-context", badge_label: badge_label, badge_description: badge_description, badge_align: "center" %}
        <div class="observability-links">
          <a
            class="text-link"
            href="{{ lp }}/dashboard/overview/"
            data-home-link
            data-home-link-icon
          >
            {{ "home.observability.link" | t }}
            {% icon "right-arrow", size: "1rem" %}
          </a>
          <a
            class="text-link"
            href="{{ lp }}/dashboard/standalone/"
            data-home-link
            data-home-link-icon
          >
            {{ "home.observability.standaloneLink" | t }}
            {% icon "right-arrow", size: "1rem" %}
          </a>
          <a
            class="text-link"
            href="{{ lp }}/fundamentals/telemetry/"
            data-home-link
            data-home-link-icon
          >
            {{ "home.observability.telemetryLink" | t }}
            {% icon "right-arrow", size: "1rem" %}
          </a>
          <a
            class="text-link"
            href="{{ lp }}/dashboard/ai-coding-agents/"
            data-home-link
            data-home-link-icon
          >
            {{ "home.observability.agentsLink" | t }}
            {% icon "right-arrow", size: "1rem" %}
          </a>
        </div>
      </header>

      <div
        class="dashboard-stage"
        data-home-reveal
        data-home-reveal-distance="major"
        data-home-reveal-anchor="[data-stage]"
      >
        <div class="dashboard-stage-bar" aria-hidden="true">
          <span><i></i><i></i><i></i></span>
          <strong>Aspire dashboard</strong>
          <small>Resources / Graph</small>
        </div>
        {% include "partials/home/dashboard-carousel.liquid", carousel_autoplay: true, carousel_presentation: "stage" %}
      </div>
    </div>
  </section>

  <section class="home-section home-integrations" aria-labelledby="home-integrations-title">
    <div class="home-shell">
      <header class="section-heading integrations-heading" data-home-reveal>
        <p class="section-index"><span>06</span> {{ "home.integrations.index" | t }}</p>
        <h2 id="home-integrations-title">{{ "home.integrations.title" | t }}</h2>
        <p>{{ "home.integrations.body" | t }}</p>
      </header>
      <div
        data-home-reveal
        data-home-reveal-distance="major"
        data-home-reveal-anchor="[data-home-integration-rail]"
        data-home-reveal-on-entry
      >
        {% include "partials/home/home-integration-rail.liquid" %}
      </div>
      <a
        class="text-link integration-link"
        href="{{ lp }}/integrations/"
        data-home-link
        data-home-link-icon
        data-home-reveal
      >
        {{ "home.integrations.link" | t }}
        {% icon "right-arrow", size: "1rem" %}
      </a>
    </div>
  </section>

  {% include "partials/home/home-testimonials.liquid" %}

  <section class="home-section home-closing" aria-labelledby="home-closing-title">
    <div class="closing-grid" aria-hidden="true"></div>
    <div class="closing-orbit orbit-a" aria-hidden="true"></div>
    <div class="closing-orbit orbit-b" aria-hidden="true"></div>
    <div class="home-shell closing-content" data-home-reveal data-home-reveal-distance="major">
      <div class="closing-start">
        <p class="section-index"><span>08</span> {{ "home.closing.index" | t }}</p>
        <h2 id="home-closing-title">{{ "home.closing.title" | t }}</h2>
        <p>{{ "home.closing.body" | t }}</p>
        <div class="closing-actions">
          <a class="closing-action primary" href="{{ lp }}/get-started/install-cli/">
            {{ "home.closing.install" | t }}
            {% icon "right-arrow", size: "1rem" %}
          </a>
          <a class="closing-action secondary" href="{{ lp }}/get-started/first-app/">
            {{ "home.closing.firstApp" | t }}
          </a>
        </div>
        <a class="text-link closing-source" href="https://github.com/microsoft/aspire" data-underline-trigger>
          {% icon "github", size: "1.1rem" %}
          <span data-link-underline>{{ "home.closing.github" | t }}</span>
        </a>
      </div>
      <div class="closing-discovery" role="region" aria-labelledby="closing-discovery-title">
        <h3 id="closing-discovery-title">{{ "home.devHub.title" | t }}</h3>
        <p>{{ "home.devHub.body" | t }}</p>
        <a class="closing-action secondary closing-dev-hub" href="/hub/">
          {% include "partials/home/svg/dev-hub.liquid", svg_class: "dev-hub-mark", svg_aria_hidden: "true", svg_focusable: "false" %}
          <span>{{ "home.devHub.link" | t }}</span>
          {% icon "right-arrow", size: "1rem" %}
        </a>
      </div>
    </div>
  </section>
</div>
