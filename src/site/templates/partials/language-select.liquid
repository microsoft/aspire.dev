{%- comment -%}
  Starlight's LanguageSelect.astro: <starlight-lang-select> (scripts/client/language-select.ts) over every locale of
  site.languages, each option the page's url in that locale (`locale_url` filter, Douze plan 3.6). Reads
  base.liquid's sl_locale_key. Root class: cid-sl-language-select.
{%- endcomment -%}
<starlight-lang-select class="cid-sl-language-select"><label style="--sl-select-width: 7em" class="cid-sl-select"><span class="sr-only">{{ "languageSelect.accessibleLabel" | t }}</span>{% icon "translate", class: "icon label-icon", label: nil, size: nil, color: nil %}<select autocomplete="off">{% for ls_language in site.languages %}<option value="{{ url | locale_url: ls_language.key }}"{% if ls_language.key == sl_locale_key %} selected{% endif %}>{{ ls_language.label }}</option>{% endfor %}</select>{% icon "down-caret", class: "icon caret", label: nil, size: nil, color: nil %}</label></starlight-lang-select>
