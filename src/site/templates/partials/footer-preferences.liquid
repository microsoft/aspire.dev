{%- comment -%}
  The site's FooterPreferences.astro (scripts/client/footer-preferences.ts): theme radio group, language and
  keyboard custom selects. The language options are site.languages (value: the BCP 47 tag, as the component had
  them). Root class: cid-footer-preferences.
{%- endcomment -%}
{%- capture fp_kbd_icon -%}<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.21 13.29a.93.93 0 0 0-.33-.21 1 1 0 0 0-.76 0 .9.9 0 0 0-.54.54 1 1 0 1 0 1.84 0 1 1 0 0 0-.21-.33ZM13.5 11h1a1 1 0 0 0 0-2h-1a1 1 0 0 0 0 2Zm-4 0h1a1 1 0 0 0 0-2h-1a1 1 0 0 0 0 2Zm-3-2h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2ZM20 5H4a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h16a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3Zm1 11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1Zm-6-3H9a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2Zm3.5-4h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm.71 4.29a1 1 0 0 0-.33-.21 1 1 0 0 0-.76 0 .93.93 0 0 0-.33.21 1 1 0 0 0-.21.33 1 1 0 1 0 1.92.38.84.84 0 0 0-.08-.38 1 1 0 0 0-.21-.33Z"></path></svg>{%- endcapture -%}
{%- capture fp_lang_icon -%}{% icon "translate", class: nil, label: nil, size: nil, color: nil %}{%- endcapture -%}
<section class="footer-preferences cid-footer-preferences" aria-labelledby="footer-preferences-heading" data-tour-target="footer-preferences" data-tour-step="footer-preferences"><p id="footer-preferences-heading" class="footer-heading">{{ "footer.preferences" | t | default: "Preferences" }}</p>
<div class="preference-controls">
<div class="preference-item theme-preference"><div id="footer-theme-toggle" class="theme-toggle" role="radiogroup" aria-label="Select theme" data-theme-choice="auto"><button type="button" class="theme-toggle-option" role="radio" aria-checked="false" aria-label="{{ 'themeSelect.light' | t | default: 'Light' }}" data-theme-option="light">{% icon "sun", class: nil, label: nil, size: nil, color: nil %}</button><button type="button" class="theme-toggle-option" role="radio" aria-checked="true" aria-label="{{ 'themeSelect.auto' | t | default: 'Auto' }}" data-theme-option="auto">{% icon "laptop", class: nil, label: nil, size: nil, color: nil %}</button><button type="button" class="theme-toggle-option" role="radio" aria-checked="false" aria-label="{{ 'themeSelect.dark' | t | default: 'Dark' }}" data-theme-option="dark">{% icon "moon", class: nil, label: nil, size: nil, color: nil %}</button></div></div>
<div class="preference-item">{% include "partials/footer-language-select" %}</div>
<div class="preference-item">{% include "partials/custom-select", cs_id: "footer-kbd-select", cs_class: "footer-custom-select", cs_label: "Select keyboard shortcuts style", cs_options: site.selects.kbd_types, cs_menu_width: nil, cs_placement: nil, cs_icon_html: fp_kbd_icon %}</div>
</div></section>
