{%- comment -%}
  Ported from src/frontend/src/components/NotFoundPage.astro. Root class (components.css scope): cid-not-found-page.
  No arguments, no script (the "Go back" link keeps its inline onclick handler, as in the original).
{%- endcomment -%}
<section class="not-found-story not-content cid-not-found-page" aria-labelledby="not-found-title">
  <div class="not-found-grid" aria-hidden="true"></div>
  <div class="not-found-glow" aria-hidden="true"></div>

  <div class="not-found-layout">
    <div class="not-found-copy">
      <p class="not-found-eyebrow">
        <span aria-hidden="true"></span>
        404 / Not found
      </p>
      <h1 id="not-found-title">Wrong <span>route?</span></h1>
      <p class="not-found-summary">
        The page you're looking for isn't available. Explore the docs or retrace your steps to a
        familiar route.
      </p>
      <div class="not-found-actions">
        <a class="not-found-action primary" href="/">
          Go home
          {% include "partials/home/svg/aspire-logo-32.liquid", svg_class: "not-found-action-logo", svg_aria_hidden: "true" %}
        </a>
        <a
          class="not-found-action secondary"
          href="/"
          onclick="event.preventDefault(); history.back();"
        >
          {% icon "left-arrow", size: "1.05rem" %}
          Go back
        </a>
      </div>
    </div>

    <div class="not-found-art" aria-hidden="true">
      <div class="not-found-orbit orbit-one"></div>
      <div class="not-found-orbit orbit-two"></div>
      <img
        src="/assets/images/not-found-map.webp"
        alt=""
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        data-zoom-off
      />
    </div>
  </div>
</section>
