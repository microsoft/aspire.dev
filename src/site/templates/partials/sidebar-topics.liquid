{%- comment -%}
  The topic picker (starlight-sidebar-topics' Topics.astro, as the site's Sidebar override renders it): one link per
  topic of site.sidebar_topics, localized label and link, icon, badge, the current topic marked. Reads sb_current_key
  (sidebar.liquid) and sl_prefix, sl_lang. Root class: cid-topics-topics.
{%- endcomment -%}
<ul class="starlight-sidebar-topics topics-sidebar-list cid-topics-topics" data-tour-target="topics-list" data-tour-step="topics-list">
{%- for sb_key in site.sidebar_topics %}
{%- assign sb_item = sidebars[sb_key] -%}{%- include "partials/sidebar-label" -%}
{%- assign sb_topic_href = sl_prefix | append: sb_item.link %}
<li><a href="{{ sb_topic_href }}" title="{{ sb_label }}" aria-label="{{ sb_label }}"{% if sb_key == sb_current_key %} aria-current="page" class="starlight-sidebar-topics-current"{% endif %}>{% if sb_item.icon %}<div class="starlight-sidebar-topics-icon">{% icon sb_item.icon, class: nil, size: nil, color: nil, label: nil %}</div>{% endif %}<div>{{ sb_label }}{% if sb_badge_text %}{% badge sb_badge_text, variant: sb_badge_variant, class: "starlight-sidebar-topics-badge", size: nil %}{% endif %}</div></a></li>
{%- endfor %}
</ul>
