{%- comment -%}
  The site's LivePip.astro (scripts/client/live-pip.ts): the "Aspire is live" watch options menu of the header live
  button. Root class: cid-live-pip.
{%- endcomment -%}
<div id="aspire-live-source-menu" class="live-source-menu not-content cid-live-pip" role="dialog" aria-labelledby="aspire-live-source-menu-title" hidden>
<div class="live-source-menu__header"><div><p class="live-source-menu__eyebrow">Aspire is live</p><p id="aspire-live-source-menu-title" class="live-source-menu__label">Choose how to watch</p></div><button type="button" class="live-source-menu__close" aria-label="Close watch options" data-live-action="close">{% icon "close" %}</button></div>
<div class="live-source-menu__body">
<div class="live-source-menu__group" data-live-pip-group><p class="live-source-menu__group-label">Picture-in-picture</p>
<button type="button" class="live-source-menu__item" data-live-pip-choice="youtube">{% icon "youtube" %}<span><span class="live-source-menu__name">Open YouTube Picture-in-Picture</span><span class="live-source-menu__description">Keep watching while browsing docs.</span></span></button>
<button type="button" class="live-source-menu__item" data-live-pip-choice="twitch">{% icon "twitch" %}<span><span class="live-source-menu__name">Open Twitch Picture-in-Picture</span><span class="live-source-menu__description">Keep watching while browsing docs.</span></span></button>
</div>
<div class="live-source-menu__group" data-live-external-group><p class="live-source-menu__group-label">Provider apps and sites</p>
<a class="live-source-menu__item" data-live-source-link="youtube" target="_blank" rel="noopener noreferrer">{% icon "youtube" %}<span><span class="live-source-menu__name">Watch on YouTube</span><span class="live-source-menu__description">Use YouTube’s player and mobile app when available.</span></span>{% icon "external-link", class: "live-source-menu__external-icon" %}</a>
<a class="live-source-menu__item" data-live-source-link="twitch" target="_blank" rel="noopener noreferrer">{% icon "twitch" %}<span><span class="live-source-menu__name">Watch on Twitch</span><span class="live-source-menu__description">Use Twitch’s player and mobile app when available.</span></span>{% icon "external-link", class: "live-source-menu__external-icon" %}</a>
</div>
<div class="live-source-menu__group" data-live-site-group><p class="live-source-menu__group-label">Watch on aspire.dev</p>
<a href="/community/videos/" class="live-source-menu__item" data-live-action="embeds">{% include "partials/svg/live" %}<span><span class="live-source-menu__name">Open embedded players</span><span class="live-source-menu__description">Keep the YouTube and Twitch embeds on this site.</span></span></a>
</div>
<p class="live-source-menu__status" role="status" aria-live="polite" data-live-pip-status hidden></p>
</div>
<div class="live-source-menu__footer"><button type="button" class="live-source-menu__dismiss" data-live-action="dismiss">Dismiss notification</button></div>
</div>
