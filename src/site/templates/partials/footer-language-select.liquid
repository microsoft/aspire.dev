{%- comment -%}
  The language custom select of FooterPreferences.astro, written out because its options come from site.languages
  (value: the BCP 47 tag, English selected as in the component; the script selects the page's language).
  Same markup as partials/custom-select. Root class: cid-custom-select.
{%- endcomment -%}
<div class="custom-select footer-custom-select cid-custom-select" data-custom-select data-has-icon="true" data-menu-width="trigger" data-placement="auto">
<select id="footer-language-select" class="custom-select-native" aria-hidden="true" tabindex="-1" data-custom-select-native>{% for fl_language in site.languages %}<option value="{{ fl_language.lang }}"{% if forloop.first %} selected{% endif %}>{{ fl_language.label }}</option>{% endfor %}</select>
<button type="button" class="custom-select-trigger" role="combobox" aria-label="Select language" aria-controls="footer-language-select-listbox" aria-expanded="false" aria-haspopup="listbox" aria-autocomplete="none" data-custom-select-trigger><span class="custom-select-leading" aria-hidden="true">{{ fp_lang_icon }}</span><span class="custom-select-value" data-custom-select-value>{{ site.languages[0].label }}</span>{% icon "down-caret", class: "custom-select-caret", label: nil, size: nil, color: nil %}</button>
<div id="footer-language-select-listbox" class="custom-select-listbox" role="listbox" aria-label="Select language" data-custom-select-listbox popover="manual" hidden>{% for fl_language in site.languages %}<button type="button" id="footer-language-select-listbox-option-{{ forloop.index0 }}" class="custom-select-option" role="option" tabindex="-1" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-custom-select-option data-value="{{ fl_language.lang }}"><span class="custom-select-option-label">{{ fl_language.label }}</span></button>{% endfor %}</div>
</div>
