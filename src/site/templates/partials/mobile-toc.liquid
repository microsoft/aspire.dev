{%- comment -%}
  Starlight's MobileTableOfContents.astro (<mobile-starlight-toc>, scripts/client/toc.ts). Root class:
  cid-sl-mobile-table-of-contents.
{%- endcomment -%}
<mobile-starlight-toc data-min-h="2" data-max-h="3" class="cid-sl-mobile-table-of-contents"><nav aria-labelledby="starlight__on-this-page--mobile"><details id="starlight__mobile-toc"><summary id="starlight__on-this-page--mobile" class="sl-flex"><span class="toggle sl-flex">{{ "tableOfContents.onThisPage" | t }}{% icon "right-caret", class: "caret", size: "1rem", label: nil, color: nil %}</span><span class="display-current"></span></summary><div class="dropdown">{% include "partials/toc-list", tl_items: toc, tl_mobile: true, tl_overview: true %}</div></details></nav></mobile-starlight-toc>
