{%- comment -%}
  The content of <main> (Starlight's Page.astro): the banner, then
  - with `hero`: one content panel with the hero, the content and the footer;
  - else: a panel with the title (and page actions), the draft and fallback notices, then a panel with the content
    and the footer.
  Used by the docs, splash and hub layouts. Root class of each panel: cid-sl-content-panel.
{%- endcomment -%}
{% include "partials/banner" %}
{%- if hero %}
<div class="content-panel cid-sl-content-panel"><div class="sl-container">
{% include "partials/hero" %}
{% include "partials/markdown-content" %}
{% include "partials/footer" %}
</div></div>
{%- else %}
<div class="content-panel cid-sl-content-panel"><div class="sl-container">
{% include "partials/page-title" %}
{%- if draft %}{% assign cn_label = "page.draft" | t %}{% include "partials/content-notice" %}{% endif %}
{%- if fallback %}{% assign cn_label = "i18n.untranslatedContent" | t %}{% include "partials/content-notice" %}{% endif %}
</div></div>
<div class="content-panel cid-sl-content-panel"><div class="sl-container">
{% include "partials/markdown-content" %}
{% include "partials/footer" %}
</div></div>
{%- endif %}
