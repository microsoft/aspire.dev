{%- comment -%}
  The site's SocialIcons override (src/frontend/src/components/starlight/SocialIcons.astro): RSS, install CLI and
  cookie buttons, then Starlight's social links (site.social), then the install CLI modal (rendered a second time,
  as the Astro build did: the override is only used by the mobile menu footer of pages without a topic).
  Root class: cid-starlight-social-icons.
{%- endcomment -%}
<div class="misc-section sl-flex cid-starlight-social-icons">
<a href="/rss.xml" rel="noopener noreferrer" class="sl-flex external-link" target="_blank" title="RSS feed" data-placement="top" aria-label="(RSS feed opens in new tab)"><span class="sr-only">RSS Feed</span>{% icon "rss", class: nil, label: nil, size: nil, color: nil %}</a>
<button class="sl-flex external-link install-cli-btn" data-open-install-modal title="Install Aspire CLI" data-placement="top" aria-label="Open install Aspire CLI dialog"><span class="sr-only">Install Aspire CLI</span>{% icon "download", class: nil, label: nil, size: nil, color: nil %}</button>
<button type="button" class="sl-flex external-link cookie-consent-btn" data-cookie-manage-consent title="Cookie preferences" data-placement="top" aria-label="Open cookie preferences dialog"><span class="sr-only">Cookie Preferences</span>{% include "partials/svg/cookies" %}</button>
</div>
{%- for si_link in site.social %}<a href="{{ si_link.href }}" rel="me" class="sl-flex cid-sl-social-icons"><span class="sr-only">{{ si_link.label }}</span>{% icon si_link.icon, class: nil, label: nil, size: nil, color: nil %}</a>{% endfor %}
{% include "partials/install-cli-modal" %}
