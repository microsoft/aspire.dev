{%- comment -%}
  Starlight's TableOfContentsList.astro, recursive: tl_items (entries { text, id, children } of the headings step's
  `toc`), tl_mobile, tl_overview (true at the top: Starlight's "Overview" entry for #_top first).
  Root class: cid-sl-table-of-contents-list.
{%- endcomment -%}
<ul class="{% if tl_mobile %}isMobile {% endif %}cid-sl-table-of-contents-list">
{%- if tl_overview %}<li><a href="#_top"><span>{{ "tableOfContents.overview" | t }}</span></a></li>{% endif -%}
{%- for tl_item in tl_items %}<li><a href="#{{ tl_item.id }}"><span>{{ tl_item.text }}</span></a>{% if tl_item.children.size > 0 %}{% include "partials/toc-list", tl_items: tl_item.children, tl_mobile: tl_mobile, tl_overview: false %}{% endif %}</li>{% endfor -%}
</ul>
