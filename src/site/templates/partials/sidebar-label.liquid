{%- comment -%}
  Sets `sb_label` to the label of `sb_item` (a sidebar topic, group or link) in the page's language: its
  `translations[lang]` (keys are BCP 47 tags as in the TypeScript sidebar: de, ja, pt-BR, zh-CN), else `label`.
  (Douze's nav_label reads labels written as `label: { en, de, ... }`; the sidebar data keeps Starlight's
  `label` + `translations` shape, so the lookup is done here.) Also sets `sb_badge_text` and `sb_badge_variant`
  from `sb_item.badge` (a string, or { text, variant, translations }).
{%- endcomment -%}
{%- assign sb_label = sb_item.translations[sl_lang] | default: sb_item.label -%}
{%- assign sb_badge_text = nil -%}{%- assign sb_badge_variant = "default" -%}
{%- if sb_item.badge -%}
  {%- if sb_item.badge.text -%}
    {%- assign sb_badge_text = sb_item.badge.translations[sl_lang] | default: sb_item.badge.text -%}
    {%- assign sb_badge_variant = sb_item.badge.variant | default: "default" -%}
  {%- else -%}
    {%- assign sb_badge_text = sb_item.badge -%}
  {%- endif -%}
{%- endif -%}
