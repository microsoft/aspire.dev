{%- comment -%} The site's FooterSocials.astro: site.social, then Reddit and RSS. Root class: cid-footer-socials. {%- endcomment -%}
{%- assign fs_new_tab = "footer.opensInNewTab" | t -%}
<section class="footer-socials cid-footer-socials" aria-labelledby="footer-community-heading"><p id="footer-community-heading" class="footer-heading">{{ "footer.community" | t }}</p><div class="social-actions"><ul class="social-links">
{%- for fs_link in site.social %}<li><a href="{{ fs_link.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ fs_link.label }} ({{ fs_new_tab }})" title="{{ fs_link.label }}">{% icon fs_link.icon, class: nil, label: nil, size: nil, color: nil %}<span class="sr-only">{{ fs_link.label }}</span></a></li>{% endfor -%}
<li><a href="https://www.reddit.com/r/aspiredotdev" target="_blank" rel="noopener noreferrer" aria-label="Reddit ({{ fs_new_tab }})" title="Reddit">{% icon "reddit", class: nil, label: nil, size: nil, color: nil %}<span class="sr-only">Reddit</span></a></li>
<li><a href="/rss.xml" target="_blank" rel="noopener noreferrer" aria-label="RSS ({{ fs_new_tab }})" title="RSS">{% icon "rss", class: nil, label: nil, size: nil, color: nil %}<span class="sr-only">RSS</span></a></li>
</ul></div></section>
