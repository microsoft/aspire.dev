{%- comment -%}
  The file icon of a code block's title (starlight-plugin-icons' Expressive Code plugin): the Material Icon Theme icon of
  the file name, of its extensions, of its language, else the document icon. The icon data is .starlight-icons/
  (`material-icons` and `language-map`, the `code-icons` data step). Its variables are not named `icon`: in an
  include, the variable of the template's name is bound in its own scope and hides what the template assigns.
{%- endcomment -%}
{%- assign ci_icon = nil -%}
{%- assign title_end = code.title | slice: -10, 10 -%}
{%- if title_end == '.svelte.js' -%}{%- assign ci_icon = 'i-starlight-plugin-icons:svelte-js' -%}{%- elsif title_end == '.svelte.ts' -%}{%- assign ci_icon = 'i-starlight-plugin-icons:svelte-ts' -%}{%- endif -%}
{%- unless ci_icon -%}
{%- assign file = code.title | split: '/' | last | downcase -%}
{%- assign parts = file | split: '.' -%}
{%- assign first = parts | first -%}
{%- assign long_ext = file | remove_first: first | remove_first: '.' -%}
{%- assign short_ext = parts | last | default: '' -%}
{%- assign dotted = '.' | append: file -%}
{%- assign defs = material-icons.iconDefinitions -%}
{%- assign name = material-icons.fileNames[file] -%}
{%- unless name and defs[name] -%}{%- assign name = material-icons.fileExtensions[long_ext] -%}{%- endunless -%}
{%- unless name and defs[name] -%}{%- assign name = material-icons.fileExtensions[short_ext] -%}{%- endunless -%}
{%- unless name and defs[name] -%}{%- assign name = language-map.fileExtensions[short_ext] -%}{%- endunless -%}
{%- unless name and defs[name] -%}{%- assign name = nil -%}{%- assign first_char = file | slice: 0 -%}{%- unless first_char == '.' -%}{%- assign name = material-icons.fileNames[dotted] -%}{%- endunless -%}{%- endunless -%}
{%- unless name and defs[name] -%}{%- assign name = material-icons.languageIds[code.language] -%}{%- endunless -%}
{%- if name and defs[name] -%}{%- assign ci_icon = 'i-material-icon-theme:' | append: name | replace: '_', '-' -%}{%- else -%}{%- assign ci_icon = 'i-material-icon-theme:document' -%}{%- endif -%}
{%- endunless -%}
<span class="{{ ci_icon }} code-block-icon" data-icon="{{ ci_icon }}" data-language="{{ code.language }}"></span>