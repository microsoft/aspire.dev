{%- comment -%}
  The blocks of `text` (separated by ␞) trimmed, without the empty ones, joined by a blank line: finalizeMarkdown of
  src/frontend/src/utils/api-markdown-shared.ts without the normalization, which api/md/finalize applies once.
{%- endcomment -%}
{%- capture nl %}
{% endcapture -%}
{%- assign parts = text | split: "␞" -%}
{%- assign first = true -%}
{%- for part in parts -%}
  {%- assign block = part | strip -%}
  {%- if block != "" -%}
    {%- unless first -%}{{ nl }}{{ nl }}{%- endunless -%}{{ block }}{%- assign first = false -%}
  {%- endif -%}
{%- endfor -%}
