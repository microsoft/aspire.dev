{%- comment -%}tsSlugify of src/frontend/src/utils/ts-modules.ts: lowercase, runs of other characters than a-z0-9 as `-`. Input: name.{%- endcomment -%}
{%- assign chars = name | downcase | split: "" -%}
{%- assign allowed = "abcdefghijklmnopqrstuvwxyz0123456789" -%}
{%- capture slug -%}
  {%- assign dash = false -%}
  {%- for c in chars -%}
    {%- if allowed contains c -%}{%- if dash -%}-{%- assign dash = false -%}{%- endif -%}{{ c }}{%- assign started = true -%}
    {%- elsif started -%}{%- assign dash = true -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{{- slug -}}
