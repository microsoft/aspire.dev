{%- comment -%}
  memberDisplayName of src/frontend/src/utils/packages.ts as HTML text (`this[string]`, `Add(string, int)`), with the
  name `.ctor` written as `ctor` when it is given. Inputs: m, ctor.
{%- endcomment -%}
{%- if m.kind == "indexer" and m.parameters.size > 0 -%}
this[{%- for p in m.parameters -%}{%- unless forloop.first -%}, {% endunless -%}{%- render 'api/short-type', t: p.type -%}{%- endfor -%}]
{%- else -%}
{%- if ctor and m.name == ".ctor" -%}{{ ctor }}{%- else -%}{{ m.name }}{%- endif -%}
{%- if m.parameters -%}{%- if m.kind == "method" or m.kind == "constructor" -%}({%- for p in m.parameters -%}{%- unless forloop.first -%}, {% endunless -%}{%- render 'api/short-type', t: p.type -%}{%- endfor -%}){%- endif -%}{%- endif -%}
{%- endif -%}
