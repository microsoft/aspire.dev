{%- comment -%}
  src/frontend/src/components/search/SearchField.astro (the input of InpageSearch and ApiSearchBar; its styles are
  in components.css, scope cid-search-search-field). Inputs: id, label, placeholder, clear_id, described_by, size,
  input_class, clear_class, container_class, label_class, wrap_class, icon_class, visible_label.
{%- endcomment -%}
<div class="search-field{% if container_class %} {{ container_class }}{% endif %} cid-search-search-field" data-search-size="{{ size | default: 'lg' }}"><label class="{% if visible_label %}search-field-label{% else %}search-sr-only{% endif %}{% if label_class %} {{ label_class }}{% endif %}" for="{{ id }}">{{ label }}</label><div class="search-field-wrap{% if wrap_class %} {{ wrap_class }}{% endif %}"><svg class="search-field-icon{% if icon_class %} {{ icon_class }}{% endif %}" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg><input id="{{ id }}" type="search" class="search-field-input{% if input_class %} {{ input_class }}{% endif %}"{% if placeholder %} placeholder="{{ placeholder }}"{% endif %} autocomplete="off"{% if described_by %} aria-describedby="{{ described_by }}"{% endif %}><button type="button"{% if clear_id %} id="{{ clear_id }}"{% endif %} class="search-field-clear{% if clear_class %} {{ clear_class }}{% endif %}" aria-label="Clear search" style="display: none;"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m18 6-12 12M6 6l12 12"></path></svg></button></div></div>
