{%- comment -%}
  findAttribute of src/frontend/src/utils/api-attributes.ts: the attribute whose short name, without its Attribute
  suffix, is fa_name. An include used as a function: reads fa_attrs and fa_name, sets fa_out (nil when absent).
{%- endcomment -%}
{%- assign fa_out = nil -%}
{%- assign fa_long = fa_name | append: "Attribute" -%}
{%- for fa_a in fa_attrs -%}
  {%- assign fa_short = fa_a.name | split: "." | last -%}
  {%- if fa_short == fa_name or fa_short == fa_long -%}{%- assign fa_out = fa_a -%}{%- break -%}{%- endif -%}
{%- endfor -%}
