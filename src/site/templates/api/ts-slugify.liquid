{%- comment -%}
  tsSlugify of src/frontend/src/utils/ts-modules.ts, as a value: lowercase, runs of characters other than a-z0-9 as
  one `-`, none at the ends. An include used as a function: reads tsl_in, sets tsl_out.
{%- endcomment -%}
{%- assign tsl_chars = tsl_in | default: "" | downcase | split: "" -%}
{%- assign tsl_out = "" -%}{%- assign tsl_dash = false -%}
{%- for tsl_c in tsl_chars -%}
  {%- if "abcdefghijklmnopqrstuvwxyz0123456789" contains tsl_c -%}
    {%- if tsl_dash and tsl_out != "" -%}{%- assign tsl_out = tsl_out | append: "-" -%}{%- endif -%}
    {%- assign tsl_out = tsl_out | append: tsl_c -%}{%- assign tsl_dash = false -%}
  {%- else -%}{%- assign tsl_dash = true -%}
  {%- endif -%}
{%- endfor -%}
