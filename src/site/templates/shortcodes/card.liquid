---
# Starlight's <Card> (user-components/Card.astro): {% card "Title", icon: "rocket" %}...{% endcard %}.
# `title` is HTML (set:html in the component). Root class: cid-sl-card.
block: true
args: [title]
params: [icon]
---
<article class="card sl-flex cid-sl-card"><p class="title sl-flex">{% if icon %}{% icon icon, class: "icon", size: "1.333em" %}{% endif %}<span>{{ title | raw }}</span></p><div class="body">{{ body | strip }}</div></article>