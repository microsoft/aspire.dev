---
# The site's <CapabilityGrid> (src/components/CapabilityGrid.astro):
#   {% capability_grid columns: 2, capabilities: [{ icon: "rocket", title: "...", description: "...", href: "/x/" }] %}
# columns: 2 | 3 (default). A capability with href is a link card. Root class: cid-capability-grid.
display: block
params: [capabilities, columns]
---
<div class="capability-grid not-content cid-capability-grid" style="--cap-cols: {{ columns | default: 3 }}">
{%- for cap in capabilities -%}
{%- if cap.href -%}<a href="{{ cap.href }}" class="capability-card linked">{%- else -%}<div class="capability-card">{%- endif -%}
<div class="cap-icon">{% icon cap.icon, size: "1.5rem" %}</div><div class="cap-body"><h3 class="cap-title">{{ cap.title | escape }}</h3><p class="cap-desc">{{ cap.description | escape }}</p>{% if cap.href %}<span class="cap-link">Learn more {% icon "right-arrow", size: "0.8rem" %}</span>{% endif %}</div>
{%- if cap.href -%}</a>{%- else -%}</div>{%- endif -%}
{%- endfor -%}
</div>