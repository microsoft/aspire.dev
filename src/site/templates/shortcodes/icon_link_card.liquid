---
# The site's <IconLinkCard> (src/components/IconLinkCard.astro):
#   {% icon_link_card title: "Azure Cosmos DB", href: "/x/", description: "...", icon: "/assets/images/icons/azure.svg", placement: "end" %}
# icon: a Starlight/sprite icon name, or an image path (anything containing "/"), rendered 32px high.
# placement: end (default; arrow after) | start (arrow before). `target`, `rel` pass through.
# Root class: cid-icon-link-card.
display: block
params: [title, href, description, icon, placement, target, rel]
---
{%- assign ilc_start = false -%}{%- if placement == "start" -%}{%- assign ilc_start = true -%}{%- endif -%}
<div class="sl-link-card{% if ilc_start %} start{% endif %} cid-icon-link-card">{% if ilc_start %}{% icon "left-arrow", class: "icon rtl:flip" %}{% endif %}<span class="sl-flex stack"><a href="{{ href }}"{% if target %} target="{{ target }}"{% endif %}{% if rel %} rel="{{ rel }}"{% endif %}><span class="title">{% if icon %}{% if icon contains "/" %}<img src="{{ icon }}" alt="" class="icon image-icon" height="32" loading="lazy" decoding="async">{% else %}{% icon icon, class: "icon" %}{% endif %}{% endif %}{{ title | escape }}</span></a>{% if description %}<span class="description">{{ description | raw }}</span>{% endif %}</span>{% unless ilc_start %}{% icon "right-arrow", class: "icon rtl:flip" %}{% endunless %}</div>