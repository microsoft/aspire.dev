---
# The site's <Integrations> (src/components/Integrations.astro + IntegrationTotals.astro), the integrations gallery:
#   {% integrations exclude: "Aspire.Hosting,Aspire.Hosting.Azure" %}
# The packages of the site data `aspire-integrations` but the titles of `exclude` (comma separated) and, as with
# PUBLIC_SHOW_CLIENT_INTEGRATIONS off, the ones tagged `client`; sorted by downloads, descending (packages without
# downloads last, in data order). Each card links the documentation of `integration-docs` whose `match` is its title
# (case insensitive). The search, the toggles and the counters are wired by scripts/client/content/integrations.ts and
# integration-totals.ts, which read the messages from data-integrations-config.
# Root classes: cid-integrations (search bar, results bar, section), cid-integration-totals (the counters).
display: block
params: [exclude]
---
{%- assign ig_exclude = exclude | default: "" | split: "," -%}
{%- capture ig_map -%}~{%- for ig_doc in integration-docs -%}{{ ig_doc.match | downcase }}=>{{ ig_doc.href }}~{%- endfor -%}{%- endcapture -%}
{%- assign ig_with = aspire-integrations | where_exp: "i", "i.downloads" | sort: "downloads" | reverse -%}
{%- assign ig_without = aspire-integrations | where_exp: "i", "i.downloads == nil" -%}
{%- assign ig_sorted = ig_with | concat: ig_without -%}
{%- assign ig_count = 0 -%}{%- assign ig_downloads = 0 -%}{%- assign ig_tags_csv = "" -%}
{%- for pkg in ig_sorted -%}
  {%- if ig_exclude contains pkg.title or pkg.tags contains "client" -%}{%- continue -%}{%- endif -%}
  {%- assign ig_count = ig_count | plus: 1 -%}
  {%- assign ig_downloads = ig_downloads | plus: pkg.downloads -%}
  {%- for tag in pkg.tags -%}{%- if ig_tags_csv != "" -%}{%- assign ig_tags_csv = ig_tags_csv | append: "§§" -%}{%- endif -%}{%- assign ig_tags_csv = ig_tags_csv | append: tag -%}{%- endfor -%}
{%- endfor -%}
{%- assign ig_unique_tags = ig_tags_csv | split: "§§" | uniq -%}
{%- capture ig_config -%}{"showClientIntegrations":false,"messages":{"clearSearch":{{ "catalogSearch.clearSearch" | t | json | raw }},"clearFilters":{{ "catalogSearch.clearFilters" | t | json | raw }},"resetAll":{{ "catalogSearch.resetAll" | t | json | raw }},"count":{{ "catalogSearch.integrationsCount" | t | json | raw }},"query":{{ "catalogSearch.query" | t | json | raw }},"queryGuidance":{{ "catalogSearch.queryGuidance" | t | json | raw }},"preserveFiltersGuidance":{{ "catalogSearch.preserveFiltersGuidance" | t | json | raw }},"preserveQueryGuidance":{{ "catalogSearch.preserveQueryGuidance" | t | json | raw }},"filtersGuidance":{{ "catalogSearch.filtersGuidance" | t | json | raw }},"resetGuidance":{{ "catalogSearch.resetGuidance" | t | json | raw }},"excludedFilter":{{ "catalogSearch.excludedFilter" | t | json | raw }}}}{%- endcapture -%}
{%- assign ig_search = "integrations.search" | t -%}
<div class="sl-mb-4 search-wrapper not-content cid-integrations" data-integrations-config="{{ ig_config | escape }}"><div class="search-container">{% include "api/search-field", id: "integrations-search-input", label: ig_search, placeholder: ig_search, input_class: "search-box filter", clear_class: "clear-button", clear_id: nil, described_by: nil, size: nil, container_class: nil, label_class: nil, wrap_class: nil, icon_class: nil, visible_label: nil %}</div><div class="type-toggle-group"><button class="type-toggle active" aria-pressed="true" data-type="official" title="{{ "integrations.officialTooltip" | t | escape }}" data-tooltip-placement="top" type="button"><svg class="type-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10.521 2.624a2 2 0 0 1 2.958 0l1.02 1.12a2 2 0 0 0 1.572.651l1.513-.07a2 2 0 0 1 2.092 2.09l-.071 1.514a2 2 0 0 0 .651 1.572l1.12 1.02a2 2 0 0 1 0 2.958l-1.12 1.02a2 2 0 0 0-.651 1.572l.07 1.513a2 2 0 0 1-2.09 2.092l-1.514-.071a2 2 0 0 0-1.572.651l-1.02 1.12a2 2 0 0 1-2.958 0l-1.02-1.12a2 2 0 0 0-1.572-.651l-1.513.07a2 2 0 0 1-2.092-2.09l.071-1.514a2 2 0 0 0-.651-1.572l-1.12-1.02a2 2 0 0 1 0-2.958l1.12-1.02a2 2 0 0 0 .651-1.572l-.07-1.513a2 2 0 0 1 2.09-2.092l1.514.071a2 2 0 0 0 1.572-.651z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12l2 2l4-4"/></svg>{{ "integrations.official" | t }}</button><button class="type-toggle active" aria-pressed="true" data-type="community" title="{{ "integrations.communityTooltip" | t | escape }}" data-tooltip-placement="top" type="button"><svg class="type-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M7 18v-1a5 5 0 0 1 5-5v0a5 5 0 0 1 5 5v1M1 18v-1a3 3 0 0 1 3-3v0m19 4v-1a3 3 0 0 0-3-3v0m-8-2a3 3 0 1 0 0-6a3 3 0 0 0 0 6m-8 2a2 2 0 1 0 0-4a2 2 0 0 0 0 4m16 0a2 2 0 1 0 0-4a2 2 0 0 0 0 4"/></svg>{{ "integrations.community" | t }}</button></div></div>
<div class="search-results-bar not-content cid-integrations"><span class="search-results-summary" data-integration-count role="status" aria-live="polite" aria-atomic="true"></span><button type="button" class="search-action" data-integration-clear-filters hidden>{{ "catalogSearch.clearFilters" | t }}</button><button type="button" class="search-action" data-integration-reset hidden>{{ "catalogSearch.resetAll" | t }}</button></div>
{%- if ig_count > 0 -%}
<section class="cid-integrations"><div class="integration-stats"><div class="integration-totals cid-integration-totals"><div class="total-card"><div class="card-content"><div class="icon-container">{% icon "seti:css", size: "2rem", color: "var(--sl-color-accent-high)", label: nil, class: nil %}</div><div class="number-container"><div class="total-number" data-target="{{ ig_count }}">0</div><div class="total-label">{{ "integrations.numberOfIntegrations" | t }}</div></div></div></div><div class="total-card"><div class="card-content"><div class="icon-container">{% icon "information", size: "2rem", color: nil, label: nil, class: nil %}</div><div class="number-container"><div class="total-number" data-target="{{ ig_unique_tags.size }}">0</div><div class="total-label">{{ "integrations.uniqueTags" | t }}</div></div></div></div><div class="total-card"><div class="card-content"><div class="icon-container">{% icon "download", size: "2rem", color: nil, label: nil, class: nil %}</div><div class="number-container"><div class="total-number" data-target="{{ ig_downloads }}" data-format="true">0</div><div class="total-label">{{ "integrations.totalDownloads" | t }}</div></div></div></div></div></div><div class="equal-columns"><div class="card-grid cid-sl-card-grid">
{%- for pkg in ig_sorted -%}
  {%- if ig_exclude contains pkg.title or pkg.tags contains "client" -%}{%- continue -%}{%- endif -%}
  {%- assign ig_key = "~" | append: pkg.title | downcase | append: "=>" -%}
  {%- assign ig_docs = nil -%}
  {%- if ig_map contains ig_key -%}{%- assign ig_docs = ig_map | split: ig_key | last | split: "~" | first -%}{%- endif -%}
  {% integration_card pkg, docs: ig_docs %}
{%- endfor -%}
</div></div><div class="no-results search-empty"><div class="search-empty-content"><p class="search-empty-title">{{ "catalogSearch.integrationsEmpty" | t }}</p><p class="search-empty-query" hidden></p><p class="search-empty-hint">{{ "integrations.noResults" | t | escape }}</p><catalog-search-active-filters data-label="{{ "catalogSearch.activeFilters" | t | escape }}" data-labels="[]" hidden></catalog-search-active-filters><button type="button" class="search-action" data-integration-recover>{{ "catalogSearch.clearSearch" | t }}</button></div></div></section>
{%- else -%}
<p>{{ "catalogSearch.integrationsUnavailable" | t }}</p>
{%- endif -%}
