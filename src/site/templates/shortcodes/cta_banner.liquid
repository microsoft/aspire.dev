---
# The site's <CTABanner> (src/components/CTABanner.astro):
#   {% cta_banner title: "...", description: "...", primary_cta: { label: "Get started", href: "/x/" }, secondary_cta: { label: "...", href: "..." } %}
# Root class: cid-cta-banner.
display: block
params: [title, description, primary_cta, secondary_cta]
---
<section class="cta-banner not-content cid-cta-banner"><div class="cta-bg" aria-hidden="true"></div><div class="cta-content"><h2 class="cta-title">{{ title | escape }}</h2><p class="cta-desc">{{ description | escape }}</p>
{%- if primary_cta or secondary_cta -%}<div class="cta-actions">
{%- if primary_cta %}<a href="{{ primary_cta.href }}" class="cta-btn cta-btn-primary">{{ primary_cta.label | escape }}{% icon "right-arrow", size: "1rem" %}</a>{% endif -%}
{%- if secondary_cta %}<a href="{{ secondary_cta.href }}" class="cta-btn cta-btn-ghost">{{ secondary_cta.label | escape }}</a>{% endif -%}
</div>{%- endif -%}
</div></section>