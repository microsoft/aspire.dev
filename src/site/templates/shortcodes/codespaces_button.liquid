---
# The site's <CodespacesButton> (src/components/CodespacesButton.astro): {% codespaces_button "microsoft", "aspire.dev" %}.
# The badge's alt and title are the locale's `gitHubCodespaces.title` string with {{repo}} = owner/repo.
# Root class: cid-codespaces-button.
display: block
args: [owner, repo]
---
{%- assign cs_repo = owner | append: "/" | append: repo -%}
{%- assign cs_title = "gitHubCodespaces.title" | t | replace: "{{repo}}", cs_repo -%}
<a href="https://codespaces.new/{{ owner }}/{{ repo }}" target="_blank" rel="noopener" class="codespaces-button cid-codespaces-button"><img src="https://github.com/codespaces/badge.svg" alt="{{ cs_title | escape }}" title="{{ cs_title | escape }}" style="max-width: 100%;"></a>
