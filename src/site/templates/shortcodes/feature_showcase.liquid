---
# The site's <FeatureShowcase> (src/components/FeatureShowcase.astro):
#   {% feature_showcase features: [{ icon: "rocket", title: "...", description: "...", href: "/x/", label: "Explore", accent: "blue" }] %}
# accent: purple (default) | blue | green | orange. Root class: cid-feature-showcase.
display: block
params: [features]
---
<div class="bento not-content cid-feature-showcase">
{%- for f in features -%}
{%- case f.accent -%}
  {%- when "blue" -%}{%- assign fs_accent = "var(--sl-color-blue)" -%}
  {%- when "green" -%}{%- assign fs_accent = "var(--sl-color-green)" -%}
  {%- when "orange" -%}{%- assign fs_accent = "var(--sl-color-orange)" -%}
  {%- else -%}{%- assign fs_accent = "var(--sl-color-purple)" -%}
{%- endcase -%}
<a href="{{ f.href }}" class="bento-card" style="--card-accent: {{ fs_accent }}"><div class="card-icon">{% icon f.icon, size: "1.75rem" %}</div><h3 class="card-title">{{ f.title | escape }}</h3><p class="card-desc">{{ f.description | escape }}</p><span class="card-link">{{ f.label | default: "Explore" | escape }}{% icon "right-arrow", size: "0.85rem" %}</span></a>
{%- endfor -%}
</div>