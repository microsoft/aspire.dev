---
# The site's <AsciinemaPlayer> (src/components/AsciinemaPlayer.astro): {% asciinema_player "/casts/x.cast", rows: 20, auto_play: true %}.
# Options (snake_case of the props): cols, rows (default 15), auto_play, preload, loop, start_at, speed,
# idle_time_limit, theme, poster (default npt:0:4), fit, controls, audio_url, markers (list), pause_on_markers,
# terminal_font_size, terminal_font_family, terminal_line_height, logger. Booleans are written "true"/"false", as the
# client script parses them. The client script creates the player (lazy `asciinema-player` import) and needs the
# player's CSS (asciinema-player/dist/bundle/asciinema-player.css). Root class: cid-asciinema-player.
display: block
args: [src]
params: [cols, rows, auto_play, preload, loop, start_at, speed, idle_time_limit, theme, poster, fit, controls, audio_url, markers, pause_on_markers, terminal_font_size, terminal_font_family, terminal_line_height, logger]
---
<div class="asciinema-player-container not-content cid-asciinema-player" data-src="{{ src }}"
{%- if cols != nil %} data-cols="{{ cols }}"{% endif %} data-rows="{{ rows | default: 15 }}"
{%- if auto_play != nil %} data-autoplay="{{ auto_play }}"{% endif -%}
{%- if preload != nil %} data-preload="{{ preload }}"{% endif -%}
{%- if loop != nil %} data-loop="{{ loop }}"{% endif -%}
{%- if start_at != nil %} data-startat="{{ start_at }}"{% endif -%}
{%- if speed != nil %} data-speed="{{ speed }}"{% endif -%}
{%- if idle_time_limit != nil %} data-idletimelimit="{{ idle_time_limit }}"{% endif -%}
{%- if theme != nil %} data-theme="{{ theme }}"{% endif %} data-poster="{{ poster | default: 'npt:0:4' }}"
{%- if fit != nil %} data-fit="{{ fit }}"{% endif -%}
{%- if controls != nil %} data-controls="{{ controls }}"{% endif -%}
{%- if audio_url != nil %} data-audiourl="{{ audio_url }}"{% endif -%}
{%- if markers != nil %} data-markers="{{ markers | json | escape }}"{% endif -%}
{%- if pause_on_markers != nil %} data-pauseonmarkers="{{ pause_on_markers }}"{% endif -%}
{%- if terminal_font_size != nil %} data-terminalfontsize="{{ terminal_font_size }}"{% endif -%}
{%- if terminal_font_family != nil %} data-terminalfontfamily="{{ terminal_font_family }}"{% endif -%}
{%- if terminal_line_height != nil %} data-terminallineheight="{{ terminal_line_height }}"{% endif -%}
{%- if logger %} data-logger="true"{% endif %}></div>