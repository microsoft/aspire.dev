---
# Starlight's <LinkCard> (user-components/LinkCard.astro):
#   {% link_card title: "Install", href: "/get-started/install/", description: "..." %}
# `title` and `description` are HTML (set:html); `target` and `rel` pass through to the link.
# Root class: cid-sl-link-card.
display: block
params: [title, href, description, target, rel]
---
<div class="sl-link-card cid-sl-link-card"><span class="sl-flex stack"><a href="{{ href }}"{% if target %} target="{{ target }}"{% endif %}{% if rel %} rel="{{ rel }}"{% endif %}><span class="title">{{ title | raw }}</span></a>{% if description %}<span class="description">{{ description | raw }}</span>{% endif %}</span>{% icon "right-arrow", size: "1.333em", class: "icon rtl:flip" %}</div>