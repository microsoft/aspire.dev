---
# Starlight's <Badge> (user-components/Badge.astro): {% badge "New", variant: "tip", size: "small", class: "x" %}.
# variant: note | danger | success | caution | tip | default (default); size: small (default) | medium | large.
# Root class: cid-sl-badge.
args: [text]
params: [variant, size, class]
---
<span class="sl-badge {{ variant | default: 'default' }} {{ size | default: 'small' }}{% if class %} {{ class }}{% endif %} cid-sl-badge">{{ text | escape }}</span>