---
# The site's <TerminalShowcase> (src/components/TerminalShowcase.astro), an asciinema player in a terminal window with a
# title, a description and a call to action:
#   {% terminal_showcase title: "...", highlight: "...", description: "...", cast: "/casts/x.cast", poster: "npt:0:03",
#      rows: 12, speed: 0.5, cta_label: "...", cta_href: "/x/" %}
# The component's `cta` object is `cta_label` and `cta_href`. Root class: cid-terminal-showcase.
display: block
params: [title, highlight, description, cast, poster, rows, speed, cta_label, cta_href]
---
{%- assign ts_poster = poster | default: "npt:0:03" -%}{%- assign ts_rows = rows | default: 12 -%}
<section class="terminal-showcase not-content cid-terminal-showcase"><div class="terminal-header"><div class="terminal-header-text"><h2 class="terminal-showcase-title">{{ title | escape }} {% if highlight %}<span class="terminal-highlight">{{ highlight | escape }}</span>{% endif %}</h2>{% if description %}<p class="terminal-showcase-desc">{{ description | escape }}</p>{% endif %}</div>
{%- if cta_href -%}<a href="{{ cta_href }}" class="terminal-cta">{{ cta_label | escape }}{% icon "right-arrow", size: "1rem", label: nil, color: nil, class: nil %}</a>{%- endif -%}
</div><div class="terminal-window"><div class="terminal-chrome" aria-hidden="true"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span><span class="terminal-tab">Terminal</span></div><div class="terminal-body">{% asciinema_player cast, poster: ts_poster, rows: ts_rows, speed: speed, auto_play: true, loop: false %}</div></div></section>
