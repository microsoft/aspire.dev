---
# The site's <Pivot> (src/components/Pivot.astro): {% pivot "csharp" %}...{% endpivot %}. A section shown when the
# page's pivot selector (pivot_selector) selects `id`; the `aspire-pivot-selector` element script toggles them.
# Root class: cid-pivot.
block: true
args: [id]
params: []
---
<div data-pivot-block="{{ id | escape }}" class="cid-pivot">{{ body | strip }}</div>