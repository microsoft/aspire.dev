---
# The site's <Expand> (src/components/Expand.astro): {% expand "Summary text", background_color: "--sl-color-gray-5" %}...{% endexpand %}.
# background_color: the name of a CSS custom property (default --sl-color-gray-6). `dir` is the page's (localize).
# Root class: cid-expand.
block: true
args: [summary]
params: [background_color]
---
<details class="expand cid-expand" dir="{{ dir | default: 'ltr' }}" style="--expand-bg-color: var({{ background_color | default: '--sl-color-gray-6' }})"><summary title="{{ summary | escape }}">{{ summary | escape }}</summary><div class="content">{{ body | strip }}</div></details>