<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="1200" height="630" viewBox="0 0 1200 630">
  <!-- The site-wide background (content/og-image.png), a bottom gradient for contrast, a rounded card, a topic pill and
       the call-to-action chip: the layout of the former satori renderer. The title and description are Pango text
       blocks of the social-image step (douze.yml), not SVG text, so they wrap. -->
  <defs>
    <linearGradient id="shade" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="rgb(15,14,30)" stop-opacity="0.92"/>
      <stop offset="0.55" stop-color="rgb(15,14,30)" stop-opacity="0.45"/>
      <stop offset="1" stop-color="rgb(15,14,30)" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <image href="og-image.png" x="0" y="0" width="1200" height="630" preserveAspectRatio="xMidYMid slice"/>
  <rect x="0" y="0" width="1200" height="630" fill="url(#shade)"/>
  <rect x="60" y="120" width="1080" height="450" rx="28" fill="rgb(15,14,30)" fill-opacity="0.82"/>
  {%- assign og_topic = topic | default: category | default: "Docs" -%}
  <rect x="96" y="156" width="{{ og_topic | size | times: 15 | plus: 48 }}" height="48" rx="24" fill="rgb(116,85,221)" fill-opacity="0.96"/>
  <text x="{{ og_topic | size | times: 15 | plus: 48 | divided_by: 2 | plus: 96 }}" y="189" font-family="Outfit, sans-serif" font-size="26" font-weight="700" fill="#ffffff" text-anchor="middle">{{ og_topic | capitalize | escape }}</text>
  <rect x="820" y="498" width="300" height="48" rx="24" fill="rgb(116,85,221)" fill-opacity="0.96"/>
  <text x="970" y="530" font-family="Outfit, sans-serif" font-size="22" font-weight="700" fill="#ffffff" text-anchor="middle">Read on aspire.dev →</text>
</svg>
