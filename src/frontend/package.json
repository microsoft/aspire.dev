    "fast-xml-builder@<1.1.7": ">=1.1.7",
    "fast-xml-parser@<5.7.0": ">=5.7.0",
    "fflate@>=0.7.0 <0.7.5": "0.7.5",
    "file-entry-cache@11.1.6": "11.1.5",
    "flat-cache@6.1.24": "6.1.23",
    "flatted@<3.4.2": ">=3.4.2",
    "h3@<1.15.9": ">=1.15.9",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
