  },
  "patchedDependencies": {
    "@astrojs/starlight@0.41.3": "patches/@astrojs__starlight@0.41.3.patch",
    "astro@7.4.1": "patches/astro@7.4.1.patch",
    "starlight-page-actions@0.7.0": "patches/starlight-page-actions@0.7.0.patch",
    "starlight-plugin-icons@1.1.6": "patches/starlight-plugin-icons@1.1.6.patch"
  }
}
