[2.23, "o", "\u001b[?25l                                   \r\n\u001b[38;5;11m\u280b\u001b[0m \u001b[38;5;208m\ud83d\ude80\u001b[0m Creating new Aspire project...\r\n                                   \r\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[?25h\u001b[38;5;2m\u2705\u001b[0m Created C# (.NET) project at ./example/aspire/workspace\r\n\u001b[38;5;12m\u2139\ufe0f\u001b[0m Run 'cd \"example/aspire/workspace\"' and then 'aspire run' to start your AppHost.\r\n"]
