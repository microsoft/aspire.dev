---
import { getCollection } from 'astro:content';
import HubLayout from '../../../components/dev-center/HubLayout.astro';
import GlossaryBrowser from '../../../components/dev-center/GlossaryBrowser.astro';
const terms = await getCollection('glossary');
---

<HubLayout title="Aspire glossary" description="Search for a term, or filter by topic and first letter." showDescription={false} pageActions={false} pagefind={false}>
  <GlossaryBrowser terms={terms} />
</HubLayout>
