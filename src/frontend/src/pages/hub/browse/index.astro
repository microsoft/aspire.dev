---
import HubLayout from '../../../components/dev-center/HubLayout.astro';
import ResourceBrowser from '../../../components/dev-center/ResourceBrowser.astro';
import { getResourceCatalog } from '../../../utils/dev-center/catalog';

const resources = await getResourceCatalog();
---

<HubLayout title="Browse resources" description="Explore the Aspire library by topic, format, or technology." showDescription={false} pageActions={false} pagefind={false}>
  <ResourceBrowser resources={resources} />
</HubLayout>
