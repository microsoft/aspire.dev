---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import AppHostApiLanguageSelector from '@components/api-reference/AppHostApiLanguageSelector.astro';
import AppHostProjection from '@components/api-reference/AppHostProjection.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { getGeneratedApiLanguages } from '@utils/apphost-languages';
import { getAppHostApiSidebar } from '@utils/apphost-api-sidebar';
import { getAppHostItemSlug, getAppHostMemberSlug, getAppHostTopLevelItems } from '@utils/apphost-api-routes';
import {
  appHostModuleSlug,
  getAppHostModules,
  getCapabilitiesForHandle,
  getSupportedProjection,
} from '@utils/apphost-modules';

export async function getStaticPaths() {
  const paths = [];
  for (const entry of await getAppHostModules()) {
    const items = getAppHostTopLevelItems(entry.data);
    for (const item of items) {
      paths.push({
        params: {
          module: appHostModuleSlug(entry.data.package.name),
          item: getAppHostItemSlug(item, items),
        },
        props: { document: entry.data, item },
      });
    }
  }
  return paths;
}

const { document, item } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sidebar = await getAppHostApiSidebar(document.package.name);
const moduleSlug = appHostModuleSlug(document.package.name);
const languages = getGeneratedApiLanguages();
const members = item.kind === 'handle' ? getCapabilitiesForHandle(document, item) : [];
---

<StarlightPage
  frontmatter={{
    title: item.name,
    description: `${item.kind} AppHost API reference for ${item.name} in ${document.package.name}.`,
    tableOfContents: false,
    prev: false,
    next: false,
    pagefind: false,
    pageActions: true,
  }}
  sidebar={sidebar}
  headings={[]}
>
  <Breadcrumb crumbs={[
    { label: 'Docs', href: `${base}/docs/`, icon: 'docs' },
    { label: 'Reference', href: `${base}/reference/overview/` },
    { label: 'Search AppHost APIs', href: `${base}/reference/api/apphost/` },
    { label: document.package.name, href: `${base}/reference/api/apphost/${moduleSlug}/` },
    { label: item.name },
  ]} />

  <AppHostApiLanguageSelector />

  {languages.map((language) => {
    const projection = item.projections[language.id];
    return projection && (
      <AppHostProjection item={item} language={language} projection={projection} />
    );
  })}

  {members.length > 0 && (
    <section>
      <h2>Members</h2>
      <div class="api-list not-content">
        {members.map((member) => (
          <a
            class="api-list-item"
            href={`${base}/reference/api/apphost/${moduleSlug}/${Astro.params.item}/${getAppHostMemberSlug(member, members, item.name)}/`}
          >
            <div class="api-list-header">
              {languages.map((language) => {
                const projection = getSupportedProjection(member, language.id);
                return (
                  <span data-api-language={language.id}>
                    {projection?.identifier
                      ? <code>{projection.identifier}</code>
                      : <span class="api-mini-badge">Unsupported</span>}
                  </span>
                );
              })}
              <span class="api-kind-pill">{member.capabilityKind ?? 'member'}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</StarlightPage>

<style>
  [data-api-language] { display: none; }
  :global(html:not([data-apphost-lang])) [data-api-language='typescript'],
  :global(html[data-apphost-lang='typescript']) [data-api-language='typescript'],
  :global(html[data-apphost-lang='python']) [data-api-language='python'],
  :global(html[data-apphost-lang='go']) [data-api-language='go'],
  :global(html[data-apphost-lang='java']) [data-api-language='java'],
  :global(html[data-apphost-lang='rust']) [data-api-language='rust'] { display: inline; }
</style>
