---
import DevLayout from '../../../components/dev-center/DevLayout.astro';
import ResourceBrowser from '../../../components/dev-center/ResourceBrowser.astro';
import { getResourceCatalog } from '../../../utils/dev-center/catalog';

const resources = await getResourceCatalog();
---

<DevLayout title="Browse resources" description="Explore the Aspire library by topic, format, or technology." showDescription={false} pageActions={false} pagefind={false}>
  <ResourceBrowser resources={resources} />
</DevLayout>
