---
import { getCollection } from 'astro:content';
import DevLayout from '../../../components/dev-center/DevLayout.astro';
import GlossaryBrowser from '../../../components/dev-center/GlossaryBrowser.astro';
const terms = await getCollection('glossary');
---

<DevLayout title="Aspire glossary" description="Search for a term, or filter by topic and first letter." pageActions={false} pagefind={false}>
  <GlossaryBrowser terms={terms} />
</DevLayout>
