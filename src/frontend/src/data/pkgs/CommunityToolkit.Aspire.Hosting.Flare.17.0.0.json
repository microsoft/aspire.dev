        {
          "name": "WithOtlpExporter",
          "kind": "method",
          "accessibility": "public",
          "signature": "public static IResourceBuilder<T> FlareBuilderExtensions.WithOtlpExporter<T>(this IResourceBuilder<T> builder, IResourceBuilder<FlareResource> flare, OtlpProtocol protocol = OtlpProtocol.Grpc)",
          "returnType": "Aspire.Hosting.ApplicationModel.IResourceBuilder<T>",
          "isStatic": true,
          "isExtension": true,
          "parameters": [
            {
              "name": "builder",
              "type": "Aspire.Hosting.ApplicationModel.IResourceBuilder<T>",
              "modifier": "this"
            },
            {
              "name": "flare",
              "type": "Aspire.Hosting.ApplicationModel.IResourceBuilder<Aspire.Hosting.ApplicationModel.FlareResource>"
            },
            {
              "name": "protocol",
              "type": "Aspire.Hosting.OtlpProtocol",
              "isOptional": true,
              "defaultValue": "0"
            }
          ],
          "genericParameters": [
            {
              "name": "T",
              "constraints": [
                "Aspire.Hosting.ApplicationModel.IResourceWithEnvironment"
              ]
            }
          ],
          "attributes": [
            {
              "name": "Aspire.Hosting.AspireExportIgnoreAttribute",
              "arguments": {
                "Reason": "Generic receiver; the polyglot overload is withFlareOtlpExporter."
              }
            }
          ],
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Points a resource's OpenTelemetry exporter at a Flare ingest service by setting "
              },
              {
                "kind": "code",
                "text": "OTEL_EXPORTER_OTLP_ENDPOINT"
              },
              {
                "kind": "text",
                "text": " and "
              },
              {
                "kind": "code",
                "text": "OTEL_EXPORTER_OTLP_PROTOCOL"
              },
              {
                "kind": "text",
                "text": ". "
              }
            ],
            "remarks": [
              {
                "kind": "text",
                "text": " The resource's telemetry goes to Flare instead of the Aspire dashboard, so it no longer appears in the dashboard's logs, traces and metrics views. The Aspire dashboard's OTLP API key is removed from "
              },
              {
                "kind": "code",
                "text": "OTEL_EXPORTER_OTLP_HEADERS"
              },
              {
                "kind": "text",
                "text": " so it is not sent to Flare; other headers are kept. When the Flare resource has an API key (see "
              },
              {
                "kind": "cref",
                "value": "M:Aspire.Hosting.FlareBuilderExtensions.WithApiKey(Aspire.Hosting.ApplicationModel.IResourceBuilder{Aspire.Hosting.ApplicationModel.FlareResource},Aspire.Hosting.ApplicationModel.IResourceBuilder{Aspire.Hosting.ApplicationModel.ParameterResource})"
              },
              {
                "kind": "text",
                "text": "), an "
              },
              {
                "kind": "code",
                "text": "Authorization=Bearer <key>"
              },
              {
                "kind": "text",
                "text": " header is added. "
              }
            ],
            "returns": [
              {
                "kind": "text",
                "text": "A reference to the "
              },
              {
                "kind": "cref",
                "value": "T:Aspire.Hosting.ApplicationModel.IResourceBuilder`1"
              },
              {
                "kind": "text",
                "text": "."
              }
            ],
            "parameters": {
              "builder": [
                {
                  "kind": "text",
                  "text": "The resource builder."
                }
              ],
              "flare": [
                {
                  "kind": "text",
                  "text": "The Flare resource builder."
                }
              ],
              "protocol": [
                {
                  "kind": "text",
                  "text": " The OTLP protocol to export with. "
                },
                {
                  "kind": "cref",
                  "value": "F:Aspire.Hosting.OtlpProtocol.Grpc"
                },
                {
                  "kind": "text",
                  "text": " uses the ingest service's gRPC endpoint; "
                },
                {
                  "kind": "cref",
                  "value": "F:Aspire.Hosting.OtlpProtocol.HttpProtobuf"
                },
                {
                  "kind": "text",
                  "text": " and "
                },
                {
                  "kind": "cref",
                  "value": "F:Aspire.Hosting.OtlpProtocol.HttpJson"
                },
                {
                  "kind": "text",
                  "text": " use its HTTP endpoint. "
                }
              ]
            },
            "typeParameters": {
              "T": [
                {
                  "kind": "text",
                  "text": "The type of the resource that will export telemetry."
                }
              ]
            }
          },
          "sourceFile": "src/CommunityToolkit.Aspire.Hosting.Flare/FlareBuilderExtensions.cs",
          "sourceLines": "323-338"
        },
