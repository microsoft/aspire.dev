          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Adds a Flare observability stack to the application model: an OTLP ingest service (the returned resource), the query API, the alert worker and the dashboard. Containers are used for local development. The default images are "
              },
              {
                "kind": "text",
                "text": ", "
              },
              {
                "kind": "text",
                "text": ", "
              },
              {
                "kind": "text",
                "text": " and "
              },
              {
                "kind": "text",
                "text": ", all with the tag "
              },
              {
                "kind": "text",
                "text": ". "
              }
            ],
            "remarks": [
              {
                "kind": "text",
                "text": " The Flare images create and migrate their own ClickHouse schema on startup. "
              },
              {
                "kind": "text",
                "text": " Add Flare to the application model and send a project's telemetry to it. "
              },
              {
                "kind": "codeblock",
                "text": "\n             var builder = DistributedApplication.CreateBuilder(args);\n            \n             var clickhouse = builder.AddClickHouse(\"clickhouse\");\n             var redis = builder.AddRedis(\"redis\");\n             var flare = builder.AddFlare(\"flare\", clickhouse, redis);\n            \n             builder.AddProject<Projects.Api>(\"api\")\n                 .WithOtlpExporter(flare)\n                 .WaitFor(flare);\n            \n             builder.Build().Run();\n             ",
                "language": "csharp"
              }
            ],
            "returns": [
              {
                "kind": "text",
                "text": "A reference to the "
              },
              {
                "kind": "cref",
                "value": "T:Aspire.Hosting.ApplicationModel.IResourceBuilder`1"
              },
              {
                "kind": "text",
                "text": "."
              }
            ],
            "parameters": {
              "builder": [
                {
                  "kind": "text",
                  "text": "The "
                },
                {
                  "kind": "cref",
                  "value": "T:Aspire.Hosting.IDistributedApplicationBuilder"
                },
                {
                  "kind": "text",
                  "text": "."
                }
              ],
              "clickhouse": [
                {
                  "kind": "text",
                  "text": "The ClickHouse server Flare stores its telemetry in. Flare adds its own database to it."
                }
              ],
              "dashboardPort": [
                {
                  "kind": "text",
                  "text": "The host port for the Flare dashboard."
                }
              ],
              "name": [
                {
                  "kind": "text",
                  "text": "The name of the resource. This name will be used as the connection string name when referenced in a dependency."
                }
              ],
              "redis": [
                {
                  "kind": "text",
                  "text": "The Redis instance Flare uses to buffer telemetry before it is written to ClickHouse."
                }
              ]
            }
          },
          "sourceFile": "src/CommunityToolkit.Aspire.Hosting.Flare/FlareBuilderExtensions.cs",
          "sourceLines": "71-147"
        },
