              },
              {
                "kind": "text",
                "text": ". Resources wired with "
              },
              {
                "kind": "cref",
                "value": "M:Aspire.Hosting.FlareBuilderExtensions.WithOtlpExporter``1(Aspire.Hosting.ApplicationModel.IResourceBuilder{``0},Aspire.Hosting.ApplicationModel.IResourceBuilder{Aspire.Hosting.ApplicationModel.FlareResource},Aspire.Hosting.OtlpProtocol)"
              },
              {
                "kind": "text",
                "text": " send it automatically. "
              }
            ],
            "returns": [
              {
                "kind": "text",
                "text": "A reference to the "
