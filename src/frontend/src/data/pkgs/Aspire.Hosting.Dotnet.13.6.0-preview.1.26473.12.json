              "constructorArguments": [
                "ASPIREDOTNETPROJECT001"
              ],
              "arguments": {
                "UrlFormat": "https://aka.ms/aspire/diagnostics/{0}"
              }
            },
            {
              "name": "Aspire.Hosting.AspireExportAttribute"
            }
          ],
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Adds an environment variable to the build process for a .NET project. "
              }
            ],
            "remarks": [
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " This method supports project files ("
                  },
                  {
                    "kind": "code",
                    "text": ".csproj"
                  },
                  {
                    "kind": "text",
                    "text": ") only. File-based C# apps ("
                  },
                  {
                    "kind": "code",
                    "text": ".cs"
                  },
                  {
                    "kind": "text",
                    "text": ") do not support build-only environment variables. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " The variable is available while Aspire builds the project but is not added to the environment of the launched project. Use "
                  },
                  {
                    "kind": "code",
                    "text": "WithEnvironment"
                  },
                  {
                    "kind": "text",
                    "text": " separately when the same variable is also needed at runtime. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " Configuring a build environment causes Aspire to build this project separately from traversal groups. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " When publishing a container, do not use this API to set MSBuild properties that control the output artifact's identity, destination, format, or target platform. Aspire rejects those properties because downstream publishing steps use the values configured with "
                  },
                  {
                    "kind": "code",
                    "text": "WithContainerBuildOptions"
                  },
                  {
                    "kind": "text",
                    "text": ". "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " Do not use this API for secrets. Aspire must carry the value in IDE launch metadata and process environments, and the value can appear in build diagnostics. Protected temporary MSBuild response files preserve global-property semantics without exposing values in process command lines, but they are not a general-purpose secret transport. "
                  }
                ]
              }
            ],
            "returns": [
              {
                "kind": "text",
                "text": "A reference to the "
              },
              {
                "kind": "cref",
                "value": "T:Aspire.Hosting.ApplicationModel.IResourceBuilder`1"
              },
              {
                "kind": "text",
                "text": " for chaining additional configuration."
              }
            ],
            "parameters": {
              "builder": [
                {
                  "kind": "text",
                  "text": "The .NET project resource builder."
                }
              ],
              "name": [
                {
                  "kind": "text",
                  "text": "The name of the environment variable."
                }
              ],
              "value": [
                {
                  "kind": "text",
                  "text": "The value of the environment variable."
                }
              ]
            },
            "exceptions": [
              {
                "type": "T:System.ArgumentNullException",
                "description": [
                  {
                    "kind": "text",
                    "text": " Thrown when "
                  },
                  {
                    "kind": "paramref",
                    "value": "builder"
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "paramref",
                    "value": "name"
                  },
                  {
                    "kind": "text",
                    "text": ", or "
                  },
                  {
                    "kind": "paramref",
                    "value": "value"
                  },
                  {
                    "kind": "text",
                    "text": " is null. "
                  }
                ]
              },
              {
                "type": "T:System.ArgumentException",
                "description": [
                  {
                    "kind": "text",
                    "text": " Thrown when "
                  },
                  {
                    "kind": "paramref",
                    "value": "name"
                  },
                  {
                    "kind": "text",
                    "text": " is empty. "
                  }
                ]
              },
              {
                "type": "T:Aspire.Hosting.DistributedApplicationException",
                "description": [
                  {
                    "kind": "text",
                    "text": " Thrown when "
                  },
                  {
                    "kind": "paramref",
                    "value": "builder"
                  },
                  {
                    "kind": "text",
                    "text": " represents a file-based C# app. "
                  }
                ]
              }
            ],
            "examples": [
              {
                "code": "\n            builder.AddDotnetProject(\"worker\", \"../Worker/Worker.csproj\")\n                .WithBuildEnvironment(\"BUILD_FLAVOR\", \"custom\");\n            ",
                "language": "csharp",
                "description": [
                  {
                    "kind": "text",
                    "text": "Configure an environment variable that selects a custom build output:"
                  }
                ]
              }
            ]
          },
          "sourceFile": "src/Aspire.Hosting.Dotnet/DotnetProjectHostingExtensions.cs",
          "sourceLines": "75-79"
        },
