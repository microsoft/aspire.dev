          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Adds an Azure Front Door resource to the application model. "
              }
            ],
            "remarks": [
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " Azure Front Door is a global, scalable entry point that uses the Microsoft global edge network to create fast, secure, and widely scalable web applications. Use "
                  },
                  {
                    "kind": "cref",
                    "value": "M:Aspire.Hosting.AzureFrontDoorExtensions.WithOrigin``1(Aspire.Hosting.ApplicationModel.IResourceBuilder{Aspire.Hosting.Azure.AzureFrontDoorResource},Aspire.Hosting.ApplicationModel.IResourceBuilder{``0})"
                  },
                  {
                    "kind": "text",
                    "text": " to add origins (backends) to the Front Door resource. Each origin gets its own Front Door endpoint, origin group, and route, so each backend app is independently routable via its own "
                  },
                  {
                    "kind": "code",
                    "text": "*.azurefd.net"
                  },
                  {
                    "kind": "text",
                    "text": " hostname. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " For advanced scenarios (shared origin groups, path-based routing, custom routes), use "
                  },
                  {
                    "kind": "cref",
                    "value": "M:Aspire.Hosting.AzureProvisioningResourceExtensions.ConfigureInfrastructure``1(Aspire.Hosting.ApplicationModel.IResourceBuilder{``0},System.Action{Aspire.Hosting.Azure.AzureResourceInfrastructure})"
                  },
                  {
                    "kind": "text",
                    "text": " to customize the generated infrastructure directly. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " To reach apps in Azure Container Apps or Azure App Service over Private Link instead of the public Internet, see "
                  },
                  {
                    "kind": "cref",
                    "value": "M:Aspire.Hosting.AzureFrontDoorPrivateLinkExtensions.WithAzureFrontDoorPrivateLink``1(Aspire.Hosting.ApplicationModel.IResourceBuilder{``0},Aspire.Hosting.ApplicationModel.IResourceBuilder{Aspire.Hosting.Azure.AzureFrontDoorResource})"
                  },
                  {
                    "kind": "text",
                    "text": ". "
                  }
                ]
              },
              {
                "kind": "text",
                "text": " Add an Azure Front Door resource with origins: "
              },
              {
                "kind": "codeblock",
                "text": "\n            var api = builder.AddDotnetProject(\"api\", \"../Api/Api.csproj\")\n                .WithExternalHttpEndpoints();\n            var web = builder.AddDotnetProject(\"web\", \"../Web/Web.csproj\")\n                .WithExternalHttpEndpoints();\n            var frontDoor = builder.AddAzureFrontDoor(\"frontdoor\")\n                .WithOrigin(api)\n                .WithOrigin(web);\n            ",
                "language": "csharp"
              }
            ],
            "returns": [
              {
                "kind": "text",
                "text": "A reference to the "
              },
              {
                "kind": "cref",
                "value": "T:Aspire.Hosting.ApplicationModel.IResourceBuilder`1"
              },
              {
                "kind": "text",
                "text": " for chaining."
              }
            ],
            "parameters": {
              "builder": [
                {
                  "kind": "text",
                  "text": "The distributed application builder."
                }
              ],
              "name": [
                {
                  "kind": "text",
                  "text": "The name of the resource."
                }
              ]
            }
          },
          "sourceFile": "src/Aspire.Hosting.Azure.FrontDoor/AzureFrontDoorExtensions.cs",
          "sourceLines": "63-176"
        },
