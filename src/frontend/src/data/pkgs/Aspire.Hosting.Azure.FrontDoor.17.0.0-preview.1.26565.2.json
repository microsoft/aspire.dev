              }
            ],
            "remarks": [
              {
                "kind": "text",
                "text": " The output name follows the pattern "
              },
              {
                "kind": "code",
                "text": "{normalizedOriginName}_endpointId"
              },
              {
                "kind": "text",
                "text": ". For example, if the origin resource is named \"api\", the output is "
              },
              {
                "kind": "code",
                "text": "api_endpointId"
              },
              {
                "kind": "text",
                "text": ". Use this reference when configuring resources that require an endpoint resource ID, such as Azure DNS alias records. "
              }
            ],
            "returns": [
