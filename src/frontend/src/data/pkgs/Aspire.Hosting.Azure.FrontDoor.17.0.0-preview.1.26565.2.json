    {
      "name": "AzureFrontDoorPrivateLinkExtensions",
      "fullName": "Aspire.Hosting.AzureFrontDoorPrivateLinkExtensions",
      "namespace": "Aspire.Hosting",
      "kind": "class",
      "accessibility": "public",
      "isStatic": true,
      "docs": {
        "summary": [
          {
            "kind": "text",
            "text": " Extension methods for reaching Azure Container Apps or Azure App Service through Azure Front Door Private Link. "
          }
        ]
      },
      "sourceFile": "src/Aspire.Hosting.Azure.FrontDoor/AzureFrontDoorPrivateLinkExtensions.cs",
      "sourceLines": "15-15",
      "members": [
        {
          "name": "WithAzureFrontDoorPrivateLink",
          "kind": "method",
          "accessibility": "public",
          "signature": "public static IResourceBuilder<T> AzureFrontDoorPrivateLinkExtensions.WithAzureFrontDoorPrivateLink<T>(this IResourceBuilder<T> environment, IResourceBuilder<AzureFrontDoorResource> frontDoor)",
          "returnType": "Aspire.Hosting.ApplicationModel.IResourceBuilder<T>",
          "isStatic": true,
          "isExtension": true,
          "parameters": [
            {
              "name": "environment",
              "type": "Aspire.Hosting.ApplicationModel.IResourceBuilder<T>",
              "modifier": "this"
            },
            {
              "name": "frontDoor",
              "type": "Aspire.Hosting.ApplicationModel.IResourceBuilder<Aspire.Hosting.Azure.AzureFrontDoorResource>"
            }
          ],
          "genericParameters": [
            {
              "name": "T",
              "constraints": [
                "Aspire.Hosting.Azure.IAzureCdnPrivateLinkTarget"
              ]
            }
          ],
          "attributes": [
            {
              "name": "Aspire.Hosting.AspireExportAttribute",
              "constructorArguments": [
                "withFrontDoorAzureFrontDoorPrivateLink"
              ],
              "arguments": {
                "MethodName": "withAzureFrontDoorPrivateLink"
              }
            },
            {
              "name": "System.Diagnostics.CodeAnalysis.ExperimentalAttribute",
              "constructorArguments": [
                "ASPIREAZURE003"
              ],
              "arguments": {
                "UrlFormat": "https://aka.ms/aspire/diagnostics#{0}"
              }
            }
          ],
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Connects an Azure Front Door to a compute environment, such as an Azure Container Apps environment, over Private Link and disables public network access to its apps, so that the apps in the environment are reachable only through the Front Door. "
              }
            ],
            "remarks": [
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " Add the apps to the Front Door with "
                  },
                  {
                    "kind": "cref",
                    "value": "M:Aspire.Hosting.AzureFrontDoorExtensions.WithOrigin``1(Aspire.Hosting.ApplicationModel.IResourceBuilder{Aspire.Hosting.Azure.AzureFrontDoorResource},Aspire.Hosting.ApplicationModel.IResourceBuilder{``0})"
                  },
                  {
                    "kind": "text",
                    "text": ", before or after this call. When publishing, every origin of "
                  },
                  {
                    "kind": "paramref",
                    "value": "frontDoor"
                  },
                  {
                    "kind": "text",
                    "text": " that runs in "
                  },
                  {
                    "kind": "paramref",
                    "value": "environment"
                  },
                  {
                    "kind": "text",
                    "text": " becomes a Private Link origin: the Front Door profile uses the Premium SKU, and the origin connects to the environment through a Front Door managed private endpoint. The apps must expose external HTTP endpoints, for example with "
                  },
                  {
                    "kind": "code",
                    "text": "WithExternalHttpEndpoints"
                  },
                  {
                    "kind": "text",
                    "text": ". Origins in other compute environments are left as they are. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " Like a private endpoint to any other Azure resource, the Private Link disables public network access to the environment. Apps in the environment are no longer reachable from the Internet except through Front Door. Callers outside the environment must reach the apps through the Front Door, or through a route of their own. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " An Azure Container Apps environment can only have its public network access disabled when Aspire provisions it, so it can't be marked as existing, and it must be a workload profiles environment, not an "
                  },
                  {
                    "kind": "href",
                    "text": "Azure Container Apps Express",
                    "value": "https://learn.microsoft.com/azure/container-apps/express-overview"
                  },
                  {
                    "kind": "text",
                    "text": " environment. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " For Azure App Service, each origin targets its own website with the "
                  },
                  {
                    "kind": "code",
                    "text": "sites"
                  },
                  {
                    "kind": "text",
                    "text": " group ID, not the App Service plan. Public network access is disabled on all workload websites in the connected environment, including websites that are not Front Door origins. The separately provisioned Aspire dashboard is unchanged. Existing App Service plans are supported because Aspire still provisions the websites. Front Door Private Link cannot target a deployment slot, so with "
                  },
                  {
                    "kind": "code",
                    "text": "WithDeploymentSlot"
                  },
                  {
                    "kind": "text",
                    "text": " each origin targets the production site and the slot, which has public access disabled and no private endpoint, is not reachable through Front Door: deploy to the slot and swap it into production. The production site is created only if it does not exist, so enabling this on a site that already exists doesn't disable its public access. Unlike Container Apps, App Service does not provide an environment-local ingress route between apps: service-to-service callers must use Front Door URLs or configure their own private network access and DNS. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " Front Door creates a connection request in the Pending state, and no traffic reaches the apps until the owner of the target approves it. Approve it in the Azure portal, under the Container Apps environment's or each App Service website's networking settings, or with the Azure CLI by finding the request with "
                  },
                  {
                    "kind": "code",
                    "text": "az network private-endpoint-connection list"
                  },
                  {
                    "kind": "text",
                    "text": " and approving it with "
                  },
                  {
                    "kind": "code",
                    "text": "az network private-endpoint-connection approve"
                  },
                  {
                    "kind": "text",
                    "text": ". Front Door can create more than one request; approve each one that has the message of this connection. Traffic starts flowing a few minutes after approval. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " Front Door creates its private endpoint in the region of "
                  },
                  {
                    "kind": "paramref",
                    "value": "environment"
                  },
                  {
                    "kind": "text",
                    "text": ". Front Door Private Link is only available in some "
                  },
                  {
                    "kind": "href",
                    "text": "regions",
                    "value": "https://learn.microsoft.com/azure/frontdoor/private-link#region-availability"
                  },
                  {
                    "kind": "text",
                    "text": ", so for an environment in another region the private endpoint is created in the supported region of the same geography, such as "
                  },
                  {
                    "kind": "code",
                    "text": "westus2"
                  },
                  {
                    "kind": "text",
                    "text": " for "
                  },
                  {
                    "kind": "code",
                    "text": "westus"
                  },
                  {
                    "kind": "text",
                    "text": ", at the cost of an extra network hop. Deployment fails when the geography has no supported region. To choose another region, set the origin's "
                  },
                  {
                    "kind": "code",
                    "text": "SharedPrivateLinkResource.PrivateLinkLocation"
                  },
                  {
                    "kind": "text",
                    "text": " in "
                  },
                  {
                    "kind": "cref",
                    "value": "M:Aspire.Hosting.AzureProvisioningResourceExtensions.ConfigureInfrastructure``1(Aspire.Hosting.ApplicationModel.IResourceBuilder{``0},System.Action{Aspire.Hosting.Azure.AzureResourceInfrastructure})"
                  },
                  {
                    "kind": "text",
                    "text": " on "
                  },
                  {
                    "kind": "paramref",
                    "value": "frontDoor"
                  },
                  {
                    "kind": "text",
                    "text": ", for example to a parameter. "
                  }
                ]
              },
              {
                "kind": "para",
                "children": [
                  {
                    "kind": "text",
                    "text": " Private Link has no run-mode counterpart, so this method does nothing when the AppHost runs locally. "
                  }
                ]
              }
            ],
            "returns": [
              {
                "kind": "text",
                "text": "A reference to the "
              },
              {
                "kind": "cref",
                "value": "T:Aspire.Hosting.ApplicationModel.IResourceBuilder`1"
              },
              {
                "kind": "text",
                "text": " for "
              },
              {
                "kind": "paramref",
                "value": "environment"
              },
              {
                "kind": "text",
                "text": ", for chaining."
              }
            ],
            "parameters": {
              "environment": [
                {
                  "kind": "text",
                  "text": "The compute environment to connect to."
                }
              ],
              "frontDoor": [
                {
                  "kind": "text",
                  "text": " The Azure Front Door, created with "
                },
                {
                  "kind": "cref",
                  "value": "M:Aspire.Hosting.AzureFrontDoorExtensions.AddAzureFrontDoor(Aspire.Hosting.IDistributedApplicationBuilder,System.String)"
                },
                {
                  "kind": "text",
                  "text": ", whose origins in "
                },
                {
                  "kind": "paramref",
                  "value": "environment"
                },
                {
                  "kind": "text",
                  "text": " use Private Link. "
                }
              ]
            },
            "typeParameters": {
              "T": [
                {
                  "kind": "text",
                  "text": "The type of the compute environment, which implements "
                },
                {
                  "kind": "cref",
                  "value": "T:Aspire.Hosting.Azure.IAzureCdnPrivateLinkTarget"
                },
                {
                  "kind": "text",
                  "text": "."
                }
              ]
            },
            "exceptions": [
              {
                "type": "T:System.ArgumentNullException",
                "description": [
                  {
                    "kind": "paramref",
                    "value": "environment"
                  },
                  {
                    "kind": "text",
                    "text": " or "
                  },
                  {
                    "kind": "paramref",
                    "value": "frontDoor"
                  },
                  {
                    "kind": "text",
                    "text": " is "
                  },
                  {
                    "kind": "langword",
                    "value": "null"
                  },
                  {
                    "kind": "text",
                    "text": "."
                  }
                ]
              },
              {
                "type": "T:System.InvalidOperationException",
                "description": [
                  {
                    "kind": "text",
                    "text": " Publishing fails for existing or Express Container Apps environments, when "
                  },
                  {
                    "kind": "paramref",
                    "value": "frontDoor"
                  },
                  {
                    "kind": "text",
                    "text": " has no origin in the environment, and when another Front Door has an origin in the environment without being connected to it. "
                  }
                ]
              }
            ],
            "examples": [
              {
                "code": "\n             var environment = builder.AddAzureContainerAppEnvironment(\"env\");\n             var frontDoor = builder.AddAzureFrontDoor(\"frontdoor\");\n             environment.WithAzureFrontDoorPrivateLink(frontDoor);\n            \n             var api = builder.AddDotnetProject(\"api\", \"../Api/Api.csproj\")\n                 .WithExternalHttpEndpoints();\n             var web = builder.AddDotnetProject(\"web\", \"../Web/Web.csproj\")\n                 .WithExternalHttpEndpoints()\n                 .WithReference(api);\n             frontDoor.WithOrigin(api).WithOrigin(web);\n             ",
                "language": "csharp"
              }
            ]
          },
          "sourceFile": "src/Aspire.Hosting.Azure.FrontDoor/AzureFrontDoorPrivateLinkExtensions.cs",
          "sourceLines": "131-153"
        }
      ]
    },
