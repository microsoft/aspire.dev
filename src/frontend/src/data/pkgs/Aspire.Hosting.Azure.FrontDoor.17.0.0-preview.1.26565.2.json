          "name": "AddAzureFrontDoor",
          "kind": "method",
          "accessibility": "public",
          "signature": "public static IResourceBuilder<AzureFrontDoorResource> AzureFrontDoorExtensions.AddAzureFrontDoor(this IDistributedApplicationBuilder builder, string name)",
          "returnType": "Aspire.Hosting.ApplicationModel.IResourceBuilder<Aspire.Hosting.Azure.AzureFrontDoorResource>",
          "isStatic": true,
          "isExtension": true,
