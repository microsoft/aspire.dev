              {
                "kind": "text",
                "text": " Adds an administration and development platform for MySql to the application model using Adminer. "
              }
            ],
            "remarks": [
              {
                "kind": "text",
                "text": " This version of the package defaults to the "
              },
              {
                "kind": "text",
                "text": " tag of the "
              },
              {
                "kind": "text",
                "text": " container image. "
              },
              {
                "kind": "text",
                "text": "The MySql server resource builder."
              },
              {
                "kind": "text",
                "text": "Configuration callback for Adminer container resource."
              },
              {
                "kind": "text",
                "text": "The name of the container (Optional)."
              },
              {
                "kind": "text",
                "text": " Use in application host with a MySql resource "
              },
              {
                "kind": "codeblock",
                "text": "\n             var builder = DistributedApplication.CreateBuilder(args);\n            \n             var mysql = builder.AddMySql(\"mysql\")\n                .WithAdminer();\n             var db = mysql.AddDatabase(\"db\");\n            \n             var api = builder.AddProject<Projects.Api>(\"api\")\n               .WithReference(db);\n            \n             builder.Build().Run();\n             ",
