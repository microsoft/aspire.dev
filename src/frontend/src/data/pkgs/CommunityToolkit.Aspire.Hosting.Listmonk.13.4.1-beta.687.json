          ],
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Adds a listmonk container resource to the application model. The default image is "
              },
              {
                "kind": "text",
                "text": " and the tag is "
              },
              {
                "kind": "text",
                "text": ". "
              }
            ],
            "remarks": [
              {
                "kind": "text",
                "text": " Add a listmonk container to the application model and reference it in a .NET project. "
              },
              {
                "kind": "codeblock",
                "text": "\n             var builder = DistributedApplication.CreateBuilder(args);\n            \n             var db = builder.AddPostgres(\"postgres\")\n               .AddDatabase(\"db\");\n             var listmonk = builder.AddListmonk(\"listmonk\")\n               .WithReference(db);\n             var api = builder.AddProject<Projects.Api>(\"api\")\n               .WithReference(listmonk);\n            \n             builder.Build().Run();\n             ",
                "language": "csharp"
              }
            ],
            "returns": [
              {
                "kind": "text",
                "text": "A reference to the "
              },
              {
                "kind": "cref",
                "value": "T:Aspire.Hosting.ApplicationModel.IResourceBuilder`1"
              },
              {
                "kind": "text",
                "text": "."
              }
            ],
            "parameters": {
              "builder": [
                {
                  "kind": "text",
                  "text": "The "
                },
                {
                  "kind": "cref",
                  "value": "T:Aspire.Hosting.IDistributedApplicationBuilder"
                },
                {
                  "kind": "text",
                  "text": "."
                }
              ],
              "name": [
                {
                  "kind": "text",
                  "text": "The name of the resource. This name will be used as the connection string name when referenced in a dependency."
                }
              ],
              "port": [
                {
                  "kind": "text",
                  "text": "The host port for the listmonk HTTP endpoint. If "
                },
                {
                  "kind": "langword",
                  "value": "null"
                },
                {
                  "kind": "text",
                  "text": ", Aspire will assign a random host port."
                }
              ]
            }
          },
