        "typeName": "AddNxAppOptions",
        "fields": [
          {
            "name": "WorkingDirectory",
            "jsonName": "workingDirectory",
            "type": "*string",
            "description": "The working directory of the Nx workspace. If not specified, it will be set to a path that is a sibling of the AppHost directory using the `name` as the folder."
