      "qualifiedName": "addNxApp",
      "description": "Adds an Nx monorepo workspace to the distributed application builder.",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "AddNxApp(name string, options ...*AddNxAppOptions) NxResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the Nx workspace resource."
        }
      ],
