      "signature": "AddMinioContainer(name string, options ...*AddMinioContainerOptions) MinioContainerResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the resource. This name will be used as the connection string name when referenced in a dependency."
        }
      ],
      "options": {
        "typeName": "AddMinioContainerOptions",
        "fields": [
          {
            "name": "RootUser",
            "jsonName": "rootUser",
            "type": "*ParameterResource",
            "description": "The parameter used to provide the root user name for the MinIO resource. If `null` a default value will be used."
          },
          {
            "name": "RootPassword",
            "jsonName": "rootPassword",
            "type": "*ParameterResource",
            "description": "The parameter used to provide the administrator password for the MinIO resource. If `null` a random password will be generated."
          },
          {
            "name": "Port",
            "jsonName": "port",
            "type": "*float64",
            "description": "The host port for MinIO."
          }
        ]
      },
      "returnType": "MinioContainerResource",
