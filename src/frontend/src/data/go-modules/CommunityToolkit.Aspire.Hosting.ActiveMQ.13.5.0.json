    {
      "name": "AddActiveMQ",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.ActiveMQ/addActiveMQ",
      "qualifiedName": "addActiveMQ",
      "description": "Adds a ActiveMQ container to the application model.",
      "remarks": "The default image and tag are \"apache/activemq-classic\" and \"6.1.7\".",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "AddActiveMQ(name string, options ...*AddActiveMQOptions) ActiveMQServerResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the resource. This name will be used as the connection string name when referenced in a dependency."
        }
      ],
      "options": {
        "typeName": "AddActiveMQOptions",
        "fields": [
          {
            "name": "UserName",
            "jsonName": "userName",
            "type": "*ParameterResource",
            "description": "The parameter used to provide the username for the ActiveMQ resource. If `null` a default value will be used."
          },
          {
            "name": "Password",
            "jsonName": "password",
            "type": "*ParameterResource",
            "description": "The parameter used to provide the password for the ActiveMQ resource. If `null` a random password will be generated."
          },
          {
            "name": "Port",
            "jsonName": "port",
            "type": "*float64",
            "description": "The host port that the underlying container is bound to when running locally."
          },
          {
            "name": "Scheme",
            "jsonName": "scheme",
            "type": "*string",
            "description": "The scheme of the endpoint, e.g. tcp or activemq (for masstransit). Defaults to tcp."
          },
          {
            "name": "WebPort",
            "jsonName": "webPort",
            "type": "*float64",
            "description": "The host port that the underlying webconsole is bound to when running locally."
          }
        ]
      },
      "returnType": "ActiveMQServerResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
