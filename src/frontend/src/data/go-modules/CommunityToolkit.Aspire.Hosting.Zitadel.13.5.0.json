  "functions": [
    {
      "name": "AddZitadel",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Zitadel/addZitadel",
      "qualifiedName": "addZitadel",
      "description": "Adds a Zitadel container resource",
      "kind": "Method",
      "signature": "AddZitadel(name string, options ...*AddZitadelOptions) ZitadelResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the resource. This name will be used as the connection string name when referenced in a dependency."
        }
      ],
      "options": {
        "typeName": "AddZitadelOptions",
        "fields": [
          {
            "name": "Port",
            "jsonName": "port",
            "type": "*float64",
            "description": "The host port used when launching the container. If `null` a random port will be assigned"
          },
          {
            "name": "Username",
            "jsonName": "username",
            "type": "*ParameterResource",
            "description": "An optional parameter to set a username for the admin account, if `null` will auto generate one."
          },
          {
            "name": "Password",
            "jsonName": "password",
            "type": "*ParameterResource",
            "description": "An optional parameter to set a password for the admin account, if `null` will auto generate one."
          },
          {
            "name": "MasterKey",
            "jsonName": "masterKey",
            "type": "*ParameterResource",
            "description": "An optional parameter to set the masterkey, if `null` will auto generate one."
          }
        ]
      },
      "returnType": "ZitadelResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
