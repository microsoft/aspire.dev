    {
      "name": "AddListmonk",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Listmonk/addListmonk",
      "qualifiedName": "addListmonk",
      "description": "Adds a listmonk container resource to the application model. The default image is and the tag is .",
      "remarks": "Add a listmonk container to the application model and reference it in a .NET project.\n```\nvar builder = DistributedApplication.CreateBuilder(args);\nvar db = builder.AddPostgres(\"postgres\")\n.AddDatabase(\"db\");\nvar listmonk = builder.AddListmonk(\"listmonk\")\n.WithReference(db);\nvar api = builder.AddProject<Projects.Api>(\"api\")\n.WithReference(listmonk);\nbuilder.Build().Run();\n```",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "AddListmonk(name string, options ...*AddListmonkOptions) ListmonkResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the resource. This name will be used as the connection string name when referenced in a dependency."
        }
      ],
      "options": {
        "typeName": "AddListmonkOptions",
        "fields": [
          {
            "name": "Port",
            "jsonName": "port",
            "type": "*float64",
            "description": "The host port for the listmonk HTTP endpoint. If `null`, Aspire will assign a random host port."
          }
        ]
      },
      "returnType": "ListmonkResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
