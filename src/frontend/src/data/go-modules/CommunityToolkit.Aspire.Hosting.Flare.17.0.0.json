    {
      "name": "AddFlare",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Flare/addFlare",
      "qualifiedName": "addFlare",
      "description": "Adds a Flare observability stack to the application model: an OTLP ingest service (the returned resource), the query API, the alert worker and the dashboard. Containers are used for local development. The default images are , , and , all with the tag .",
      "remarks": "The Flare images create and migrate their own ClickHouse schema on startup.\nAdd Flare to the application model and send a project's telemetry to it.\n```\nvar builder = DistributedApplication.CreateBuilder(args);\nvar clickhouse = builder.AddClickHouse(\"clickhouse\");\nvar redis = builder.AddRedis(\"redis\");\nvar flare = builder.AddFlare(\"flare\", clickhouse, redis);\nbuilder.AddProject<Projects.Api>(\"api\")\n.WithOtlpExporter(flare)\n.WaitFor(flare);\nbuilder.Build().Run();\n```",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "AddFlare(name string, clickhouse ClickHouseServerResource, redis RedisResource, options ...*AddFlareOptions) FlareResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the resource. This name will be used as the connection string name when referenced in a dependency."
        },
        {
          "name": "clickhouse",
          "type": "ClickHouseServerResource",
          "description": "The ClickHouse server Flare stores its telemetry in. Flare adds its own database to it."
        },
        {
          "name": "redis",
          "type": "RedisResource",
          "description": "The Redis instance Flare uses to buffer telemetry before it is written to ClickHouse."
        }
      ],
      "options": {
        "typeName": "AddFlareOptions",
        "fields": [
          {
            "name": "DashboardPort",
            "jsonName": "dashboardPort",
            "type": "*float64",
            "description": "The host port for the Flare dashboard."
          }
        ]
      },
      "returnType": "FlareResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
