    {
      "name": "AddNgrok",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Ngrok/addNgrok",
      "qualifiedName": "addNgrok",
      "description": "Configures a container resource for grok which is pre-configured to connect to the resource that this method is used on.",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "AddNgrok(name string, options ...*AddNgrokOptions) NgrokResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the resource."
        }
      ],
      "options": {
        "typeName": "AddNgrokOptions",
        "fields": [
          {
            "name": "ConfigurationFolder",
            "jsonName": "configurationFolder",
            "type": "*string",
            "description": "The folder where temporary ngrok configuration files will be stored; defaults to .ngrok"
          },
          {
            "name": "EndpointPort",
            "jsonName": "endpointPort",
            "type": "*float64",
            "description": "The port of the endpoint for this resource, defaults to a randomly assigned port."
          },
          {
            "name": "EndpointName",
            "jsonName": "endpointName",
            "type": "*string",
            "description": "The name of the endpoint for this resource, defaults to http."
          },
          {
            "name": "ConfigurationVersion",
            "jsonName": "configurationVersion",
            "type": "*float64",
            "description": "The output version of the ngrok configuration file."
          }
        ]
      },
      "returnType": "NgrokResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
