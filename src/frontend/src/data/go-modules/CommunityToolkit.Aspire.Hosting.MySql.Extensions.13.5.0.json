    {
      "name": "WithAdminer",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.MySql.Extensions/withAdminer",
      "qualifiedName": "withAdminer",
      "description": "Adds an administration and development platform for MySql to the application model using Adminer.",
      "remarks": "This version of the package defaults to the tag of the container image.\nThe MySql server resource builder.Configuration callback for Adminer container resource.The name of the container (Optional).\nUse in application host with a MySql resource\n```\nvar builder = DistributedApplication.CreateBuilder(args);\nvar mysql = builder.AddMySql(\"mysql\")\n.WithAdminer();\nvar db = mysql.AddDatabase(\"db\");\nvar api = builder.AddProject<Projects.Api>(\"api\")\n.WithReference(db);\nbuilder.Build().Run();\n```",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "WithAdminer(options ...*WithAdminerOptions) MySqlServerResource",
      "receiver": "MySqlServerResource",
      "parameters": [],
      "options": {
        "typeName": "WithAdminerOptions",
        "fields": [
          {
            "name": "ConfigureContainer",
            "type": "func(obj AdminerContainerResource)",
            "isCallback": true,
            "callbackSignature": "func(obj AdminerContainerResource)"
          },
          {
            "name": "ContainerName",
            "jsonName": "containerName",
            "type": "*string"
          }
        ]
      },
      "returnType": "MySqlServerResource",
      "returnsReceiver": true,
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting.MySql/Aspire.Hosting.ApplicationModel.MySqlServerResource",
      "expandedTargetTypes": [
        "Aspire.Hosting.ApplicationModel.MySqlServerResource"
      ],
      "appliesTo": [
        "MySqlServerResource"
      ]
    },
