    {
      "name": "AddGoFeatureFlag",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.GoFeatureFlag/addGoFeatureFlag",
      "qualifiedName": "addGoFeatureFlag",
      "description": "Adds an GO Feature Flag container resource to the application model. The default image is and the tag is .",
      "remarks": "Add an GO Feature Flag container to the application model and reference it in a .NET project.\n```\nvar builder = DistributedApplication.CreateBuilder(args);\nvar goff = builder.AddGoFeatureFlag(\"goff\");\nvar api = builder.AddProject<Projects.Api>(\"api\")\n.WithReference(goff);\nbuilder.Build().Run();\n```",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "AddGoFeatureFlag(name string, options ...*AddGoFeatureFlagOptions) GoFeatureFlagResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the resource. This name will be used as the connection string name when referenced in a dependency."
        }
      ],
      "options": {
        "typeName": "AddGoFeatureFlagOptions",
        "fields": [
          {
            "name": "PathToConfigFile",
            "jsonName": "pathToConfigFile",
            "type": "*string",
            "description": "The path set to find the configuration file (https://gofeatureflag.org/docs/relay-proxy/configure-relay-proxy#configuration-file)."
          },
          {
            "name": "Port",
            "jsonName": "port",
            "type": "*float64",
            "description": "The host port to bind the underlying container to."
          }
        ]
      },
      "returnType": "GoFeatureFlagResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
    {
      "name": "WithDataVolume",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.GoFeatureFlag/withDataVolume",
      "qualifiedName": "withDataVolume",
      "description": "Adds a named volume for the data folder to a GO Feature flag container resource.",
      "remarks": "Add a GO Feature flag container to the application model and reference it in a .NET project. Additionally, in this\nexample a data volume is added to the container to allow data to be persisted across container restarts.\n```\nvar builder = DistributedApplication.CreateBuilder(args);\nvar goff = builder.AddGoFeatureFlag(\"goff\")\n.WithDataVolume();\nvar api = builder.AddProject<Projects.Api>(\"api\")\n.WithReference(goff);\nbuilder.Build().Run();\n```",
      "returns": "The `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "WithDataVolume(options ...*WithDataVolumeOptions) GoFeatureFlagResource",
      "receiver": "GoFeatureFlagResource",
      "parameters": [],
      "options": {
        "typeName": "WithDataVolumeOptions",
        "fields": [
          {
            "name": "Name",
            "jsonName": "name",
            "type": "*string",
            "description": "The name of the volume. Defaults to an auto-generated name based on the application and resource names."
          }
        ]
      },
      "returnType": "GoFeatureFlagResource",
      "returnsReceiver": true,
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "CommunityToolkit.Aspire.Hosting.GoFeatureFlag/Aspire.Hosting.ApplicationModel.GoFeatureFlagResource",
      "expandedTargetTypes": [
        "Aspire.Hosting.ApplicationModel.GoFeatureFlagResource"
      ],
      "appliesTo": [
        "GoFeatureFlagResource"
      ]
    },
    {
      "name": "WithGoffBindMount",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.GoFeatureFlag/withGoffBindMount",
      "qualifiedName": "withGoffBindMount",
      "description": "Adds a bind mount for the goff configuration folder to a GO Feature flag container resource.",
      "remarks": "Add a GO Feature flag container to the application model and reference it in a .NET project. Additionally, in this\nexample a bind mount is added to the container to allow reading goff configuration.\n```\nvar builder = DistributedApplication.CreateBuilder(args);\nvar goff = builder.AddGoFeatureFlag(\"goff\")\n.WithGoffBindMount(\"./goff\");\nvar api = builder.AddProject<Projects.Api>(\"api\")\n.WithReference(goff);\nbuilder.Build().Run();\n```",
      "returns": "The `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "WithGoffBindMount(source string) GoFeatureFlagResource",
      "receiver": "GoFeatureFlagResource",
      "parameters": [
        {
          "name": "source",
          "type": "string",
          "description": "The source directory on the host to mount into the container."
        }
      ],
      "returnType": "GoFeatureFlagResource",
      "returnsReceiver": true,
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "CommunityToolkit.Aspire.Hosting.GoFeatureFlag/Aspire.Hosting.ApplicationModel.GoFeatureFlagResource",
