  "functions": [
    {
      "name": "AddMcpInspector",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.McpInspector/addMcpInspectorPolyglot",
      "qualifiedName": "addMcpInspector",
      "description": "Adds a MCP Inspector container resource",
      "remarks": "By default, the MCP Inspector uses npm/npx. To use a different package manager, chain the appropriate method:\n```\nbuilder.AddMcpInspector(\"inspector\")\n.WithYarn();\n```",
      "returns": "A reference to the `IResourceBuilder`1` for further configuration.",
      "kind": "Method",
      "signature": "AddMcpInspector(name string, options ...*AddMcpInspectorOptions) McpInspectorResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the MCP Inspector container resource."
        }
      ],
      "options": {
        "typeName": "AddMcpInspectorOptions",
        "fields": [
          {
            "name": "ClientPort",
            "jsonName": "clientPort",
            "type": "*float64",
            "description": "The port for the client application. Defaults to 6274."
          },
          {
            "name": "ServerPort",
            "jsonName": "serverPort",
            "type": "*float64",
            "description": "The port for the server proxy application. Defaults to 6277."
          },
          {
            "name": "InspectorVersion",
            "jsonName": "inspectorVersion",
            "type": "*string",
            "description": "The version of the Inspector app to use. Defaults to `InspectorVersion`."
          },
          {
            "name": "ProxyToken",
            "jsonName": "proxyToken",
            "type": "*ParameterResource",
            "description": "The parameter used to provide the proxy authentication token. If `null` a random token will be generated."
          }
        ]
      },
      "returnType": "McpInspectorResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
