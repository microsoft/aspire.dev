    {
      "name": "AddPostaWithReferences",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Posta/addPostaWithReferences",
      "qualifiedName": "addPostaWithReferences",
      "description": "Adds a Posta container resource with PostgreSQL and Redis references",
      "returns": "A reference to the `IResourceBuilder`1` for further resource configuration.",
      "kind": "Method",
      "signature": "AddPostaWithReferences(name string, database PostgresDatabaseResource, redis RedisResource, options ...*AddPostaWithReferencesOptions) PostaResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the Posta container resource."
        },
        {
          "name": "database",
          "type": "PostgresDatabaseResource",
          "description": "The PostgreSQL database resource used by Posta."
        },
        {
          "name": "redis",
          "type": "RedisResource",
          "description": "The Redis resource used by Posta."
        }
      ],
      "options": {
        "typeName": "AddPostaWithReferencesOptions",
        "fields": [
          {
            "name": "JwtSecret",
            "jsonName": "jwtSecret",
            "type": "*ParameterResource",
            "description": "Optional parameter used as the Posta JWT signing secret."
          },
          {
            "name": "AdminPassword",
            "jsonName": "adminPassword",
            "type": "*ParameterResource",
            "description": "Optional parameter used as the initial Posta admin password."
          },
          {
            "name": "AdminEmail",
            "jsonName": "adminEmail",
            "type": "*string",
            "description": "The initial Posta admin account email."
          },
          {
            "name": "Port",
            "jsonName": "port",
            "type": "*float64",
            "description": "Optional host port for the Posta HTTP API and dashboard."
          }
        ]
      },
      "returnType": "PostaResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
