        "typeName": "AddFlagdOptions",
        "fields": [
          {
            "name": "Port",
            "jsonName": "port",
            "type": "*float64",
            "description": "The host port for flagd HTTP endpoint. If not provided, a random port will be assigned."
          },
          {
            "name": "OfrepPort",
            "jsonName": "ofrepPort",
            "type": "*float64",
            "description": "The host port for flagd OFREP endpoint. If not provided, a random port will be assigned."
          }
