      "name": "AddDenoApp",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Deno/addDenoApp",
      "qualifiedName": "addDenoApp",
      "description": "Adds a Deno application to the application model. Deno should available on the PATH.",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "AddDenoApp(name string, scriptPath string, options ...*AddDenoAppOptions) DenoAppResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name of the resource."
        },
        {
          "name": "scriptPath",
          "type": "string",
          "description": "The path to the script that Deno will execute."
        }
      ],
      "options": {
        "typeName": "AddDenoAppOptions",
        "fields": [
          {
            "name": "WorkingDirectory",
            "jsonName": "workingDirectory",
            "type": "*string",
            "description": "The working directory to use for the command. If null, the working directory of the current process is used."
          },
          {
            "name": "PermissionFlags",
            "jsonName": "permissionFlags",
            "type": "[]string",
            "description": "The permissions to grant to the program run."
          },
          {
            "name": "Args",
            "jsonName": "args",
            "type": "[]string",
            "description": "The arguments to pass to the command."
          }
        ]
      },
      "returnType": "DenoAppResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
