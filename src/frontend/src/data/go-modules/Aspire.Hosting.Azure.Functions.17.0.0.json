    {
      "name": "AddAzureFunctionsApp",
      "capabilityId": "Aspire.Hosting.Azure.Functions/addAzureFunctionsApp",
      "qualifiedName": "addAzureFunctionsApp",
      "description": "Adds an Azure Functions app from a source directory to the distributed application.",
      "remarks": "This overload is intended for Azure Functions apps that do not have a .NET project file, such as\nTypeScript and JavaScript apps that run on the Node language worker. TypeScript apps are launched\nthrough `npm run start` so the standard Core Tools generated `prestart` script can build\nthe app before the Functions host starts. The `start` script should resolve Azure Functions\nCore Tools from the app's local npm dependencies, for example by depending on the\n`azure-functions-core-tools` package.\nBy default, an implicit Azure Storage account is provisioned to be used as host storage for the Functions runtime.\nUse `WithHostStorage`\nto specify a custom Azure Storage resource as the host storage instead.\nAdd a TypeScript Azure Functions app to the app model.\n```\n#pragma warning disable ASPIREAZUREFUNCTIONS001\nvar builder = DistributedApplication.CreateBuilder(args);\nbuilder.AddAzureFunctionsApp(\"funcapp\", \"../functions\", AzureFunctionsLanguage.TypeScript);\nbuilder.Build().Run();\n#pragma warning restore ASPIREAZUREFUNCTIONS001\n```",
      "returns": "The resource builder.",
      "kind": "Method",
      "signature": "AddAzureFunctionsApp(name string, appDirectory string, language AzureFunctionsLanguage) AzureFunctionsAppResource",
      "receiver": "DistributedApplicationBuilder",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "The name to be associated with the Azure Functions app. This name will be used for service discovery when referenced in a dependency."
        },
        {
          "name": "appDirectory",
          "type": "string",
          "description": "The path to the directory containing the Azure Functions app."
        },
        {
          "name": "language",
          "type": "AzureFunctionsLanguage",
          "description": "The authoring language used by the Azure Functions app."
        }
      ],
      "returnType": "AzureFunctionsAppResource",
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.IDistributedApplicationBuilder",
      "expandedTargetTypes": [
        "Aspire.Hosting.IDistributedApplicationBuilder"
      ],
      "appliesTo": [
        "DistributedApplicationBuilder"
      ]
    },
