    {
      "name": "WithAzureStorageExplorer",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Azure.Extensions/withBlobAzureStorageExplorer",
      "qualifiedName": "withAzureStorageExplorer",
      "description": "Adds an Azure Storage Explorer instance to a Blob storage resource.",
      "remarks": "Add an Azure Storage Explorer container to the application model and reference it in a .NET project.\n```\nvar builder = DistributedApplication.CreateBuilder(args);\nvar storage = builder.AddAzureStorage(\"storage\")\n.RunAsEmulator(azurite =>\n{\nazurite\n.WithBlobPort(27000)\n.WithQueuePort(27001)\n.WithTablePort(27002);\n});\nvar blobs = storage.AddBlobs(\"blobs\")\n.WithAzureStorageExplorer();\nbuilder.Build().Run();\n```",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "WithAzureStorageExplorer(options ...*WithAzureStorageExplorerOptions) AzureBlobStorageResource",
      "receiver": "AzureBlobStorageResource",
      "parameters": [],
      "options": {
        "typeName": "WithAzureStorageExplorerOptions",
        "fields": [
          {
            "name": "ConfigureContainer",
            "type": "func(obj AzureStorageExplorerResource)",
            "isCallback": true,
            "callbackSignature": "func(obj AzureStorageExplorerResource)",
            "description": "Configuration callback for Azure Storage Explorer container resource."
          },
          {
            "name": "Name",
            "jsonName": "name",
            "type": "*string",
            "description": "The name of the resource."
          }
        ]
      },
      "returnType": "AzureBlobStorageResource",
      "returnsReceiver": true,
      "errorModel": "deferred",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting.Azure.Storage/Aspire.Hosting.Azure.AzureBlobStorageResource",
      "expandedTargetTypes": [
        "Aspire.Hosting.Azure.AzureBlobStorageResource"
      ],
