    {
      "name": "withKindClusterReference",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Kind/withKindClusterReference",
      "qualifiedName": "withKindClusterReference",
      "description": "Configures a non-container resource to reference the Kind cluster by injecting kubeconfig environment variables.",
      "remarks": "This overload sets `KUBECONFIG` to the host kubeconfig path, which is appropriate for\nresources that execute on the host (e.g., executables, projects).\nFor container resources, use the `WithReference`\noverload instead, which handles container-specific requirements like bind-mounting and network connectivity.",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "withKindClusterReference(kind: KindClusterResource): IResourceWithEnvironment",
      "parameters": [
        {
          "name": "kind",
          "type": "KindClusterResource",
          "description": "The Kind cluster resource builder."
        }
      ],
      "returnType": "IResourceWithEnvironment",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.ApplicationModel.IResourceWithEnvironment",
      "expandedTargetTypes": [
        "Aspire.Hosting.ApplicationModel.ContainerResource",
        "Aspire.Hosting.ApplicationModel.ExecutableResource",
        "Aspire.Hosting.ApplicationModel.ProjectResource",
        "Aspire.Hosting.ApplicationModel.DotnetToolResource",
        "Aspire.Hosting.ApplicationModel.CSharpAppResource",
        "Aspire.Hosting.Kubernetes.KubernetesAspireDashboardResource"
      ]
    },
    {
      "name": "withKindContainerReference",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Kind/withKindContainerReference",
      "qualifiedName": "withKindContainerReference",
      "description": "Configures a container resource to reference the Kind cluster by bind-mounting the container-compatible kubeconfig, injecting environment variables, and connecting to the Kind container network.",
      "remarks": "This overload is the primary integration path for containers. It:\n-\n-\n-\n-\nThe container-compatible kubeconfig uses the Kind control-plane container name\n(`{clusterName}-control-plane`) instead of `127.0.0.1`, enabling container-to-container\ncommunication over the Kind container network.",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "withKindContainerReference(kind: KindClusterResource): ContainerResource",
      "parameters": [
        {
          "name": "kind",
          "type": "KindClusterResource",
          "description": "The Kind cluster resource builder."
        }
      ],
      "returnType": "ContainerResource",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.ApplicationModel.ContainerResource",
      "expandedTargetTypes": [
        "Aspire.Hosting.ApplicationModel.ContainerResource",
        "Aspire.Hosting.Kubernetes.KubernetesAspireDashboardResource"
      ]
    },
    {
      "name": "withKindNetwork",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.Kind/withKindNetwork",
      "qualifiedName": "withKindNetwork",
      "description": "Connects a container resource to the Kind container network, enabling it to communicate with the Kind cluster's API server and nodes.",
      "remarks": "Use this method when a container needs direct network connectivity to the Kind control plane.\nKind creates a separate container network (\"kind\") for its nodes. Aspire manages\nits own container network for containers it creates. Containers on different\nnetworks cannot communicate by default.\nAspire does not provide a built-in way to add containers to additional container networks,\nand `WithContainerRuntimeArgs(\"--network\", \"kind\")` is overridden internally.\nSee for the upstream feature request.\nThis method works around the limitation by subscribing to the container's stopped event.\nWhen the container stops (typically because it can't reach the Kind cluster), the hook\nconnects the container to the \"kind\" network via the configured container runtime and\nrestarts it.\nIf the container does not already have an explicit name (via `WithContainerName`),\nthis method assigns one using the pattern `{resource.Name}-{random}` to ensure\nthe container can be identified by the handler.",
      "returns": "A reference to the `IResourceBuilder`1`.",
      "kind": "Method",
      "signature": "withKindNetwork(): ContainerResource",
      "parameters": [],
      "returnType": "ContainerResource",
      "returnsBuilder": true,
      "targetTypeId": "Aspire.Hosting/Aspire.Hosting.ApplicationModel.ContainerResource",
      "expandedTargetTypes": [
        "Aspire.Hosting.ApplicationModel.ContainerResource",
        "Aspire.Hosting.Kubernetes.KubernetesAspireDashboardResource"
      ]
    },
