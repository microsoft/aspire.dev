  "enumTypes": [
    {
      "name": "ClusterLifetime",
      "fullName": "Aspire.Hosting.ClusterLifetime",
      "kind": "enum",
      "description": "Specifies the lifetime behavior of a Kind cluster relative to the AppHost session.",
      "members": [
        "Session",
        "Persistent"
      ],
      "memberDocs": [
        {
          "name": "Session",
          "description": "The cluster is deleted when the AppHost shuts down. This is the default behavior."
        },
        {
          "name": "Persistent",
          "description": "The cluster survives AppHost restarts and is reused on the next startup."
        }
      ]
    }
