      "id": "capability:CommunityToolkit.Aspire.Hosting.KurrentDB/withDataBindMount",
      "kind": "capability",
      "name": "withDataBindMount",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.KurrentDB/withDataBindMount",
      "qualifiedName": "withDataBindMount",
      "capabilityKind": "Method",
      "description": "Adds a bind mount for the data folder to a KurrentDB container resource.",
