    {
      "id": "capability:Aspire.Hosting.Azure.PostgreSQL/withPostgresMcp",
      "kind": "capability",
      "name": "withPostgresMcp",
      "capabilityId": "Aspire.Hosting.Azure.PostgreSQL/withPostgresMcp",
      "qualifiedName": "withPostgresMcp",
      "capabilityKind": "Method",
      "description": "Adds a Postgres MCP server container and configures it to connect to the database represented by `builder`.",
