      "id": "capability:CommunityToolkit.Aspire.Hosting.k6/withScript",
      "kind": "capability",
      "name": "withScript",
      "capabilityId": "CommunityToolkit.Aspire.Hosting.k6/withScript",
      "qualifiedName": "withScript",
      "capabilityKind": "Method",
      "description": "Runs a k6 JS script when starting the Grafana k6 container resource.",
      "remarks": "Add a Grafana k6 container to the application model and reference it in a .NET project. Additionally, in this\nexample a script runs when the container starts.\n```\nvar builder = DistributedApplication.CreateBuilder(args);\nvar api = builder.AddProject<Projects.Api>(\"api\");\nvar k6 = builder.AddK6(\"k6\")\n.WithBindMount(\"scripts\", \"/scripts\", true)\n.WithScript(\"/scripts/main.js\")\n.WithReference(api)\n.WaitFor(api);\nbuilder.Build().Run();\n```",
      "returns": "The `IResourceBuilder`1`.",
      "targetTypeId": "CommunityToolkit.Aspire.Hosting.k6/Aspire.Hosting.ApplicationModel.K6Resource",
      "expandedTargetTypes": [
        "CommunityToolkit.Aspire.Hosting.k6/Aspire.Hosting.ApplicationModel.K6Resource"
      ],
      "returnsBuilder": true,
      "parameters": [
        {
          "name": "scriptPath",
          "type": "string",
          "description": "The path to the JS script to run."
        },
        {
          "name": "virtualUsers",
          "type": "number",
          "isOptional": true,
          "defaultValue": "10",
          "description": "The number of virtual users for the test. Defaults to `10`."
        },
        {
          "name": "duration",
          "type": "string",
          "isOptional": true,
          "defaultValue": "30s",
          "description": "The duration of the test. Defaults to `30s`."
        }
      ],
