---
/**
 * Presentation only: the consuming controller owns query state and clear behavior.
 * Keep the accessible label stable; placeholders may offer contextual examples.
 */
import '../../styles/search-controls.css';

interface Props {
  id: string;
  label: string;
  placeholder?: string;
  clearId?: string;
  clearLabel?: string;
  describedBy?: string;
  size?: 'lg' | 'sm';
  inputClass?: string;
  clearClass?: string;
  /** Contextual layout hooks retained by consumers extracting existing controls. */
  containerClass?: string;
  labelClass?: string;
  wrapClass?: string;
  iconClass?: string;
  visibleLabel?: boolean;
}

const {
  id, label, placeholder, clearId, clearLabel = 'Clear search', describedBy,
  size = 'lg', inputClass, clearClass, visibleLabel = false,
  containerClass, labelClass, wrapClass, iconClass,
} = Astro.props;
---

<div class:list={['search-field', containerClass]} data-search-size={size}>
  <label class:list={[visibleLabel ? 'search-field-label' : 'search-sr-only', labelClass]} for={id}>{label}</label>
  <div class:list={['search-field-wrap', wrapClass]}>
    <svg class:list={['search-field-icon', iconClass]} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input id={id} type="search" class:list={['search-field-input', inputClass]} placeholder={placeholder} autocomplete="off" aria-describedby={describedBy} />
    <button type="button" id={clearId} class:list={['search-field-clear', clearClass]} aria-label={clearLabel} style="display: none;">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="m18 6-12 12M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>
