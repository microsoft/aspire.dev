---
/** Compact empty-state presentation; the consumer supplies localized copy and actions. */
import '../../styles/search-controls.css';

interface Props {
  id?: string;
  title: string;
  hint?: string;
  actionLabel?: string;
  actionId?: string;
  hidden?: boolean;
}

const { id, title, hint, actionLabel, actionId, hidden = false } = Astro.props;
---

<div id={id} class="search-empty" hidden={hidden}>
  <p class="search-empty-title">{title}</p>
  {hint && <p class="search-empty-hint">{hint}</p>}
  {actionLabel && <button id={actionId} class="search-action" type="button">{actionLabel}</button>}
</div>
