---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import YouTubeEmbed from '@components/YouTubeEmbed.astro';
import TwitchEmbed from '@components/TwitchEmbed.astro';

export interface Props {
  youtubeChannelId: string;
  twitchChannel: string;
}

const { youtubeChannelId, twitchChannel } = Astro.props;
---

<div id="aspire-live-tabs" data-active-source="none">
  <Tabs syncKey="stream-source">
    <TabItem label="YouTube" icon="youtube">
      <div class="live-embed-wrapper" data-source="youtube" data-live="false">
        <YouTubeEmbed channelId={youtubeChannelId} title="Aspire on YouTube" />
      </div>
      <p class="muted">
        When we&rsquo;re not live, this shows the channel placeholder. Browse all past streams on <a
          href="https://youtube.com/@aspiredotdev">youtube.com/@aspiredotdev</a
        >.
      </p>
    </TabItem>
    <TabItem label="Twitch" icon="twitch">
      <div class="live-embed-wrapper" data-source="twitch" data-live="false">
        <TwitchEmbed channel={twitchChannel} title="Aspire on Twitch" />
      </div>
      <p class="muted">
        When we&rsquo;re not live, the Twitch player shows the offline screen. Follow <a
          href={`https://twitch.tv/${twitchChannel}`}>twitch.tv/{twitchChannel}</a
        > to get notified.
      </p>
    </TabItem>
  </Tabs>
</div>

<script>
  import { subscribe, type LiveSnapshot } from '@components/live-status.ts';

  const PAGE_SELECTOR = '#aspire-live-tabs';
  let userSticky = false;
  let unsubscribe: (() => void) | undefined;
  let tabObserver: MutationObserver | undefined;
  let currentSnapshot: LiveSnapshot | undefined;

  function findTabRoot(): HTMLElement | null {
    return document.querySelector<HTMLElement>(PAGE_SELECTOR);
  }

  function activateTab(label: 'YouTube' | 'Twitch'): void {
    const root = findTabRoot();
    if (!root) return;
    const tabBtn = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]')).find(
      (b) => b.textContent?.trim() === label
    );
    if (tabBtn?.getAttribute('aria-selected') !== 'true') tabBtn?.click();
  }

  function refreshEmbed(wrapper: HTMLElement, source: 'youtube' | 'twitch', live: boolean): void {
    const iframe = wrapper.querySelector<HTMLIFrameElement>('iframe');
    if (!iframe) return;

    const url = new URL(iframe.src);
    if (source === 'youtube') {
      url.searchParams.set('autoplay', live ? '1' : '0');
      url.searchParams.set('mute', live ? '1' : '0');
    } else {
      url.searchParams.set('autoplay', live ? 'true' : 'false');
      url.searchParams.set('muted', live ? 'true' : 'false');
    }
    iframe.src = url.toString();
  }

  function setEmbedLive(
    source: 'youtube' | 'twitch',
    live: boolean,
    streamId: string | null
  ): void {
    const root = findTabRoot();
    if (!root) return;
    const wrapper = root.querySelector<HTMLElement>(`.live-embed-wrapper[data-source="${source}"]`);
    if (!wrapper) return;
    const autoplay = live && wrapper.closest<HTMLElement>('[role="tabpanel"]')?.hidden === false;
    const nextStreamId = live ? (streamId ?? '') : '';
    const playbackChanged = (wrapper.dataset.autoplay === 'true') !== autoplay;
    const streamChanged = (wrapper.dataset.streamId ?? '') !== nextStreamId;
    wrapper.dataset.live = live ? 'true' : 'false';
    wrapper.dataset.streamId = nextStreamId;
    wrapper.dataset.autoplay = autoplay ? 'true' : 'false';
    if (playbackChanged || (autoplay && streamChanged)) {
      refreshEmbed(wrapper, source, autoplay);
    }
  }

  function updateEmbeds(snap: LiveSnapshot): void {
    setEmbedLive('youtube', snap.youtube.live, snap.youtube.videoId);
    setEmbedLive('twitch', snap.twitch.live, snap.twitch.channel);
  }

  function applySnapshot(snap: LiveSnapshot): void {
    currentSnapshot = snap;
    const root = findTabRoot();
    if (root) root.dataset.activeSource = snap.primarySource ?? 'none';

    if (!userSticky) {
      if (snap.primarySource === 'twitch') activateTab('Twitch');
      else if (snap.primarySource === 'youtube') activateTab('YouTube');
    }
    updateEmbeds(snap);
  }

  function init(): void {
    const root = findTabRoot();
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';
    userSticky = false;
    root.querySelectorAll<HTMLElement>('[role="tab"]').forEach((tab) => {
      tab.addEventListener('click', (event) => {
        // Only a real user selecting a tab makes the choice sticky. activateTab()
        // switches tabs via a synthetic .click(), which is untrusted; ignore those
        // so auto-switching on primary-source changes keeps working. Playwright
        // user clicks are trusted, so this stays test-friendly.
        if (!event.isTrusted) return;
        userSticky = true;
      });
    });
    // Tab changes can come from clicks, keyboard controls, or restored preferences.
    tabObserver = new MutationObserver(() => {
      if (currentSnapshot) updateEmbeds(currentSnapshot);
    });
    tabObserver.observe(root, {
      attributes: true,
      attributeFilter: ['hidden'],
      subtree: true,
    });
    unsubscribe = subscribe(applySnapshot);
  }

  function cleanup(): void {
    unsubscribe?.();
    unsubscribe = undefined;
    tabObserver?.disconnect();
    tabObserver = undefined;
    currentSnapshot = undefined;
    userSticky = false;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  document.addEventListener('astro:after-swap', init);
  document.addEventListener('astro:before-swap', cleanup);
</script>

<style>
  #aspire-live-tabs .live-embed-wrapper {
    position: relative;
    border-radius: 0.75rem;
  }

  #aspire-live-tabs .muted {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    #aspire-live-tabs .live-embed-wrapper {
      transition: none;
    }
  }
</style>
