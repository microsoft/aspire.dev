---
import type { Props } from './ReadableText.astro';

const { text } = Astro.props;
const parts = text.split(
  /(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])|(?<=[a-zA-Z][./:])|(?<=[_-])|(?=[<(])|(?<=[>,)\]])/
);
---

{
  parts.map((part, index) => (
    <Fragment>
      {index > 0 && <wbr />}
      {part}
    </Fragment>
  ))
}
