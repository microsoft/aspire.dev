---
import { Icon } from '@astrojs/starlight/components';
---

<starlight-menu-button class="print:hidden" aria-expanded="false">
  <button
    type="button"
    aria-expanded="false"
    popovertarget="starlight__sidebar"
    aria-label={Astro.locals.t('menuButton.accessibleLabel')}
    class="sl-menu-button sl-flex md:sl-hidden"
  >
    <Icon name="bars" class="open-menu" />
    <Icon name="close" class="close-menu" />
  </button>
</starlight-menu-button>

<script>
  class MobileMenuButton extends HTMLElement {
    private listeners?: AbortController;

    connectedCallback() {
      this.listeners?.abort();
      this.listeners = new AbortController();
      const { signal } = this.listeners;
      const button = this.querySelector('button');
      const nav = this.closest('nav');
      const sidebar = nav?.querySelector<HTMLElement>('#starlight__sidebar');
      if (!button || !nav || !sidebar) return;
      const syncExpanded = () => {
        const expanded = sidebar.matches(':popover-open');
        this.setAttribute('aria-expanded', String(expanded));
        button.setAttribute('aria-expanded', String(expanded));
        document.body.toggleAttribute('data-mobile-menu-expanded', expanded);
      };
      sidebar.addEventListener('toggle', syncExpanded, { signal });
      nav.addEventListener(
        'click',
        (event) => {
          if (
            !event.defaultPrevented &&
            event.target instanceof Element &&
            event.target.closest('a[href], .mobile-site-links button')
          ) {
            sidebar.hidePopover();
          }
        },
        { signal }
      );
      document.addEventListener(
        'click',
        (event) => {
          if (event.target instanceof Element && event.target.closest('.live-source-menu')) return;
          if (
            sidebar.matches(':popover-open') &&
            event.target instanceof Node &&
            !nav.contains(event.target)
          )
            sidebar.hidePopover();
        },
        { signal }
      );
      document.addEventListener(
        'astro:before-swap',
        () => {
          if (sidebar.matches(':popover-open')) sidebar.hidePopover();
        },
        { signal }
      );
      window.addEventListener(
        'resize',
        () => {
          if (!button.checkVisibility() && sidebar.matches(':popover-open')) sidebar.hidePopover();
        },
        { signal }
      );
      syncExpanded();
    }

    disconnectedCallback() {
      this.listeners?.abort();
      document.body.removeAttribute('data-mobile-menu-expanded');
    }
  }
  if (!customElements.get('starlight-menu-button'))
    customElements.define('starlight-menu-button', MobileMenuButton);
</script>

<style>
  button {
    position: fixed;
    top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: var(--sl-z-index-navbar);
    width: var(--sl-menu-button-size);
    height: var(--sl-menu-button-size);
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    cursor: pointer;
  }
  button :global(svg) {
    width: var(--aspire-icon-size);
    height: var(--aspire-icon-size);
    --sl-icon-size: var(--aspire-icon-size) !important;
  }
  :global(starlight-menu-button:has(~ #starlight__sidebar:popover-open)) .open-menu,
  :global(starlight-menu-button:not(:has(~ #starlight__sidebar:popover-open))) .close-menu {
    display: none;
  }
  button:hover,
  :global(starlight-menu-button:has(~ #starlight__sidebar:popover-open)) button {
    background: var(--sl-color-gray-6);
  }
  button:focus-visible {
    outline: 2px solid var(--aspire-action-focus);
    outline-offset: 2px;
  }
  :global(body[data-mobile-menu-expanded]) {
    overflow: hidden;
  }
  @media (max-width: 49.999rem) {
    button {
      top: var(--sl-nav-pad-y);
    }
  }
</style>
