---
import { Tooltips } from 'astro-tooltips';
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import AccessibleCodeButtons from '../AccessibleCodeButtons.astro';
import SiteTour from '../SiteTour.astro';
import { getStructuredData } from '@utils/structured-data';
import { getOgMetadata } from '@utils/page-metadata';

const repoUrl = (
  import.meta.env.PUBLIC_REPO_URL ||
  import.meta.env.REPO_URL ||
  'https://github.com/microsoft/aspire.dev'
).replace(/\/$/, '');
const commit = import.meta.env.PUBLIC_GIT_COMMIT_ID || import.meta.env.GIT_COMMIT_ID || '';

const route = Astro.locals?.starlightRoute;
const entryId = route?.entry?.id;
const path = route?.entry?.filePath;
const isSiteTourEnabled = import.meta.env.PUBLIC_ENABLE_SITE_TOUR === 'true';
const structuredData = route ? getStructuredData(route, Astro.url, Astro.site) : undefined;
const ogMetadata = route ? getOgMetadata(route, Astro.url, Astro.site) : undefined;

function computeRepoPath() {
  if (path) {
    return `src/frontend/${path}`; // final path inside repository
  }

  return `unknown-${entryId}`;
}

function computeSourceUrl() {
  if (!repoUrl || !commit) return '';
  const path = computeRepoPath();
  return path ? `${repoUrl}/blob/${commit}/${path}` : '';
}
---

<meta name="git-commit-id" content={commit} />
<meta name="git-source-url" content={computeSourceUrl()} />

<DefaultHead {...Astro.props} />

{
  ogMetadata && (
    <>
      {/*
        Starlight's <DefaultHead> already emits per-page og:title,
        og:description, og:url, og:type, and og:locale from frontmatter — see
        node_modules/@astrojs/starlight/components/Head.astro. We only emit the
        tags Starlight doesn't already cover: a per-page og:image (rendered by
        the /og/<slug> endpoint), its MIME type/dimensions/alt, and the Twitter
        card equivalents (Twitter scrapers prefer name="twitter:*" over og:*).
      */}
      <meta property="og:image" content={ogMetadata.image} />
      <meta property="og:image:type" content={ogMetadata.imageType} />
      <meta property="og:image:alt" content={ogMetadata.imageAlt} />
      <meta property="og:image:width" content={String(ogMetadata.imageWidth)} />
      <meta property="og:image:height" content={String(ogMetadata.imageHeight)} />

      <meta name="twitter:title" content={ogMetadata.ogTitle} />
      <meta name="twitter:description" content={ogMetadata.description} />
      <meta name="twitter:url" content={ogMetadata.url} />
      <meta name="twitter:image" content={ogMetadata.image} />
      <meta name="twitter:image:alt" content={ogMetadata.imageAlt} />
    </>
  )
}

{structuredData && <script type="application/ld+json" is:inline set:html={structuredData} />}

<!-- Restore persisted sidebar state before paint and keep legacy AppHost pages readable -->
<script is:inline>
  (function () {
    var appHostLangLabels = {
      csharp: 'C#',
      typescript: 'TypeScript',
    };
    var appHostLangStorageKey = 'starlight-synced-tabs__aspire-lang';

    function normalizeAppHostLang(value) {
      var normalized = (value || '').toLowerCase().replace(/\s+/g, '');
      if (normalized.indexOf('typescript') !== -1) {
        return 'typescript';
      }
      if (
        normalized.indexOf('c#') !== -1 ||
        normalized.indexOf('csharp') !== -1 ||
        normalized.indexOf('c-sharp') !== -1
      ) {
        return 'csharp';
      }
      return '';
    }

    function updateAppHostLangUrl(value) {
      var normalized = normalizeAppHostLang(value);
      if (!normalized) return;

      var url = new URL(window.location);
      url.searchParams.set('aspire-lang', normalized);
      window.history.replaceState({}, '', url);
    }

    function persistAppHostLang(value) {
      var normalized = normalizeAppHostLang(value);
      if (!normalized) return '';

      document.documentElement.setAttribute('data-apphost-lang', normalized);
      try {
        localStorage.setItem('aspire-lang', normalized);
        localStorage.setItem(appHostLangStorageKey, appHostLangLabels[normalized]);
      } catch (e) {}
      return normalized;
    }

    function syncAppHostLangFromTab(value) {
      var normalized = persistAppHostLang(value);
      if (!normalized) return;
      updateAppHostLangUrl(normalized);
    }

    function initAppHostLangSync() {
      if (window.__aspireAppHostLangSyncInitialized) return;
      window.__aspireAppHostLangSyncInitialized = true;

      document.addEventListener('click', function (event) {
        var target = event.target;
        if (!(target instanceof Element)) return;

        var tab = target.closest('starlight-tabs[data-sync-key="aspire-lang"] [role="tab"]');
        if (tab) {
          var tabValue = normalizeAppHostLang(tab.textContent);
          if (tabValue) {
            window.requestAnimationFrame(function () {
              syncAppHostLangFromTab(tabValue);
            });
          }
        }
      });

      document.addEventListener('keydown', function (event) {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        var target = event.target;
        if (!(target instanceof Element)) return;
        var starlightTabs = target.closest('starlight-tabs[data-sync-key="aspire-lang"]');
        if (!starlightTabs) return;

        window.requestAnimationFrame(function () {
          var selectedTab = starlightTabs.querySelector('[role="tab"][aria-selected="true"]');
          var selectedValue = normalizeAppHostLang(selectedTab && selectedTab.textContent);
          if (selectedValue) {
            syncAppHostLangFromTab(selectedValue);
          }
        });
      });
    }

    var qsAppHostLang = persistAppHostLang(
      new URLSearchParams(window.location.search).get('aspire-lang')
    );
    var rawAppHostLang = qsAppHostLang || 'csharp';

    try {
      rawAppHostLang =
        qsAppHostLang ||
        localStorage.getItem('aspire-lang') ||
        localStorage.getItem('aspire-apphost-lang') ||
        localStorage.getItem(appHostLangStorageKey) ||
        localStorage.getItem('starlight-synced-tabs__apphost-lang') ||
        localStorage.getItem('starlight-synced-tabs__apphost-implementation-lang') ||
        'csharp';
    } catch (e) {}

    document.documentElement.setAttribute(
      'data-apphost-lang',
      normalizeAppHostLang(rawAppHostLang) || 'csharp'
    );

    try {
      var path = window.location.pathname.replace(/\/$/, '');
      if (
        localStorage.getItem('api-sidebar-collapsed') === '1' &&
        path.indexOf('/reference/api') !== -1
      ) {
        document.documentElement.setAttribute('data-sidebar-collapsed', '');
      }

      if (
        localStorage.getItem('topic-sidebar-collapsed') === '1' &&
        path.indexOf('/reference/api') === -1
      ) {
        document.documentElement.setAttribute('data-topic-sidebar-collapsed', '');
      }
    } catch (e) {}

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAppHostLangSync);
    } else {
      initAppHostLangSync();
    }
  })();
</script>

<!--
  WCP consent runtime. Per Microsoft WCP requirements this MUST be loaded live from
  the CDN and never bundled or self-hosted: the CDN applies geo-sensitive logic that
  decides whether the banner is shown and returns different payloads per region.
  `is:inline` stops Astro from processing/bundling it; `async` keeps a slow or blocked
  CDN from ever blocking page render.
-->
<script is:inline async src="https://wcpstatic.microsoft.com/mscc/lib/v2/wcp-consent.js"></script>
<script is:inline>
  (function () {
    if (window.__aspireWcpConsentInitialized) return;
    window.__aspireWcpConsentInitialized = true;

    // The four "Manage cookies" buttons are always server-rendered. Once WCP
    // tells us whether consent is required for this region, reflect it on <html>
    // so CSS can hide those buttons where there is nothing to manage (e.g. the
    // US). Persist the answer so a returning visitor doesn't see the button
    // flash in before WCP loads.
    function setConsentRequirementState(isRequired) {
      try {
        var el = document.documentElement;
        if (el) {
          if (isRequired) {
            el.removeAttribute('data-consent-not-required');
          } else {
            el.setAttribute('data-consent-not-required', '');
          }
        }
        window.localStorage.setItem('aspireConsentRequired', isRequired ? 'true' : 'false');
      } catch (e) {}
    }

    // Before WCP loads, hide the buttons only if a previous visit already
    // established that consent is not required here. Unknown => leave them
    // visible; defaulting to visible keeps us failsafe (we never hide a control
    // a required region needs just because WCP was slow or blocked).
    function primeConsentRequirementState() {
      try {
        if (
          window.localStorage.getItem('aspireConsentRequired') === 'false' &&
          document.documentElement
        ) {
          document.documentElement.setAttribute('data-consent-not-required', '');
        }
      } catch (e) {}
    }

    primeConsentRequirementState();

    // Failsafe: if the CDN script is blocked (ad-blocker, firewall, CSP) or slow to
    // arrive, poll for a bounded window and then give up so the page never hangs or
    // spins forever. Consent code must never degrade the rest of the site.
    var MAX_INIT_ATTEMPTS = 150; // ~15s at 100ms intervals
    var initAttempts = 0;

    function toCulture(value) {
      var raw = (value || '').trim().replace('_', '-');
      if (!raw) return 'en-US';
      var parts = raw.split('-');
      var lang = (parts[0] || 'en').toLowerCase();
      var region = parts[1] ? parts[1].toUpperCase() : '';
      return region ? lang + '-' + region : lang;
    }

    function withSiteConsent(callback) {
      var siteConsent = window.__aspireWcpSiteConsent;
      if (!siteConsent) return false;
      try {
        callback(siteConsent);
      } catch (e) {}
      return true;
    }

    function openManageConsent(event) {
      var target = event.target;
      if (!(target instanceof Element)) return;
      if (!target.closest('[data-cookie-manage-consent]')) return;
      event.preventDefault();
      withSiteConsent(function (siteConsent) {
        if (siteConsent.isConsentRequired) {
          siteConsent.manageConsent();
        }
      });
    }

    function onConsentChanged() {
      // WCP fires this when the visitor changes their choices. Reload so the new
      // consent is applied consistently across any consent-gated behavior.
      window.setTimeout(function () {
        window.location.reload();
      }, 0);
    }

    function ensureBannerPlaceholder() {
      var id = 'wcp-cookie-banner';
      var placeholder = document.getElementById(id);
      if (placeholder) return placeholder;
      if (!document.body) return null;
      placeholder = document.createElement('div');
      placeholder.id = id;
      // Dedicated placeholder pinned to the top of the viewport. WCP injects its
      // banner INTO this element in normal flow, so without a top-anchored host the
      // banner lands wherever the host sits. Using document.body dropped it at the
      // very bottom of the page (invisible on load) which fails the compliance scan.
      // A fixed, full-width, top strip guarantees the standard banner is visible on
      // load regardless of scroll position or the site's own sticky header.
      placeholder.style.position = 'fixed';
      placeholder.style.top = '0';
      placeholder.style.left = '0';
      placeholder.style.width = '100%';
      placeholder.style.zIndex = '2147483647';
      document.body.insertBefore(placeholder, document.body.firstChild);
      return placeholder;
    }

    // WCP paints the banner AND the preferences dialog from the theme passed at
    // init time. It does not re-read the theme on its own, so when the user
    // toggles the site theme after load we must tell WCP to repaint by dispatching
    // the documented `theme-changed` event. Our CSS overrides re-theme instantly
    // from custom properties; this keeps WCP's own internals (e.g. category
    // toggles) in sync too.
    function toWcpThemeName(themeName) {
      var wcp = window.WcpConsent;
      var isDark = (themeName || '').toLowerCase() === 'dark';
      if (wcp && wcp.themes) {
        return isDark ? wcp.themes.dark : wcp.themes.light;
      }
      return isDark ? 'dark' : 'light';
    }

    function notifyWcpThemeChanged() {
      try {
        var current = toWcpThemeName(document.documentElement.getAttribute('data-theme'));
        // Dispatch on both targets: the WCP listener attaches to one of them and
        // ignores the other, so this is robust to library changes.
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { currentTheme: current } }));
        document.dispatchEvent(new CustomEvent('theme-changed', { detail: { currentTheme: current } }));
      } catch (e) {}
    }

    function watchThemeChanges() {
      try {
        if (window.__aspireWcpThemeObserver || !document.documentElement) return;
        var observer = new MutationObserver(function (mutations) {
          for (var i = 0; i < mutations.length; i++) {
            if (mutations[i].attributeName === 'data-theme') {
              notifyWcpThemeChanged();
              break;
            }
          }
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
        window.__aspireWcpThemeObserver = observer;
      } catch (e) {}
    }

    function initWcpConsent() {
      var wcp = window.WcpConsent;
      if (!wcp || typeof wcp.init !== 'function') {
        if (++initAttempts >= MAX_INIT_ATTEMPTS) return; // give up; page stays fully functional
        window.setTimeout(initWcpConsent, 100);
        return;
      }

      try {
        var culture = toCulture(document.documentElement.lang || navigator.language || 'en-US');
        // Resolve the theme through toWcpThemeName so a missing or renamed
        // wcp.themes payload falls back to a string here instead of throwing
        // (which would be swallowed below and permanently stop initialization).
        var theme = toWcpThemeName(document.documentElement.getAttribute('data-theme'));

        wcp.init(
          culture,
          ensureBannerPlaceholder() || document.body,
          function (err, siteConsent) {
            if (err || !siteConsent) return;
            window.__aspireWcpSiteConsent = siteConsent;
            setConsentRequirementState(!!siteConsent.isConsentRequired);
            if (typeof siteConsent.onConsentChanged === 'function') {
              siteConsent.onConsentChanged(onConsentChanged);
            }
          },
          onConsentChanged,
          theme
        );
      } catch (e) {
        // Never let consent initialization break page rendering. Retry within
        // the bounded window in case WCP delivered a transient or partial payload.
        if (++initAttempts < MAX_INIT_ATTEMPTS) {
          window.setTimeout(initWcpConsent, 100);
        }
      }
    }

    document.addEventListener('click', openManageConsent);
    watchThemeChanges();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWcpConsent, { once: true });
    } else {
      initWcpConsent();
    }
  })();
</script>

<!-- WebMCP: register a single `search-aspire-docs` tool for in-page agents. -->
<script>
  import '@scripts/webmcp';
</script>

<Tooltips
  interactive={false}
  allowHTML={true}
  delay={[0, 0]}
  duration={[0, 0]}
  hideOnClick={true}
  animation="scale"
  onClickOutside={function (instance, event) {
    if (instance) {
      instance.hide();
    }
  }}
/>

<script is:inline>
  (function () {
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        const activeElement = document.activeElement;
        if (activeElement && activeElement._tippy) {
          activeElement._tippy.hide();
        }
      }
    });
  })();
</script>

<!--
  Workaround for expressive-code-twoslash@0.6.1 runtime bug where the popup is
  rendered as a child of .twoslash-hover but the shipped script looks for it
  as nextElementSibling and falls back to brittle indexOf pairing. The fallback
  breaks after the first mouseleave detaches popups, so tooltips stop showing.
  We replace each hover with a clone (stripping the plugin's listeners), park
  the popup in .expressive-code (to escape <pre> overflow clipping), and wire
  correct show/hide handlers.
-->
<script is:inline>
  (function () {
    if (window.__aspireTwoslashFixInitialized) return;
    window.__aspireTwoslashFixInitialized = true;

    function position(popup, hover, ec) {
      // Position absolutely inside .expressive-code (our positioning context).
      // This keeps popup inside the CSS-variable scope (so background/color/
      // z-index vars apply) while escaping the <pre overflow:auto> clip.
      var hoverRect = hover.getBoundingClientRect();
      var ecRect = ec.getBoundingClientRect();
      var popupRect = popup.getBoundingClientRect();
      var gap = 4;
      var top = hoverRect.bottom - ecRect.top + gap;
      var left = hoverRect.left - ecRect.left;
      // Clamp horizontally within .expressive-code bounds.
      var maxLeft = Math.max(0, ecRect.width - popupRect.width - 8);
      if (left > maxLeft) left = maxLeft;
      if (left < 0) left = 0;
      popup.style.position = 'absolute';
      popup.style.top = top + 'px';
      popup.style.left = left + 'px';
      popup.style.right = 'auto';
      popup.style.margin = '0';
    }

    function initHover(hover) {
      var popup = hover.querySelector(':scope > .twoslash-popup-container');
      if (!popup) return;
      var ec = hover.closest('.expressive-code');
      if (!ec) return;

      // Park popup as a direct child of .expressive-code so it escapes the
      // <pre overflow:auto> clip while keeping the plugin's CSS variables in
      // scope. Make .expressive-code a positioning context AND a stacking
      // context (via isolation:isolate) so the popup's z-index:999 stays
      // contained below the site nav (z-index:10) instead of bubbling up to
      // the root stacking context.
      ec.style.position = ec.style.position || 'relative';
      ec.style.isolation = 'isolate';
      if (popup.parentNode !== ec) ec.appendChild(popup);
      popup.style.display = 'none';
      popup.setAttribute('aria-hidden', 'true');
      popup.setAttribute('role', 'tooltip');

      var hideTimer;
      var hoveringPopup = false;

      function show() {
        clearTimeout(hideTimer);
        popup.style.display = 'block';
        popup.setAttribute('aria-hidden', 'false');
        position(popup, hover, ec);
      }
      function scheduleHide() {
        clearTimeout(hideTimer);
        hideTimer = setTimeout(function () {
          if (hoveringPopup || hover.matches(':hover')) return;
          popup.style.display = 'none';
          popup.setAttribute('aria-hidden', 'true');
        }, 100);
      }

      hover.addEventListener('mouseenter', show);
      hover.addEventListener('mouseleave', scheduleHide);
      hover.addEventListener('focus', show);
      hover.addEventListener('blur', scheduleHide);
      popup.addEventListener('mouseenter', function () {
        clearTimeout(hideTimer);
        hoveringPopup = true;
      });
      popup.addEventListener('mouseleave', function () {
        hoveringPopup = false;
        scheduleHide();
      });
    }

    function fixAll() {
      var hovers = document.querySelectorAll('.twoslash-hover');
      for (var i = 0; i < hovers.length; i++) {
        var hover = hovers[i];
        if (hover.dataset.tsFixed === '1') continue;
        var clone = hover.cloneNode(true);
        clone.dataset.tsFixed = '1';
        hover.parentNode.replaceChild(clone, hover);
        initHover(clone);
      }
    }

    function scheduleFix() {
      // Run after the plugin's own astro:page-load / initial pass.
      setTimeout(fixAll, 0);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scheduleFix);
    } else {
      scheduleFix();
    }
    document.addEventListener('astro:page-load', scheduleFix);
    document.addEventListener('astro:after-swap', function () {
      setTimeout(fixAll, 150);
    });
  })();
</script>

<AccessibleCodeButtons />
{isSiteTourEnabled && <SiteTour />}
