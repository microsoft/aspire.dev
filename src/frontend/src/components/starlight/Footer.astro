---
import { Image } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import AspireMap from '@components/AspireMap.astro';
import FooterLegal from '@components/FooterLegal.astro';
import FooterPreferences from '@components/FooterPreferences.astro';
import FooterResources from '@components/FooterResources.astro';
import FooterSocials from '@components/FooterSocials.astro';
import aspireLogo from '@assets/aspire-logo-256.svg';

import { isHomepage } from '@utils/helpers';

const showMap = isHomepage(Astro);
const footerPromise = Astro.locals.t('landing.statementPlayer.quotes.03.text' as any);
const commit = (import.meta.env.PUBLIC_GIT_COMMIT_ID || import.meta.env.GIT_COMMIT_ID || '').slice(
  0,
  7
);
---

<div class="footer-wrapper">
  <div class="footer-container">
    {
      !showMap && (
        <DefaultFooter>
          <slot />
        </DefaultFooter>
      )
    }

    <div class:list={['site-footer-content', { 'is-homepage': showMap, 'is-docs': !showMap }]}>
      <div class="footer-main">
        <div class="footer-identity">
          <a class="footer-wordmark" href="/" aria-label="Aspire">
            <Image src={aspireLogo} alt="" width="48" height="48" />
            <strong>Aspire</strong>
          </a>
          <p class="footer-promise">{footerPromise}</p>
        </div>

        <div class="footer-directory">
          <FooterResources />
          <FooterLegal />
        </div>
      </div>

      <div class="footer-utility">
        <FooterSocials />
        <FooterPreferences />
      </div>

      <div class="footer-bottom">
        <span class="copyright"
          >© Microsoft <script is:inline>
            document.currentScript.parentElement.textContent = `© Microsoft ${new Date().getFullYear()}`;
          </script></span
        >

        {
          showMap && (
            <details class="footer-map-disclosure" dir={Astro.locals.t.dir()}>
              <summary>
                <span>{Astro.locals.t('footer.madeWithLove' as any)}</span>
                <Icon name="right-arrow" size="0.85rem" />
              </summary>
              <div class="footer-map-content">
                <AspireMap />
              </div>
            </details>
          )
        }

        {
          commit && (
            <a
              class="commit-link"
              href={`${import.meta.env.PUBLIC_REPO_URL}/commit/${import.meta.env.PUBLIC_GIT_COMMIT_ID || ''}`}
              target="_blank"
              title={`Built on commit SHA: ${commit}`}
              rel="noopener noreferrer"
            >
              SHA {commit}
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  .footer-wrapper {
    padding: 0;
    container: footer-shell / inline-size;
  }

  .footer-container {
    padding: 2rem 0 1.5rem;
  }

  .footer-container > :global(footer) {
    margin: 0;
  }

  .site-footer-content.is-docs {
    margin-top: 2rem;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(17rem, 0.8fr) minmax(26rem, 1.2fr);
    align-items: start;
    gap: clamp(3rem, 6vw, 5rem);
    padding: 2rem 0;
    border-top: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 72%, transparent);
  }

  .footer-identity {
    min-width: 0;
  }

  .footer-wordmark {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .footer-wordmark img {
    width: 2.5rem;
    height: 2.5rem;
  }

  .footer-wordmark strong {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .footer-wordmark:hover strong {
    color: var(--sl-color-text-accent);
  }

  .footer-promise {
    max-width: 36ch;
    margin: 1rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .footer-directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .footer-directory :global(.footer-column) {
    gap: 0.75rem;
  }

  .footer-directory :global(.footer-heading) {
    margin: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .footer-directory :global(.footer-links) {
    gap: 0.5rem;
  }

  .footer-directory :global(.footer-links a) {
    width: fit-content;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.45;
  }

  .footer-directory :global(.footer-links a:hover) {
    color: var(--sl-color-white);
  }

  .footer-utility {
    display: grid;
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
    align-items: start;
    gap: clamp(3rem, 6vw, 5rem);
    padding: 1.5rem 0;
    border-top: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 72%, transparent);
  }

  .footer-bottom {
    min-height: 3.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 72%, transparent);
  }

  .footer-map-disclosure {
    flex: none;
  }

  .footer-map-disclosure summary {
    width: fit-content;
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    border: 0;
    color: var(--sl-color-gray-3);
    background: transparent;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .footer-map-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .footer-map-disclosure summary:hover,
  .footer-map-disclosure summary:focus-visible {
    color: var(--sl-color-white);
  }

  .footer-map-disclosure summary :global(svg) {
    flex: none;
  }

  .footer-map-disclosure[open] {
    order: -1;
    flex: 1 0 100%;
    margin-bottom: 0.5rem;
  }

  .footer-map-disclosure[open] summary {
    margin-bottom: 0.75rem;
  }

  .footer-map-disclosure[open] summary :global(svg) {
    transform: rotate(90deg);
  }

  .footer-map-content :global(.map) {
    border-color: color-mix(in srgb, var(--sl-color-gray-4) 62%, transparent);
    border-radius: 0.65rem;
    box-shadow: none;
  }

  .copyright,
  .commit-link {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .commit-link {
    margin-inline-start: auto;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    text-decoration: none;
  }

  .commit-link:hover {
    color: var(--sl-color-white);
  }

  .footer-wordmark:focus-visible,
  .commit-link:focus-visible,
  .footer-map-disclosure summary:focus-visible,
  .footer-directory :global(.footer-links a:focus-visible) {
    border-radius: 0.2rem;
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 0.2rem;
  }

  .footer-wrapper :global(a.external-link::after) {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer-wordmark strong,
    .footer-map-disclosure summary,
    .footer-map-disclosure summary :global(svg),
    .footer-directory :global(.footer-links a),
    .commit-link {
      transition:
        color 180ms ease,
        transform 180ms ease;
    }
  }

  @container footer-shell (max-width: 52rem) {
    .footer-main,
    .footer-utility {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-main {
      padding-block: 2.25rem;
    }

    /* Stack the bottom row into a single left-aligned column so the
       copyright, "Made with love" disclosure, and commit SHA line up
       cleanly instead of scattering across the row (and keeps the SHA
       clear of the floating scroll-to-top button on tablet). */
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }

    .commit-link {
      margin-inline-start: 0;
    }

    .footer-map-disclosure[open] {
      order: 0;
      flex: none;
      align-self: stretch;
      margin-bottom: 0;
    }
  }

  @container footer-shell (max-width: 40rem) {
    .footer-container {
      padding-top: 1.5rem;
    }

    .footer-directory {
      gap: 2rem;
    }

    .footer-utility {
      padding-block: 1.25rem;
    }
  }

  @container footer-shell (max-width: 22rem) {
    .footer-directory {
      gap: 1.25rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const base = window.location.hostname.replace(/^www\./, '');
    const treatSubdomainsAsInternal = true;

    const sameSite = (host) => {
      const h = host.replace(/^www\./, '');
      if (treatSubdomainsAsInternal) {
        return h === base || h.endsWith('.' + base);
      }
      return h === base;
    };

    const applyExternalLinkAttrs = () => {
      document.querySelectorAll('a[href]').forEach((a) => {
        try {
          const url = new URL(a.getAttribute('href'), window.location.origin);
          if (!/^https?:$/.test(url.protocol)) return;

          if (!sameSite(url.hostname)) {
            a.setAttribute('target', '_blank');
            a.setAttribute('rel', 'noopener noreferrer');
            a.classList.add('external-link');

            const label = a.getAttribute('aria-label');
            const translatedLabel = Astro.locals.t('footer.opensInNewTab');
            const escapeRegex = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const translatedLabelPattern = new RegExp(`\\(${escapeRegex(translatedLabel)}\\)`, 'i');

            if (!label || !translatedLabelPattern.test(label)) {
              a.setAttribute('aria-label', (label ? label + ' ' : '') + `(${translatedLabel})`);
            }
          }
        } catch {
          /* Ignore malformed URLs. */
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyExternalLinkAttrs, { once: true });
    } else {
      applyExternalLinkAttrs();
    }
  })();
</script>

<script is:inline>
  (() => {
    const DURATION = 340;
    const SCROLL_DURATION = DURATION + 80;
    const EASING = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
    const REVEAL_GAP = 24;

    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Animates the footer's "Made with love" map <details> open/closed using the
    // Web Animations API, and nudges the scroll position so the map reveals into
    // view on open and doesn't leave the viewport stranded on close.
    class MapDisclosure {
      constructor(el) {
        this.el = el;
        this.summary = el.querySelector('summary');
        this.content = el.querySelector('.footer-map-content');
        this.animation = null;
        this.scrollFrame = null;
        this.isClosing = false;
        this.isExpanding = false;
        this.summary.addEventListener('click', (event) => this.onClick(event));
      }

      onClick(event) {
        event.preventDefault();
        this.cancelScroll();

        if (prefersReducedMotion()) {
          this.el.open = !this.el.open;
          if (this.el.open) {
            this.content.scrollIntoView({ block: 'nearest' });
          }
          return;
        }

        this.el.style.overflow = 'hidden';
        if (this.isClosing || !this.el.open) {
          this.open();
        } else if (this.isExpanding || this.el.open) {
          this.shrink();
        }
      }

      open() {
        this.el.style.height = `${this.el.offsetHeight}px`;
        this.el.open = true;
        window.requestAnimationFrame(() => this.expand());
      }

      expand() {
        this.isExpanding = true;
        const startHeight = this.el.offsetHeight;
        this.el.style.height = 'auto';
        const endHeight = this.el.offsetHeight;
        this.el.style.height = `${startHeight}px`;
        // Force a reflow so the browser commits the start height before animating.
        void this.el.offsetHeight;

        const top = this.el.getBoundingClientRect().top;
        const overflowBelow = top + endHeight - window.innerHeight + REVEAL_GAP;
        if (overflowBelow > 0) {
          this.smoothScrollTo(window.scrollY + overflowBelow, SCROLL_DURATION);
        }
        this.animate(startHeight, endHeight, true);
      }

      shrink() {
        this.isClosing = true;
        const startHeight = this.el.offsetHeight;
        const endHeight = this.summary.offsetHeight;

        const maxScrollAfter =
          document.documentElement.scrollHeight -
          (startHeight - endHeight) -
          window.innerHeight;
        const overshoot = window.scrollY - Math.max(0, maxScrollAfter);
        if (overshoot > 0) {
          this.smoothScrollTo(window.scrollY - overshoot, SCROLL_DURATION);
        }
        this.animate(startHeight, endHeight, false);
      }

      animate(from, to, open) {
        if (this.animation) this.animation.cancel();
        this.animation = this.el.animate(
          { height: [`${from}px`, `${to}px`] },
          { duration: DURATION, easing: EASING }
        );
        this.animation.onfinish = () => this.onFinish(open);
        this.animation.oncancel = () => {
          this.isExpanding = false;
          this.isClosing = false;
        };
      }

      onFinish(open) {
        this.el.open = open;
        this.animation = null;
        this.isExpanding = false;
        this.isClosing = false;
        this.el.style.height = '';
        this.el.style.overflow = '';
      }

      cancelScroll() {
        if (this.scrollFrame) {
          window.cancelAnimationFrame(this.scrollFrame);
          this.scrollFrame = null;
        }
      }

      // Drive the scroll with rAF, re-clamping to the live scrollable range on
      // every frame. The document height is changing underneath us as the map
      // animates open/closed, so a native smooth scroll would lock onto a stale,
      // clamped target and stall halfway; this keeps pace with the live range.
      smoothScrollTo(targetY, duration) {
        this.cancelScroll();
        const startY = window.scrollY;
        const distance = targetY - startY;
        if (distance === 0) return;
        const startTime = performance.now();
        const step = (now) => {
          const t = Math.min(1, (now - startTime) / duration);
          const eased = 1 - Math.pow(1 - t, 3);
          const maxY = document.documentElement.scrollHeight - window.innerHeight;
          const y = Math.max(0, Math.min(startY + distance * eased, maxY));
          window.scrollTo(0, y);
          this.scrollFrame = t < 1 ? window.requestAnimationFrame(step) : null;
        };
        this.scrollFrame = window.requestAnimationFrame(step);
      }
    }

    const init = () => {
      const el = document.querySelector('.footer-map-disclosure');
      if (!el || el.dataset.animatedDisclosure === 'true') return;
      el.dataset.animatedDisclosure = 'true';
      new MapDisclosure(el);
    };

    init();
    if (!window.__footerMapDisclosureBound) {
      window.__footerMapDisclosureBound = true;
      document.addEventListener('astro:page-load', init);
    }
  })();
</script>
