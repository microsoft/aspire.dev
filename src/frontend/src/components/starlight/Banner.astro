---
import { createHash } from 'node:crypto';
import { Icon } from '@astrojs/starlight/components';

const routeData = Astro.locals.starlightRoute.entry.data as {
  banner?: { content?: string };
  bannerExpiresOn?: Date;
  bannerAutoDismissAfterDays?: number;
};

const bannerContent = routeData.banner?.content;
const displayContent = bannerContent?.replace(
  /(<\/strong>)\s*[\u2013\u2014]\s*(?=<a\b)/g,
  '$1 '
);

// Absolute sunset date, if configured. When it's already past at build time we
// skip rendering the banner entirely; the client check below covers the gap
// between the sunset moment and the next rebuild.
const expiresOnMs =
  routeData.bannerExpiresOn instanceof Date && !Number.isNaN(routeData.bannerExpiresOn.getTime())
    ? routeData.bannerExpiresOn.getTime()
    : null;
const expiredAtBuild = expiresOnMs !== null && Date.now() >= expiresOnMs;

const autoDismissAfterDays =
  typeof routeData.bannerAutoDismissAfterDays === 'number' &&
  routeData.bannerAutoDismissAfterDays > 0
    ? routeData.bannerAutoDismissAfterDays
    : null;

const bannerHash =
  bannerContent && !expiredAtBuild
    ? createHash('sha256').update(bannerContent).digest('hex').slice(0, 12)
    : undefined;
const bannerId = bannerHash ? `sl-banner-${bannerHash}` : undefined;
const dismissKey = bannerHash
  ? `aspire.dev.banner.dismissed.${bannerHash}`
  : undefined;
const firstSeenKey = bannerHash
  ? `aspire.dev.banner.firstSeen.${bannerHash}`
  : undefined;
---

{
  bannerContent && bannerId && dismissKey && firstSeenKey && (
    <>
      <div
        id={bannerId}
        class="sl-banner sl-banner--dismissable"
        data-aspire-banner
        data-dismiss-key={dismissKey}
        data-first-seen-key={firstSeenKey}
        data-expires-on={expiresOnMs ?? ''}
        data-auto-dismiss-days={autoDismissAfterDays ?? ''}
        data-banner-state="open"
        data-pagefind-ignore
      >
        <div class="sl-banner__content" set:html={displayContent} />
        <button
          type="button"
          class="sl-banner__dismiss"
          data-dismiss-banner
          aria-label="Dismiss announcement banner"
          aria-controls={bannerId}
        >
          <Icon name="close" size="0.875rem" aria-hidden="true" />
          <span class="sl-banner__dismiss-label">Dismiss announcement banner</span>
        </button>
      </div>

      {
        /*
         * Rendered visible so the first paint already includes the banner's height. Revealing it
         * from the bundled controller below shifted the whole page down after first paint (the
         * largest layout shift on the landing page). Hiding is the exception, so this runs before
         * the next paint and only hides banners the reader has dismissed, that have passed their
         * sunset, or whose auto-dismiss window has elapsed. It mirrors `resolveBannerVisibility`
         * in `@utils/banner-expiry`; `banner-render.vitest.test.ts` asserts the two agree.
         * `data-astro-rerun` re-applies it to the incoming page on client-side navigation.
         */
      }
      <script is:inline data-astro-rerun data-banner-prepaint>
        (function () {
          var banner = document.querySelector('[data-aspire-banner]');
          if (!banner) return;
          var data = banner.dataset;
          var now = Date.now();
          var hide = data.expiresOn ? now >= Number(data.expiresOn) : false;
          try {
            if (!hide) hide = window.localStorage.getItem(data.dismissKey) === 'true';
            if (!hide && data.autoDismissDays) {
              var raw = window.localStorage.getItem(data.firstSeenKey);
              var firstSeen = raw !== null && /^\d+$/.test(raw.trim()) ? Number(raw) : 0;
              hide =
                firstSeen > 0 &&
                firstSeen <= now &&
                now >= firstSeen + Number(data.autoDismissDays) * 86400000;
            }
          } catch (e) {}
          if (hide) {
            banner.hidden = true;
            banner.dataset.bannerState = 'closed';
          }
        })();
      </script>
    </>
  )
}

<script>
  // Client controller for the announcement banner. The visibility *decision*
  // lives entirely in the imported helper (the same code the unit tests cover),
  // so shipped behavior can't diverge from the tests. This bundled module reads
  // its per-banner config from `data-*` attributes on the element (a bundled
  // script can't use `define:vars`), leaving only DOM/localStorage plumbing here.
  // The pre-paint script above applies the same decision before first paint.
  import { parseFirstSeen, resolveBannerVisibility } from '@utils/banner-expiry';

  const initializeBanner = () => {
    const banner = document.querySelector('[data-aspire-banner]');
    if (!(banner instanceof HTMLElement)) return;

    const { dismissKey, firstSeenKey } = banner.dataset;
    if (!dismissKey || !firstSeenKey) return;

    const expiresOnRaw = banner.dataset.expiresOn;
    const expiresOnMs = expiresOnRaw ? Number(expiresOnRaw) : null;
    const autoDismissRaw = banner.dataset.autoDismissDays;
    const autoDismissAfterDays = autoDismissRaw ? Number(autoDismissRaw) : null;

    let collapseTimeoutId = null;

    const clearPendingCollapse = () => {
      if (collapseTimeoutId !== null) {
        window.clearTimeout(collapseTimeoutId);
        collapseTimeoutId = null;
      }
    };

    const showBanner = () => {
      clearPendingCollapse();
      banner.hidden = false;
      banner.dataset.bannerState = 'open';
    };

    const setCollapsed = (animate) => {
      clearPendingCollapse();

      if (!animate) {
        banner.dataset.bannerState = 'closed';
        banner.hidden = true;
        return;
      }

      banner.dataset.bannerState = 'closing';

      const finishCollapse = () => {
        banner.hidden = true;
        banner.dataset.bannerState = 'closed';
        banner.removeEventListener('transitionend', handleTransitionEnd);
        clearPendingCollapse();
      };

      const handleTransitionEnd = (event) => {
        if (event.target !== banner) return;
        finishCollapse();
      };

      banner.addEventListener('transitionend', handleTransitionEnd);
      collapseTimeoutId = window.setTimeout(finishCollapse, 320);
    };

    let dismissed = false;

    try {
      dismissed = window.localStorage.getItem(dismissKey) === 'true';
    } catch {
      dismissed = false;
    }

    let firstSeenMs = null;

    try {
      firstSeenMs = parseFirstSeen(window.localStorage.getItem(firstSeenKey), Date.now());
    } catch {
      firstSeenMs = null;
    }

    const { visible, persistFirstSeenMs } = resolveBannerVisibility({
      nowMs: Date.now(),
      expiresOnMs: Number.isFinite(expiresOnMs) ? expiresOnMs : null,
      autoDismissAfterDays: Number.isFinite(autoDismissAfterDays) ? autoDismissAfterDays : null,
      firstSeenMs,
      dismissed,
    });

    if (typeof persistFirstSeenMs === 'number') {
      try {
        window.localStorage.setItem(firstSeenKey, String(persistFirstSeenMs));
      } catch {
        // Ignore storage failures (private mode, quota, etc.).
      }
    }

    if (visible) {
      showBanner();
    } else {
      setCollapsed(false);
    }

    if (banner.dataset.dismissInitialized === 'true') return;

    const dismissButton = banner.querySelector('[data-dismiss-banner]');
    if (!(dismissButton instanceof HTMLButtonElement)) return;

    dismissButton.addEventListener('click', () => {
      if (document.activeElement === dismissButton) {
        const main = document.querySelector('main');

        if (main instanceof HTMLElement) {
          main.setAttribute('tabindex', '-1');
          main.focus();
          main.addEventListener(
            'blur',
            () => {
              main.removeAttribute('tabindex');
            },
            { once: true }
          );
        }
      }

      setCollapsed(true);

      try {
        window.localStorage.setItem(dismissKey, 'true');
      } catch {
        // Ignore storage failures (private mode, quota, etc.).
      }
    });

    banner.dataset.dismissInitialized = 'true';
  };

  initializeBanner();
  document.addEventListener('astro:page-load', initializeBanner);
</script>

<style>
  @layer starlight.core {
    .sl-banner {
      --__sl-banner-accent: #2c256b;
      --__sl-banner-border: rgba(44, 37, 107, 0.2);
      --__sl-banner-text: #201e31;
      position: relative;
      padding: 0.5rem var(--sl-nav-pad-x);
      border-block: 1px solid var(--__sl-banner-border);
      background: var(--aspire-color-light, #dcd5f6);
      color: var(--__sl-banner-text);
      line-height: 1.4;
      text-align: center;
      text-wrap: balance;
      box-shadow: 0 0.5rem 1.5rem -1.35rem rgba(44, 37, 107, 0.28);
    }

    :global([data-theme='light']) .sl-banner {
      --__sl-banner-accent: #ffffff;
      --__sl-banner-border: rgba(255, 255, 255, 0.26);
      --__sl-banner-text: #ffffff;
      background: var(--aspire-color, #7455dd);
    }

    .sl-banner--dismissable {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.75rem;
      overflow: clip;
      padding: 0.625rem var(--sl-nav-pad-x);
      max-block-size: 32rem;
    }

    .sl-banner[hidden] {
      display: none;
    }

    .sl-banner--dismissable[data-banner-state='closing'] {
      max-block-size: 0;
      padding-block: 0;
      opacity: 0;
      transform: translateY(-0.4rem);
      box-shadow: none;
      transition:
        max-block-size 0.32s cubic-bezier(0.22, 1, 0.36, 1),
        padding-block 0.32s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.22s ease,
        transform 0.22s ease,
        box-shadow 0.22s ease;
    }

    .sl-banner__content,
    .sl-banner__content :global(p) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.125rem 0.75rem;
      min-width: 0;
      font-size: var(--aspire-text-control);
      line-height: 1.5;
    }

    .sl-banner__content :global(p) {
      margin: 0;
    }

    .sl-banner__content :global(strong) {
      color: var(--__sl-banner-text);
      font-weight: 600;
    }

    .sl-banner__content :global(a) {
      display: inline;
      max-inline-size: 100%;
      color: var(--__sl-banner-accent);
      font-weight: 400;
      text-decoration: underline;
      text-underline-offset: 0.2em;
      overflow-wrap: break-word;
    }

    .sl-banner__content :global(a):hover {
      color: var(--__sl-banner-accent);
      text-decoration-thickness: 2px;
      filter: none;
    }

    .sl-banner__content :global(a):focus-visible {
      outline: 2px solid var(--__sl-banner-accent);
      outline-offset: 2px;
    }

    .sl-banner__dismiss {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      inline-size: var(--aspire-touch-target);
      block-size: var(--aspire-touch-target);
      border: 0;
      border-radius: 0.375rem;
      padding: 0;
      background-color: transparent;
      color: var(--__sl-banner-accent);
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .sl-banner__dismiss:hover,
    .sl-banner__dismiss:focus-visible {
      background-color: color-mix(in srgb, var(--__sl-banner-accent) 12%, transparent);
    }

    .sl-banner__dismiss:focus-visible {
      outline: 2px solid var(--__sl-banner-accent);
      outline-offset: 3px;
    }

    .sl-banner__dismiss :global(svg) {
      opacity: 0.8;
      transition: opacity 0.2s ease;
    }

    .sl-banner__dismiss-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .sl-banner__dismiss:hover :global(svg),
    .sl-banner__dismiss:focus-visible :global(svg) {
      opacity: 1;
    }

    @media (max-width: 49.999rem) {
      .sl-banner__content,
      .sl-banner__content :global(p) {
        justify-content: start;
        text-align: start;
        text-wrap: pretty;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .sl-banner--dismissable,
      .sl-banner__content :global(a),
      .sl-banner__dismiss,
      .sl-banner__dismiss :global(svg) {
        transition: none;
      }
    }
  }
</style>