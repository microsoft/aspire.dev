---
import { getAppHostLanguageProjectHref, type AppHostLanguageId } from '@utils/apphost-languages';

interface Props {
  id: AppHostLanguageId;
}

const { id } = Astro.props;
const href = getAppHostLanguageProjectHref(id);
---

{
  href ? (
    <a {href}>
      <slot />
    </a>
  ) : (
    <slot />
  )
}
