---
import YourChoiceSvg from '@assets/icons/your-choices.svg';

const t = Astro.locals.t as unknown as (key: string) => string;
---

<nav class="footer-column" aria-labelledby="footer-legal-heading">
  <p id="footer-legal-heading" class="footer-heading">
    {t('footer.legal') || 'Legal'}
  </p>
  <ul class="footer-links">
    <li>
      <a
        href="https://aka.ms/yourcaliforniaprivacychoices"
        target="_blank"
        rel="noopener noreferrer"
        class="privacy-choice"
      >
        <YourChoiceSvg />
        {t('footer.privacyChoices')}
      </a>
    </li>
    <li>
      <a
        href="https://go.microsoft.com/fwlink/?LinkId=521839"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('footer.privacyAndCookies')}
      </a>
    </li>
    <li class="cookie-consent-btn">
      <button
        id="c-uhff-footer_managecookies"
        type="button"
        class="cookie-consent-btn"
        data-cookie-manage-consent
        data-tour-target="cookie-preferences"
        data-tour-step="cookie-preferences"
        aria-haspopup="dialog"
      >
        {t('footer.manageCookies')}
      </button>
    </li>
    <li>
      <a
        href="https://go.microsoft.com/fwlink/?LinkID=206977"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('footer.terms')}
      </a>
    </li>
    <li>
      <a
        href="https://go.microsoft.com/fwlink/?linkid=2196228"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('footer.trademarks')}
      </a>
    </li>
    <li>
      <a href="/support/" rel="noopener noreferrer">
        {t('footer.support')}
      </a>
    </li>
  </ul>
</nav>

<style>
  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-heading {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 0.25rem 0;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-links a,
  .footer-links button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }

  .footer-links button {
    width: fit-content;
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: var(--sl-text-xs);
    line-height: 1.45;
    text-align: start;
    cursor: pointer;
    min-height: 1.5rem;
  }

  .footer-links a:hover,
  .footer-links button:hover {
    color: var(--sl-color-white);
  }

  .footer-links button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 0.15rem;
    border-radius: 0.15rem;
  }

  .privacy-choice {
    gap: 0.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer-links a,
    .footer-links button {
      transition: color 150ms ease;
    }
  }
</style>
