---
import FluidGrid from '@components/FluidGrid.astro';
import { brandFontWeights } from '@data/brand';
---

<div class="brand-typography not-content">
  <FluidGrid as="ul" minColumnWidth="20rem" gap="1.25rem">
    {
      brandFontWeights.map(({ name, weight }) => (
        <li class="type-specimen">
          <h3>
            {name} <span>{weight}</span>
          </h3>
          <p class="sample" style={{ fontWeight: weight }}>
            Aspire
          </p>
          <p class="alphabet" style={{ fontWeight: weight }}>
            ABCDEFGHIJKLMNOPQRSTUVWXYZ
            <br />
            abcdefghijklmnopqrstuvwxyz
            <br />
            0123456789
          </p>
        </li>
      ))
    }
  </FluidGrid>
</div>

<style>
  .brand-typography {
    margin-block: 1.5rem;
    container-type: inline-size;
  }

  .brand-typography :global(.fluid-grid) {
    grid-template-columns: minmax(0, 1fr);
  }

  @container (min-width: 42rem) {
    .brand-typography :global(.fluid-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .type-specimen {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1.5rem;
    background: var(--aspire-color-dark-surface);
    min-width: 0;
    font-family: var(--aspire-font-sans);
  }

  :global([data-theme='light']) .type-specimen {
    background: var(--aspire-color-surface-subtle);
  }

  h3 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 0;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    line-height: 1.35;
  }

  h3 span {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 400;
    font-family: var(--aspire-font-mono);
  }

  .sample {
    font-size: 2.75rem;
    line-height: 1.25;
    margin: 1.25rem 0 1rem;
  }

  .alphabet {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    overflow-wrap: anywhere;
    margin: 0;
    line-height: 1.8;
  }
</style>
