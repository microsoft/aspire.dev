---
import { CardGrid } from '@astrojs/starlight/components';
---

<nav class="brand-navigation not-content" aria-label="Brand kit sections">
  <CardGrid>
    <slot />
  </CardGrid>
</nav>

<style>
  .brand-navigation {
    margin-block: 1.5rem;
  }

  .brand-navigation :global(.sl-link-card) {
    padding: 1.25rem;
    gap: 1rem;
    box-shadow: none;
    background: var(--aspire-color-dark-surface);
  }

  :global([data-theme='light']) .brand-navigation :global(.sl-link-card) {
    background: var(--aspire-color-surface-subtle);
  }

  .brand-navigation :global(.sl-link-card .stack) {
    gap: 0.625rem;
  }

  .brand-navigation :global(.sl-link-card .title) {
    font-weight: 600;
    white-space: normal;
    overflow: visible;
  }

  .brand-navigation :global(.sl-link-card .title .icon) {
    font-size: 1.125rem;
    color: var(--aspire-color-secondary);
  }

  :global([data-theme='light']) .brand-navigation :global(.sl-link-card .title .icon) {
    color: var(--aspire-color-purple);
  }

  .brand-navigation :global(.sl-link-card a) {
    position: static;
    overflow: visible;
  }

  .brand-navigation :global(.sl-link-card:hover),
  .brand-navigation :global(.sl-link-card:focus-within) {
    border-color: var(--sl-color-text-accent);
  }
</style>
