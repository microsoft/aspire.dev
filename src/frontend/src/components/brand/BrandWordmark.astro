---
import type { BrandAsset } from '@data/brand';

interface Props {
  asset: BrandAsset;
}

const { asset } = Astro.props;
---

<div class="brand-wordmark not-content" data-brand-wordmark={asset.file}>
  <img
    src={`/brand/${asset.file}`}
    width={asset.width}
    height={asset.height}
    alt=""
    loading="lazy"
    decoding="async"
    data-zoom-off
  />
</div>

<style>
  .brand-wordmark {
    width: 100%;
    max-width: 11rem;
    height: 100%;
    min-height: 0;
    display: grid;
    place-items: center;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
