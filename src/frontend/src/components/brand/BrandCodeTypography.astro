---
import { Code } from '@astrojs/starlight/components';

const sample = `const service = { name: "api", port: 8080 };
const ready = service.port === 8080;
const endpoint = \`http://localhost:\${service.port}\`;`;
---

<div class="code-typography not-content">
  <p class="family-name">Fira Code Variable</p>
  <Code code={sample} lang="javascript" title="Code typeface specimen" />
</div>

<style>
  .code-typography {
    margin-block: 1.25rem;
  }

  .family-name {
    margin: 0 0 1rem;
    font-family: var(--aspire-font-mono);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    line-height: 1.4;
  }
</style>
