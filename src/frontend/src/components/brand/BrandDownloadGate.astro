---
import BrandLicenseModal from '@components/brand/BrandLicenseModal.astro';
import { brandLicenseUrl } from '@data/brand';
---

<brand-download-gate>
  <dialog
    aria-labelledby="brand-download-title"
    aria-describedby="brand-download-description"
    class="not-content"
  >
    <form>
      <h2 id="brand-download-title">Review the brand guidelines</h2>
      <p id="brand-download-description">
        Before downloading <strong data-asset-name></strong>, review the{' '}
        <a href={brandLicenseUrl} data-brand-license>artwork license</a>
        {' '}and{' '}
        <a href="/community/brand/usage/" target="_blank" rel="noopener noreferrer"
          >usage guidelines</a
        >.
      </p>
      <p>
        The artwork is released under CC0 1.0. Microsoft retains trademark rights in the Aspire name
        and logo. Use the assets without implying endorsement, sponsorship, or affiliation.
      </p>
      <label>
        <input type="checkbox" required />
        <span>I agree to the licensing terms and Aspire brand usage guidelines.</span>
      </label>
      <p>When local storage is available, this browser remembers your agreement for future brand downloads.</p>
      <div class="actions">
        <button type="button" data-cancel>Cancel</button>
        <button type="submit" class="continue" disabled>Continue to download</button>
      </div>
    </form>
  </dialog>
  <noscript>
    <p>Enable JavaScript to review the licensing agreement before downloading brand assets.</p>
  </noscript>
  <BrandLicenseModal />
</brand-download-gate>

<script>
  import { getStoredPreference, setStoredPreference } from '@utils/browser-storage';

  const agreementKey = 'aspire:brand-guidelines-accepted';

  class BrandDownloadGate extends HTMLElement {
    private listeners?: AbortController;

    connectedCallback() {
      const dialog = this.querySelector('dialog');
      const form = this.querySelector('form');
      const agreement = this.querySelector('input');
      const continueButton = this.querySelector<HTMLButtonElement>('[type="submit"]');
      const cancelButton = this.querySelector<HTMLButtonElement>('[data-cancel]');
      const assetName = this.querySelector<HTMLElement>('[data-asset-name]');
      if (!dialog || !form || !agreement || !continueButton || !cancelButton || !assetName) {
        throw new Error('The brand download agreement is missing required controls.');
      }

      this.listeners?.abort();
      this.listeners = new AbortController();
      const { signal } = this.listeners;
      let opener: HTMLButtonElement | undefined;
      const downloadButtons = document.querySelectorAll<HTMLButtonElement>('[data-brand-download]');

      const updateDownloadButtons = () => {
        const accepted = getStoredPreference(agreementKey) === 'true';
        downloadButtons.forEach((button) => {
          button.disabled = false;
          if (accepted) {
            button.removeAttribute('aria-haspopup');
          } else {
            button.setAttribute('aria-haspopup', 'dialog');
          }
        });
        return accepted;
      };
      updateDownloadButtons();
      window.addEventListener(
        'storage',
        (event) => {
          if (event.key === agreementKey || event.key === null) updateDownloadButtons();
        },
        { signal }
      );

      const download = (button: HTMLButtonElement) => {
        const link = document.createElement('a');
        link.href = button.value;
        if (button.dataset.brandDownload === 'svg') {
          link.download = '';
        } else {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
        document.body.append(link);
        link.click();
        link.remove();
      };

      downloadButtons.forEach((button) => {
        button.addEventListener(
          'click',
          () => {
            if (updateDownloadButtons()) {
              download(button);
              return;
            }
            opener = button;
            const name = button.dataset.assetName;
            if (!name) {
              throw new Error('The selected brand download has no asset name.');
            }
            assetName.textContent = name;
            form.reset();
            continueButton.disabled = true;
            dialog.showModal();
          },
          { signal }
        );
      });

      agreement.addEventListener(
        'change',
        () => {
          continueButton.disabled = !agreement.checked;
        },
        { signal }
      );
      cancelButton.addEventListener('click', () => dialog.close(), { signal });
      dialog.addEventListener(
        'close',
        () => {
          form.reset();
          continueButton.disabled = true;
          opener?.focus();
          opener = undefined;
        },
        { signal }
      );
      form.addEventListener(
        'submit',
        (event) => {
          event.preventDefault();
          if (!agreement.checked) {
            agreement.reportValidity();
            return;
          }
          if (!opener) {
            throw new Error('No brand asset was selected for download.');
          }
          setStoredPreference(agreementKey, 'true');
          updateDownloadButtons();
          download(opener);
          dialog.close();
        },
        { signal }
      );
    }

    disconnectedCallback() {
      this.listeners?.abort();
      this.listeners = undefined;
    }
  }

  if (!customElements.get('brand-download-gate')) {
    customElements.define('brand-download-gate', BrandDownloadGate);
  }
</script>

<style>
  dialog {
    width: min(32rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    overflow: auto;
  }

  dialog::backdrop {
    background: rgb(31 30 51 / 60%);
  }

  form {
    display: grid;
    gap: 1rem;
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-size: var(--sl-text-xl);
    line-height: 1.3;
  }

  a {
    color: var(--sl-color-text-accent);
  }

  label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
  }

  input {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2rem;
    accent-color: var(--aspire-action-primary);
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  button {
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }

  button.continue {
    background: var(--aspire-action-primary);
    color: var(--aspire-action-primary-text);
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }
</style>
