---
import { Icon } from '@astrojs/starlight/components';

const dos = [
  'Call the product Aspire in brand, editorial, and marketing copy.',
  'Use aspire.dev for official documentation and product explanations.',
  'Use the supplied SVG files without redrawing, outlining, or reshaping the mark, except as permitted for the provided developer-icon variants below.',
  'Leave space around the logo and use a high-contrast background.',
  'Write clear, helpful, direct, approachable copy.',
  'Use the core purple palette for primary elements and accents or gradients for highlights.',
];
const donts = [
  'Do not call the product ".NET Aspire" in consumer-facing brand or marketing content.',
  'Do not stretch, rotate, or crowd the logo with partner marks, badges, or dense UI. Recoloring is permitted only under the narrow developer-icon usage permission below.',
  'Do not use gradients or supporting accents as the main palette for an interface.',
  'Do not rely on internal shorthand when a simple reader-facing explanation would be clearer.',
];
const panels = [
  { title: 'Do', id: 'do', items: dos, icon: 'approve-check' as const, tone: 'positive' },
  { title: 'Do not', id: 'do-not', items: donts, icon: 'close' as const, tone: 'negative' },
];
---

<div class="guidance-grid not-content">
  <div class="panels">
    {
      panels.map((panel) => (
        <section class:list={['guidance-card', panel.tone]} aria-labelledby={panel.id}>
          <h3 id={panel.id}>{panel.title}</h3>
          <ul>
            {panel.items.map((item) => (
              <li>
                <Icon name={panel.icon} size="1.125rem" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<style>
  .guidance-grid {
    container-type: inline-size;
    margin-block: 1.5rem;
  }

  .panels {
    display: grid;
    gap: 1.25rem;
  }

  .guidance-card {
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--aspire-color-dark-surface);
  }

  :global([data-theme='light']) .guidance-card {
    background: var(--aspire-color-surface-subtle);
  }

  h3 {
    margin: 0 0 1rem;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    line-height: 1.35;
  }

  ul {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    align-items: start;
    gap: 0.625rem;
    font-size: var(--sl-text-sm);
    font-weight: 400;
    line-height: 1.6;
  }

  li :global(svg) {
    margin-top: 0.2rem;
  }

  .positive h3,
  .positive :global(svg) {
    color: var(--sl-color-green-high);
  }

  .negative h3,
  .negative :global(svg) {
    color: var(--sl-color-red-high);
  }

  @container (min-width: 40rem) {
    .panels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
