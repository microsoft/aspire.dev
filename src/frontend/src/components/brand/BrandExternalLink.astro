---
import { Icon } from '@astrojs/starlight/components';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" class="resource-link not-content">
  <slot />
  <Icon name="external" size="0.85em" />
  <span class="sr-only"> (opens in a new tab)</span>
</a>

<style>
  .resource-link :global(p) {
    display: inline;
    margin: 0;
  }

  .resource-link :global(svg) {
    display: inline-block;
    margin: 0;
    margin-inline-start: 0.25em;
    vertical-align: -0.1em;
    color: currentColor;
  }

  .resource-link.external-link::after {
    content: none;
    display: none;
  }
</style>
