---
import { Code, Icon } from '@astrojs/starlight/components';
import {
  appHostLanguageConfig,
  getEnabledAppHostLanguages,
  type AppHostLanguage,
  type AppHostLanguageId,
} from '@utils/apphost-languages';

interface Props {
  headingLevel?: 'h2' | 'h3';
  heading?: string;
  description?: string | null;
}

interface VariantSelection {
  key: string;
  frontend: boolean;
  database: boolean;
  api: boolean;
  container: boolean;
  deployment: boolean;
}

interface LanguageVariant {
  code?: string;
  limitation?: string;
}

const {
  headingLevel = 'h3',
  heading = Astro.locals.t('appHostBuilder.heading', { appHost: 'AppHost' }),
  description = Astro.locals.t('appHostBuilder.description'),
} = Astro.props as Props;
const Heading = headingLevel;
const enabledLanguages = getEnabledAppHostLanguages();

function getVariantKey(selection: Omit<VariantSelection, 'key'>): string {
  const { frontend, database, api, container, deployment } = selection;
  if (!frontend && !database && !api && !container) return 'empty';

  let key = database
    ? api
      ? frontend
        ? 'databaseApiFrontend'
        : 'databaseApi'
      : frontend
        ? 'databaseFrontend'
        : 'database'
    : api
      ? frontend
        ? 'apiFrontend'
        : 'api'
      : frontend
        ? 'frontend'
        : 'container';

  if (container && key !== 'container') key += 'Container';
  if (deployment) key += 'Deployment';
  return key;
}

const variantSelections: VariantSelection[] = [
  {
    key: 'empty',
    frontend: false,
    database: false,
    api: false,
    container: false,
    deployment: false,
  },
];

for (let mask = 1; mask < 16; mask += 1) {
  const resources = {
    frontend: Boolean(mask & 1),
    database: Boolean(mask & 2),
    api: Boolean(mask & 4),
    container: Boolean(mask & 8),
  };
  variantSelections.push({
    key: getVariantKey({ ...resources, deployment: false }),
    ...resources,
    deployment: false,
  });
  variantSelections.push({
    key: getVariantKey({ ...resources, deployment: true }),
    ...resources,
    deployment: true,
  });
}

function joinSections(sections: string[]): string {
  return sections.filter(Boolean).join('\n\n');
}

function emptyComment(prefix: string): string {
  return `${prefix} Toggle the options above to add resources to this AppHost.`;
}

function renderCsharp(selection: VariantSelection): string {
  const sections = ['var builder = DistributedApplication.CreateBuilder(args);'];
  if (selection.key === 'empty') sections.push(emptyComment('//'));

  if (selection.database) {
    sections.push(
      selection.deployment
        ? `// Add a deployable database
var postgres = builder.AddAzurePostgresFlexibleServer("db")
    .AddDatabase("appdata")
    .WithDataVolume()
    .RunAsContainer();`
        : `// Add database
var postgres = builder.AddPostgres("db")
    .AddDatabase("appdata");`
    );
  }
  if (selection.api) {
    const calls = ['var api = builder.AddProject("api", "../api/ApiService.csproj")'];
    if (selection.database) calls.push('    .WithReference(postgres)');
    if (selection.database && selection.deployment) calls.push('    .WaitFor(postgres)');
    if (selection.deployment) calls.push('    .PublishAsAzureContainerApp()');
    sections.push(`// Add API service${selection.database ? ' and reference the database' : ''}
${calls.join('\n')};`);
  }
  if (selection.frontend) {
    const calls = [
      'var frontend = builder.AddViteApp("frontend", "../frontend")',
      '    .WithHttpEndpoint(env: "PORT")',
    ];
    if (selection.api) calls.push('    .WithReference(api)');
    if (selection.deployment) calls.push('    .PublishAsDockerFile()');
    sections.push(`// Add frontend service${selection.api ? ' and reference the API' : ''}
${calls.join('\n')};`);
  }
  if (selection.container) {
    const calls = [
      'var customContainer = builder.AddContainer("mycustomcontainer", "myregistry/myapp", "latest")',
      '    .WithHttpEndpoint(targetPort: 8080)',
    ];
    if (selection.deployment) calls.push('    .PublishAsKubernetes()');
    sections.push(`// Add custom container
${calls.join('\n')};`);
  }

  sections.push('builder.Build().Run();');
  return joinSections(sections);
}

function renderTypescript(selection: VariantSelection): string {
  const sections = [
    `import { createBuilder } from './.aspire/modules/aspire.mjs';`,
    'const builder = await createBuilder();',
  ];
  if (selection.key === 'empty') sections.push(emptyComment('//'));

  if (selection.database) {
    sections.push(
      selection.deployment
        ? `// Add a deployable database
const postgres = await builder
    .addAzurePostgresFlexibleServer("db")
    .addDatabase("appdata")
    .withDataVolume()
    .runAsContainer();`
        : `// Add database
const postgres = await builder
    .addPostgres("db")
    .addDatabase("appdata");`
    );
  }
  if (selection.api) {
    const calls = [
      'const api = await builder',
      '    .addNodeApp("api", "./api", "src/index.ts")',
      '    .withHttpEndpoint({ env: "PORT" })',
    ];
    if (selection.database) calls.push('    .withReference(postgres)');
    if (selection.database && selection.deployment) calls.push('    .waitFor(postgres)');
    if (selection.deployment) calls.push('    .publishAsAzureContainerApp()');
    sections.push(`// Add API service${selection.database ? ' and reference the database' : ''}
${calls.join('\n')};`);
  }
  if (selection.frontend) {
    const calls = [
      'const frontend = await builder',
      '    .addViteApp("frontend", "./frontend")',
      '    .withHttpEndpoint({ env: "PORT" })',
    ];
    if (selection.api) calls.push('    .withReference(api)');
    if (selection.deployment) calls.push('    .publishAsDockerFile()');
    sections.push(`// Add frontend service${selection.api ? ' and reference the API' : ''}
${calls.join('\n')};`);
  }
  if (selection.container) {
    const calls = [
      'const customContainer = await builder',
      '    .addContainer("mycustomcontainer", "myregistry/myapp", "latest")',
      '    .withHttpEndpoint({ targetPort: 8080 })',
    ];
    if (selection.deployment) calls.push('    .publishAsKubernetes()');
    sections.push(`// Add custom container
${calls.join('\n')};`);
  }

  sections.push('await builder.build().run();');
  return joinSections(sections);
}

function getGeneratedLimitation(
  language: AppHostLanguage,
  selection: VariantSelection
): string | undefined {
  if (selection.database) {
    return `The generated ${language.label} AppHost SDK does not include the PostgreSQL integration used by this combination yet.`;
  }
  if (selection.deployment && selection.container) {
    return `The generated ${language.label} AppHost SDK does not include the Kubernetes publishing API used by this combination yet.`;
  }
  if (language.id === 'rust' && selection.frontend && selection.api) {
    return 'The generated Rust AppHost SDK cannot currently express the executable arguments and resource reference required by this combination.';
  }
  if (language.id === 'rust' && selection.frontend) {
    return 'The generated Rust AppHost SDK cannot currently pass the String[] arguments required to start the frontend executable.';
  }
  return undefined;
}

function renderPython(selection: VariantSelection): string {
  const body: string[] = [];
  if (selection.key === 'empty') body.push(`    ${emptyComment('#')}`);
  if (selection.api) {
    body.push(
      `    api = builder.add_project("api", "../api/ApiService.csproj")${
        selection.deployment ? '.publish_as_docker_file()' : ''
      }`
    );
  }
  if (selection.frontend) {
    const calls = [
      '        builder.add_executable("frontend", "npm", "./frontend", ["run", "dev"])',
      '        .with_http_endpoint(env="PORT")',
    ];
    if (selection.api) calls.push('        .with_reference(api)');
    if (selection.deployment) {
      calls.push('        .publish_as_docker_file(configure=lambda container: None)');
    }
    body.push(`    frontend = (
${calls.join('\n')}
    )`);
  }
  if (selection.container) {
    body.push(`    custom_container = (
        builder.add_container("mycustomcontainer", "myregistry/myapp:latest")
        .with_http_endpoint(target_port=8080)
    )`);
  }
  body.push('    builder.run()');

  return `from aspire_app import create_builder

with create_builder() as builder:
${body.join('\n\n')}`;
}

function renderGo(selection: VariantSelection): string {
  const body: string[] = [];
  if (selection.key === 'empty') body.push(`\t${emptyComment('//')}`);
  if (selection.api) {
    body.push(`\tapi := builder.AddProject("api", "../api/ApiService.csproj")${
      selection.deployment ? '.PublishAsDockerFile()' : ''
    }
\tif err := api.Err(); err != nil {
\t\tlog.Fatal(aspire.FormatError(err))
\t}`);
  }
  if (selection.frontend) {
    const calls = [
      '\tfrontend := builder.',
      '\t\tAddExecutable("frontend", "npm", "./frontend", []string{"run", "dev"}).',
      '\t\tWithHttpEndpoint(&aspire.WithHttpEndpointOptions{Env: aspire.StringPtr("PORT")})',
    ];
    if (selection.api) {
      calls[calls.length - 1] += '.';
      calls.push('\t\tWithReference(api)');
    }
    if (selection.deployment) {
      calls[calls.length - 1] += '.';
      calls.push('\t\tPublishAsDockerFile(func(aspire.ContainerResource) {})');
    }
    body.push(`${calls.join('\n')}
\tif err := frontend.Err(); err != nil {
\t\tlog.Fatal(aspire.FormatError(err))
\t}`);
  }
  if (selection.container) {
    body.push(`\tcustomContainer := builder.
\t\tAddContainer("mycustomcontainer", "myregistry/myapp:latest").
\t\tWithHttpEndpoint(&aspire.WithHttpEndpointOptions{TargetPort: aspire.IntPtr(8080)})
\tif err := customContainer.Err(); err != nil {
\t\tlog.Fatal(aspire.FormatError(err))
\t}`);
  }

  body.push(`\tapp, err := builder.Build()
\tif err != nil {
\t\tlog.Fatal(aspire.FormatError(err))
\t}
\tif err := app.Run(); err != nil {
\t\tlog.Fatal(aspire.FormatError(err))
\t}`);

  return `package main

import (
\t"log"

\t"apphost/modules/aspire"
)

func main() {
\tbuilder, err := aspire.CreateBuilder()
\tif err != nil {
\t\tlog.Fatal(aspire.FormatError(err))
\t}

${body.join('\n\n')}
}`;
}

function renderJava(selection: VariantSelection): string {
  const body: string[] = [];
  if (selection.key === 'empty') body.push(`    ${emptyComment('//')}`);
  if (selection.api) {
    body.push(
      `    var api = builder.addProject("api", "../api/ApiService.csproj")${
        selection.deployment ? '.publishAsDockerFile()' : ''
      };`
    );
  }
  if (selection.frontend) {
    const calls = [
      '    var frontend = builder.addExecutable(',
      '        "frontend",',
      '        "npm",',
      '        "./frontend",',
      '        new String[] { "run", "dev" });',
      '    frontend.withHttpEndpoint(new WithHttpEndpointOptions().env("PORT"));',
    ];
    if (selection.api) calls.push('    frontend.withReference(api);');
    if (selection.deployment) calls.push('    frontend.publishAsDockerFile(container -> {});');
    body.push(calls.join('\n'));
  }
  if (selection.container) {
    body.push(`    var customContainer = builder.addContainer(
        "mycustomcontainer",
        "myregistry/myapp:latest");
    customContainer.withHttpEndpoint(
        new WithHttpEndpointOptions().targetPort(8080));`);
  }
  body.push('    builder.build().run();');

  return `import aspire.*;

void main(String[] args) throws Exception {
    var builder = DistributedApplication.CreateBuilder(args);

${body.join('\n\n')}
}`;
}

function renderRust(selection: VariantSelection): string {
  const body: string[] = [];
  if (selection.key === 'empty') body.push(`    ${emptyComment('//')}`);
  if (selection.api) {
    body.push(
      `    let api = builder.add_project("api", "../api/ApiService.csproj", None)?;
${selection.deployment ? '    api.publish_as_docker_file(|_| Value::Null)?;' : ''}`.trimEnd()
    );
  }
  if (selection.container) {
    body.push(`    let custom_container = builder.add_container(
        "mycustomcontainer",
        Value::String("myregistry/myapp:latest".to_string()),
    )?;
    custom_container.with_http_endpoint(None, Some(8080.0), None, None, None)?;`);
  }
  body.push(`    let app = builder.build()?;
    app.run(None)?;
    Ok(())`);

  return `#[path = ".aspire/modules/mod.rs"]
mod aspire;

use aspire::*;
use serde_json::Value;

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let builder = create_builder(None)?;

${body.join('\n\n')}
}`;
}

const renderers: Record<AppHostLanguageId, (selection: VariantSelection) => string> = {
  typescript: renderTypescript,
  csharp: renderCsharp,
  python: renderPython,
  go: renderGo,
  java: renderJava,
  rust: renderRust,
};

const languageVariants = Object.fromEntries(
  appHostLanguageConfig.languages.map((language) => [
    language.id,
    Object.fromEntries(
      variantSelections.map((selection) => {
        const limitation =
          language.generatedApi && language.id !== 'typescript'
            ? getGeneratedLimitation(language, selection)
            : undefined;
        return [
          selection.key,
          limitation ? { limitation } : { code: renderers[language.id](selection) },
        ];
      })
    ),
  ])
) as Record<AppHostLanguageId, Record<string, LanguageVariant>>;

for (const language of appHostLanguageConfig.languages) {
  for (const selection of variantSelections) {
    const variant = languageVariants[language.id][selection.key];
    if (!variant?.code && !variant?.limitation) {
      throw new Error(
        `AppHostBuilder requires code or a limitation for ${language.id}/${selection.key}.`
      );
    }
  }
}
---

<div
  class="container"
  data-apphost-builder
  data-editor-motion-enabled="true"
  data-default-language={appHostLanguageConfig.defaultLanguage}
>
  <div class="header" dir={Astro.locals.t.dir()}>
    <Heading>{heading}</Heading>
    {description && <p>{description}</p>}

    <div class="lang-toggles" role="radiogroup" aria-label="AppHost language">
      {
        enabledLanguages.map((language) => {
          const selected = language.id === appHostLanguageConfig.defaultLanguage;
          return (
            <button
              type="button"
              class:list={['lang-toggle', { active: selected }]}
              data-lang={language.id}
              data-language-label={language.label}
              aria-pressed={String(selected)}
              role="radio"
              aria-checked={String(selected)}
              tabindex={selected ? 0 : -1}
            >
              <span>{language.label}</span>
              {language.experimental && <span class="language-experimental">Experimental</span>}
            </button>
          );
        })
      }
    </div>

    <div class="toggles">
      <button
        class="toggle active"
        data-toggle="frontend"
        data-tooltip-placement="top"
        title={Astro.locals.t('appHostBuilder.frontendTooltip')}
        aria-pressed="true"
      >
        <Icon name="laptop" size="1.2rem" />
        <span>Front end</span>
      </button>

      <button
        class="toggle"
        data-toggle="database"
        data-tooltip-placement="top"
        title={Astro.locals.t('appHostBuilder.databaseTooltip')}
        aria-pressed="false"
      >
        <Icon name="seti:db" size="1.2rem" />
        <span>{Astro.locals.t('appHostBuilder.database')}</span>
      </button>

      <button
        class="toggle"
        data-toggle="api"
        data-tooltip-placement="top"
        title={Astro.locals.t('appHostBuilder.apiTooltip')}
        aria-pressed="false"
      >
        <Icon name="seti:json" size="1.2rem" />
        <span>{Astro.locals.t('appHostBuilder.api')}</span>
      </button>

      <button
        class="toggle"
        data-toggle="container"
        data-tooltip-placement="top"
        title={Astro.locals.t('appHostBuilder.containerTooltip')}
        aria-pressed="false"
      >
        <Icon name="seti:docker" size="1.2rem" />
        <span>{Astro.locals.t('appHostBuilder.container')}</span>
      </button>

      <button
        class="toggle"
        data-toggle="deployment"
        data-tooltip-placement="top"
        title={Astro.locals.t('appHostBuilder.deploymentTooltip')}
        aria-pressed="false"
      >
        <Icon name="rocket" size="1.2rem" />
        <span>{Astro.locals.t('appHostBuilder.deploy')}</span>
      </button>
    </div>
  </div>

  <div class="code-display not-content" data-apphost-code-display data-disable-copy>
    <div class="code-stage" data-code-stage hidden>
      <span class="editor-caret" data-editor-caret aria-hidden="true"></span>
    </div>
    <p class="sr-only" data-code-status aria-live="polite" aria-atomic="true">
      {
        `${appHostLanguageConfig.languages.find((language) => language.id === appHostLanguageConfig.defaultLanguage)?.label} AppHost code showing Front end.`
      }
    </p>
    {
      enabledLanguages.map((language) => (
        <div class="code-lang-group" data-code-lang={language.id} style="display: none;">
          {variantSelections.map(({ key }) => {
            const variant = languageVariants[language.id][key];
            return (
              <div
                class="code-variant"
                data-variant={key}
                data-variant-kind={variant.limitation ? 'limitation' : 'code'}
                style="display: none;"
              >
                {variant.code ? (
                  <Code
                    code={variant.code}
                    lang={language.codeFence}
                    title={language.appHostFile}
                  />
                ) : (
                  <div class="apphost-code-limitation" data-code-limitation role="note">
                    <strong>{language.label} AppHost limitation</strong>
                    <p>{variant.limitation}</p>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      ))
    }

    <label class="editor-motion-option">
      <input type="checkbox" checked data-editor-motion-toggle />
      <span>Typing animation</span>
    </label>
  </div>
</div>

<style>
  .container {
    margin: 2rem 0;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .header {
    padding: 1.5rem;
    background: var(--sl-color-bg-nav);
    text-align: center;
    border-bottom: 1px solid var(--sl-color-gray-5);
    border-top-left-radius: 0.75rem;
    border-top-right-radius: 0.75rem;
  }

  .header :is(h2, h3) {
    margin: 0 0 0.5rem 0;
    color: var(--sl-color-text);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .lang-toggles {
    display: inline-flex;
    align-items: center;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.5rem;
    padding: 0.2rem;
    gap: 0.2rem;
    margin-bottom: 1rem;
  }

  .lang-toggle {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 1rem;
    border: none;
    background: transparent;
    color: var(--sl-color-text);
    border-radius: 0.375rem;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: 0;
  }

  .language-experimental {
    padding: 0.18rem 0.35rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-orange) 55%, transparent);
    border-radius: 999px;
    color: var(--sl-color-orange-high);
    background: color-mix(in srgb, var(--sl-color-orange-low) 70%, transparent);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lang-toggle:hover {
    background: var(--sl-color-gray-5);
  }

  .lang-toggle.active {
    background: var(--aspire-action-selected, var(--sl-color-accent-low));
    color: var(--aspire-action-selected-text, var(--sl-color-accent-high));
    box-shadow: inset 0 0 0 1px var(--aspire-action-selected-border, var(--sl-color-accent));
  }

  .lang-toggle.active:hover {
    background: var(--aspire-action-selected-hover, var(--sl-color-accent-low));
  }

  .header p {
    margin: 0 0 1.5rem 0;
    font-size: 0.9rem;
  }

  .toggles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
  }

  .editor-motion-option {
    width: fit-content;
    min-height: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 1.25rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
  }

  .editor-motion-option input {
    width: 0.9rem;
    height: 0.9rem;
    margin: 0;
    accent-color: var(--aspire-action-focus, var(--sl-color-accent));
  }

  .editor-motion-option input:focus-visible {
    outline: 0.1875rem solid var(--aspire-action-focus, var(--sl-color-accent));
    outline-offset: 0.18rem;
  }

  .toggle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 0.5rem;
    margin: 0;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--sl-color-text);
    min-height: 4rem;
    box-sizing: border-box;
  }

  .toggle:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-bg-nav);
  }

  .toggle.active {
    background: var(--aspire-action-selected, var(--sl-color-accent-low));
    border-color: var(--aspire-action-selected-border, var(--sl-color-accent));
    color: var(--aspire-action-selected-text, var(--sl-color-accent-high));
  }

  .toggle.active:hover {
    background: var(--aspire-action-selected-hover, var(--sl-color-accent-low));
    border-color: var(--aspire-action-selected-border, var(--sl-color-accent));
  }

  :is(.lang-toggle, .toggle):focus-visible {
    outline: 0.1875rem solid var(--aspire-action-focus, var(--sl-color-accent));
    outline-offset: 0.125rem;
  }

  .code-display {
    padding: 1.5rem;
    margin-top: 0;
    border-top: 1px solid var(--sl-color-border);
  }

  .code-variant {
    margin-top: 0;
  }

  .code-stage {
    position: relative;
    isolation: isolate;
  }

  .apphost-code-limitation {
    min-height: 18rem;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: clamp(2rem, 7vw, 5rem);
    border: 1px solid var(--sl-color-orange);
    border-radius: 0.5rem;
    color: var(--sl-color-text);
    background: color-mix(in srgb, var(--sl-color-orange-low) 48%, var(--sl-color-bg));
    text-align: center;
  }

  .apphost-code-limitation strong {
    color: var(--sl-color-orange-high);
    font-size: 1rem;
  }

  .apphost-code-limitation p {
    max-width: 42rem;
    margin: 0;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }

  .editor-caret {
    position: absolute;
    top: 0;
    left: 0;
