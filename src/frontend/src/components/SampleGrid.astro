---
import SampleCard from '@components/SampleCard.astro';
import CatalogSearchActiveFilters from '@components/CatalogSearchActiveFilters.astro';
import '../styles/search-controls.css';
import { tagLabel } from '@utils/sample-tags';
import {
  isThemeAwareSampleImage,
  sampleDetailHref,
  stripSampleImageUrlSuffix,
  type ResolvedSampleThumbnail,
  type Sample,
  type SampleThumbnail,
} from '@utils/samples';

interface Props {
  samples: Sample[];
}

const { samples } = Astro.props;
const messages = {
  clearSearch: Astro.locals.t('catalogSearch.clearSearch'),
  clearFilters: Astro.locals.t('catalogSearch.clearFilters'),
  resetAll: Astro.locals.t('catalogSearch.resetAll'),
  count: Astro.locals.t('catalogSearch.samplesCount'),
  empty: Astro.locals.t('catalogSearch.samplesEmpty'),
  queryEmpty: Astro.locals.t('catalogSearch.samplesQueryEmpty'),
  filteredQueryEmpty: Astro.locals.t('catalogSearch.samplesFilteredQueryEmpty'),
  queryGuidance: Astro.locals.t('catalogSearch.queryGuidance'),
  preserveFiltersGuidance: Astro.locals.t('catalogSearch.preserveFiltersGuidance'),
  preserveQueryGuidance: Astro.locals.t('catalogSearch.preserveQueryGuidance'),
  filtersGuidance: Astro.locals.t('catalogSearch.filtersGuidance'),
  resetGuidance: Astro.locals.t('catalogSearch.resetGuidance'),
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Eagerly import all sample images at build time
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/samples/**/*.{png,jpg,jpeg,gif,svg,webp}',
  { eager: true }
);

// Build a lookup from the ~/assets/... path to the resolved image
function resolveImagePath(imagePath: string | null): ImageMetadata | null {
  if (!imagePath) return null;
  // Convert ~/assets/samples/... to /src/assets/samples/...
  const importPath = stripSampleImageUrlSuffix(imagePath).replace('~/assets/', '/src/assets/');
  const entry = allImages[importPath];
  return entry?.default ?? null;
}

function resolveThumbnail(thumbnail: SampleThumbnail): ResolvedSampleThumbnail {
  if (isThemeAwareSampleImage(thumbnail)) {
    const light = resolveImagePath(thumbnail.light);
    const dark = resolveImagePath(thumbnail.dark);

    if (light && dark) {
      return { light, dark };
    }

    return light ?? dark ?? null;
  }

  return resolveImagePath(thumbnail);
}

const resolvedSamples = samples.map((s) => ({
  ...s,
  detailHref: sampleDetailHref(base, s.name),
  resolvedThumbnail: resolveThumbnail(s.thumbnail),
}));

// Collect all unique tags, sorted alphabetically
const allTags = [...new Set(samples.flatMap((s) => s.tags))].sort();
const tagCounts = new Map(
  allTags.map((tag) => [tag, samples.filter((s) => s.tags.includes(tag)).length])
);
---

<div class="samples-browser not-content" data-samples-browser>
  <!-- Search bar with embedded clear icon -->
  <div class="search-container search-field search-field-wrap">
    <svg
      class="search-field-icon"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <label class="sr-only" for="samples-search-input">{Astro.locals.t('catalogSearch.samplesLabel')}</label>
    <input
      autocomplete="off"
      spellcheck="false"
      type="search"
      name="q"
      id="samples-search-input"
      class="search-box search-field-input"
      placeholder={Astro.locals.t('catalogSearch.samplesPlaceholder')}
      data-search-input
    />
    <button type="button" class="search-clear search-field-clear" aria-label={messages.clearSearch} data-clear-btn hidden>
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m18 6-12 12M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Filter chips: transparent by default so the wall feels lighter; active
       chips fill with the accent color so they read as the only "loud" item
       in the row. On mobile the row collapses to a two-row max-height with a
       "Show all" expander to avoid the overwhelming 28-tag wall. -->
  <div class="tag-filters" id="sample-tags" data-tag-filters data-collapsed="true">
    {
      allTags.map((tag) => (
        <button
          class="tag-chip"
          data-tag={tag}
          data-tag-label={tagLabel(tag)}
          type="button"
          aria-pressed="false"
        >
          <span class="tag-label">{tagLabel(tag)}</span>
          <span
            class="tag-count"
            aria-label={`${tagCounts.get(tag)} ${tagCounts.get(tag) === 1 ? 'sample' : 'samples'}`}
          >
            {tagCounts.get(tag)}
          </span>
        </button>
      ))
    }
  </div>
  <button class="tag-toggle" type="button" data-tag-toggle aria-controls="sample-tags" aria-expanded="false" hidden>
    <span data-tag-toggle-label>Show all {allTags.length} tags</span>
    <svg
      class="tag-toggle-caret"
      aria-hidden="true"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <!-- Query and facet recovery stay independent; chip states show active tags. -->
  <div class="results-bar">
    <span class="results-count search-results-summary" data-results-count role="status" aria-live="polite" aria-atomic="true">
      {samples.length}
      {samples.length === 1 ? 'sample' : 'samples'}
    </span>
    <button class="clear-all search-action" type="button" data-clear-filters hidden>{messages.clearFilters}</button>
    <button class="clear-all search-action" type="button" data-clear-all hidden>{messages.resetAll}</button>
  </div>

  <!-- Card grid -->
  <div class="card-grid" data-card-grid>
    {
      resolvedSamples.map((sample) => (
        <div class="card-item" data-sample-item>
          <SampleCard sample={sample} />
        </div>
      ))
    }
  </div>

  <!-- Empty state -->
  <div class="empty-state search-empty" data-empty-state style="display: none;">
    <p class="search-empty-title">{Astro.locals.t(samples.length ? 'catalogSearch.samplesEmpty' : 'catalogSearch.samplesUnavailable')}</p>
    {samples.length > 0 && <p class="empty-state-detail search-empty-hint">{Astro.locals.t('catalogSearch.guidance')}</p>}
    <CatalogSearchActiveFilters label={Astro.locals.t('catalogSearch.activeFilters')} />
    <button class="reset-btn search-action" data-reset-btn type="button" hidden={samples.length === 0}>{messages.resetAll}</button>
  </div>
</div>

<!-- is:inline is required so the filter/search logic runs synchronously in the
     page rather than being bundled and deferred by Astro's script processing.
     This ensures the grid is interactive immediately on page load. -->
<script is:inline data-astro-rerun define:vars={{ messages }}>
  (function initializeSampleGrid() {
    const browser = document.querySelector('[data-samples-browser]');
    if (!browser) return;
    if (browser.dataset.samplesInitialized) return;
    browser.dataset.samplesInitialized = 'true';
    const controller = new AbortController();
    const { signal } = controller;
    document.addEventListener('astro:before-swap', () => {
      controller.abort();
      delete browser.dataset.samplesInitialized;
    }, { once: true });

    const searchInput = browser.querySelector('[data-search-input]');
    const clearBtn = browser.querySelector('[data-clear-btn]');
    const tagChips = browser.querySelectorAll('[data-tag]');
    const tagFilters = browser.querySelector('[data-tag-filters]');
    const tagToggle = browser.querySelector('[data-tag-toggle]');
    const tagToggleLabel = browser.querySelector('[data-tag-toggle-label]');
    const cardGrid = browser.querySelector('[data-card-grid]');
    const cardItems = browser.querySelectorAll('[data-sample-item]');
    const resultsCount = browser.querySelector('[data-results-count]');
    const clearAllBtn = browser.querySelector('[data-clear-all]');
    const clearFiltersBtn = browser.querySelector('[data-clear-filters]');
    const emptyState = browser.querySelector('[data-empty-state]');
    const resetBtn = browser.querySelector('[data-reset-btn]');

    let activeTags = new Set();
    let searchQuery = '';
    let recoveryAction = 'clearSearch';
    const validTagSlugs = new Set([...tagChips].map((chip) => chip.dataset.tag).filter(Boolean));
    const SEARCH_PARAM = 'q';
    const TAGS_PARAM = 'tags';
    const TAG_COLLAPSE_THRESHOLD = 8;

    // Hydrate `searchQuery` and `activeTags` from the current URL so a shared
    // link like `?q=redis&tags=databases,redis` lands on a pre-filtered view.
    // Unknown tag slugs are silently dropped; whitespace-only `q` is ignored.
    function readFiltersFromUrl() {
      let params;
      try {
        params = new URLSearchParams(window.location.search);
      } catch (_err) {
        return;
      }

      const initialQuery = (params.get(SEARCH_PARAM) || '').trim();
      if (initialQuery) {
        searchQuery = initialQuery;
        searchInput.value = initialQuery;
      }

      const rawTags = params.get(TAGS_PARAM) || '';
      rawTags
        .split(',')
        .map((tag) => tag.trim())
        .filter((tag) => tag && validTagSlugs.has(tag))
        .forEach((tag) => activeTags.add(tag));

      tagChips.forEach((chip) => {
        const isActive = activeTags.has(chip.dataset.tag);
        chip.classList.toggle('active', isActive);
        chip.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }

    // Mirror current filter state into `location.search` via
    // `history.replaceState` (not `pushState`) so the back/forward stack
    // is unaffected and the URL stays shareable.
    function syncUrl() {
      if (signal.aborted || !browser.isConnected) return;
      let nextSearch = '';
      try {
        const params = new URLSearchParams(window.location.search);
        params.delete(SEARCH_PARAM);
        params.delete(TAGS_PARAM);
        const query = searchQuery.trim();
        if (query) params.set(SEARCH_PARAM, query);
        if (activeTags.size > 0) {
          params.set(TAGS_PARAM, [...activeTags].sort().join(','));
        }
        const serialized = params.toString();
        nextSearch = serialized ? `?${serialized}` : '';
      } catch (_err) {
        return;
      }

      if (window.location.search === nextSearch) return;
      const nextUrl = `${window.location.pathname}${nextSearch}${window.location.hash}`;
      try {
        window.history.replaceState(window.history.state, '', nextUrl);
      } catch (_err) {
        /* ignore — e.g. sandboxed iframes block history APIs */
      }
    }

    function applyFilters() {
      let visible = 0;
      const query = searchQuery.toLowerCase().trim();

      function matchesItem(item) {
        const card = item.querySelector('.sample-card');
        if (!card) return { matchesSearch: false, matchesTags: false };

        const title = card.dataset.title || '';
        const name = card.dataset.name || '';
        const desc = card.dataset.description || '';
        const tags = (card.dataset.tags || '').split(',').filter(Boolean);

        // Text search
        let matchesSearch = true;
        if (query) {
          matchesSearch =
            title.includes(query) ||
            name.includes(query) ||
            desc.includes(query) ||
            tags.some((t) => t.includes(query));
        }

        // Tag filter (AND logic)
        let matchesTags = true;
        if (activeTags.size > 0) {
          matchesTags = [...activeTags].every((tag) => tags.includes(tag));
        }

        return { matchesSearch, matchesTags };
      }

      cardItems.forEach((item) => {
        const { matchesSearch, matchesTags } = matchesItem(item);
        if (matchesSearch && matchesTags) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });

      const total = cardItems.length;
      const hasFilters = activeTags.size > 0;
      resultsCount.textContent = messages.count.replace('{{count}}', String(visible)).replace('{{total}}', String(total));

      cardGrid.style.display = visible === 0 ? 'none' : '';
      emptyState.style.display = visible === 0 ? '' : 'none';
      clearBtn.hidden = !query;
      clearAllBtn.hidden = visible === 0 || !hasFilters || !query;
      clearFiltersBtn.hidden = visible === 0 || !hasFilters || Boolean(query);
      if (visible === 0 && total > 0) {
        let withoutQuery = 0;
        let withoutFilters = 0;
        if (query && activeTags.size > 0) {
          cardItems.forEach((item) => {
            const { matchesSearch, matchesTags } = matchesItem(item);
            if (matchesSearch) withoutFilters++;
            if (matchesTags) withoutQuery++;
          });
        }
        recoveryAction = query && activeTags.size > 0
          ? (withoutFilters > 0 ? 'clearFilters' : withoutQuery > 0 ? 'clearSearch' : 'resetAll')
          : activeTags.size > 0 ? 'clearFilters' : 'clearSearch';
        resetBtn.textContent = messages[recoveryAction];
        const title = query
          ? (withoutFilters > 0 ? messages.filteredQueryEmpty : messages.queryEmpty)
          : messages.empty;
        emptyState.querySelector('.search-empty-title').textContent = title.replace('{{query}}', () => searchQuery.trim());
        const guidance = recoveryAction === 'clearFilters'
          ? (query ? messages.preserveQueryGuidance : messages.filtersGuidance)
          : recoveryAction === 'clearSearch'
            ? (activeTags.size > 0 ? messages.preserveFiltersGuidance : messages.queryGuidance)
            : messages.resetGuidance;
        const selectedLabels = [...tagChips].filter((chip) => activeTags.has(chip.dataset.tag))
          .map((chip) => chip.dataset.tagLabel);
        emptyState.querySelector('.search-empty-hint').textContent = guidance;
        emptyState.querySelector('catalog-search-active-filters').dataset.labels = JSON.stringify(selectedLabels);
      }

      syncUrl();
    }

    // Search
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      applyFilters();
    }, { signal });

    function clearSearch() {
      searchInput.value = '';
      searchQuery = '';
      applyFilters();
      searchInput.focus();
    }
    clearBtn.addEventListener('click', clearSearch, { signal });
    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') clearSearch();
    }, { signal });

    // Tag chips
    tagChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const tag = chip.dataset.tag;
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
          chip.classList.remove('active');
          chip.setAttribute('aria-pressed', 'false');
        } else {
          activeTags.add(tag);
          chip.classList.add('active');
          chip.setAttribute('aria-pressed', 'true');
        }
        applyFilters();
      }, { signal });
    });

    // Restore facet defaults without changing the query.
    function clearFilters() {
      activeTags.clear();
      tagChips.forEach((chip) => {
        chip.classList.remove('active');
        chip.setAttribute('aria-pressed', 'false');
      });
      applyFilters();
      searchInput.focus();
    }

    function resetAll() {
      searchInput.value = '';
      searchQuery = '';
      clearFilters();
    }

    if (clearAllBtn) clearAllBtn.addEventListener('click', resetAll, { signal });
    clearFiltersBtn.addEventListener('click', clearFilters, { signal });
    if (resetBtn) resetBtn.addEventListener('click', () => {
      if (recoveryAction === 'resetAll') resetAll();
      else if (recoveryAction === 'clearFilters') clearFilters();
      else clearSearch();
    }, { signal });

    // Mobile "Show all N tags" expander — only meaningful when there are
    // enough tags that the wall would feel overwhelming. The toggle button
    // is hidden on viewports wide enough to show every chip without
    // overflow (see the @media rule in <style>); we still show/hide it via
    // the `hidden` attribute so the count doesn't render when unnecessary.
    if (tagToggle && tagFilters && tagChips.length > TAG_COLLAPSE_THRESHOLD) {
      tagToggle.hidden = false;

      // If a hidden chip is active on hydrate, expand the row by default so
      // the user sees what's filtering their view.
      const visibleHiddenActive = [...tagChips]
        .slice(TAG_COLLAPSE_THRESHOLD)
        .some((chip) => chip.classList.contains('active'));
      if (visibleHiddenActive) {
        tagFilters.setAttribute('data-collapsed', 'false');
        tagToggle.setAttribute('aria-expanded', 'true');
        if (tagToggleLabel) tagToggleLabel.textContent = 'Show fewer tags';
      }

      tagToggle.addEventListener('click', () => {
        const collapsed = tagFilters.getAttribute('data-collapsed') === 'true';
        tagFilters.setAttribute('data-collapsed', collapsed ? 'false' : 'true');
        if (tagToggleLabel) {
          tagToggleLabel.textContent = collapsed
            ? 'Show fewer tags'
            : `Show all ${tagChips.length} tags`;
        }
        tagToggle.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
      }, { signal });
    }

    // Initialize
    readFiltersFromUrl();
    applyFilters();
  })();
</script>

<style>
  .samples-browser {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ---- Visually-hidden label (mirrors Starlight pattern) ---- */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---- Search ---- */
  .search-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  /* ---- Tag chips: quiet by default, accent-filled when active ---- */
  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag-chip {
    min-height: 2rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 2rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      color 0.15s ease;
    white-space: nowrap;
    user-select: none;
  }

  .tag-chip:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  .tag-chip:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .tag-count {
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .tag-chip.active {
    border-color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-text-accent) 14%, transparent);
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .tag-chip.active .tag-count {
    color: color-mix(in srgb, var(--sl-color-white) 75%, transparent);
  }

  /* ---- Mobile-only "Show all N tags" expander ---- */
  .tag-toggle {
    display: none;
    align-items: center;
    gap: 0.3rem;
    align-self: flex-start;
    margin-top: 0.1rem;
    padding: 0.2rem 0.1rem;
    border: none;
    background: transparent;
    color: var(--sl-color-text-accent);
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
  }

  .tag-toggle:hover {
    color: var(--sl-color-white);
  }

  .tag-toggle-caret {
    transition: transform 0.2s ease;
  }

  .tag-filters[data-collapsed='false'] ~ .tag-toggle .tag-toggle-caret {
    transform: rotate(180deg);
  }

  @media (max-width: 768px) {
    .tag-toggle:not([hidden]) {
      display: inline-flex;
    }

    /* Cap the chip wall to ~2 rows on narrow viewports. The mask gives a
       subtle fade so the cut-off feels intentional rather than clipped. */
    .tag-filters[data-collapsed='true'] {
      max-height: 4.5rem;
      overflow: hidden;
      mask-image: linear-gradient(to bottom, #000 60%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    }
  }

  /* ---- Results header ---- */
  .results-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.25rem;
    border-top: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 60%, transparent);
  }

  .clear-all {
    border: none;
    background: none;
    padding: 0;
    color: var(--sl-color-text-accent);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: underline;
    white-space: nowrap;
  }

  .clear-all:hover,
  .clear-all:focus-visible {
    color: var(--sl-color-white);
    outline: none;
  }

  /* ---- Card grid (CSS columns for masonry) ---- */
  .card-grid {
    column-count: 1;
    column-gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .card-grid {
      column-count: 2;
    }
  }

  .card-item {
    break-inside: avoid;
    margin-bottom: 1.25rem;
  }

  /* ---- Empty state ---- */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-3);
    text-align: start;
  }

  .empty-state p {
    margin: 0;
    font-size: 1.1rem;
  }

  .empty-state-detail {
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
  }

  .reset-btn {
    align-self: flex-start;
  }

  button[hidden] { display: none; }
  button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .reset-btn:hover {
    color: var(--sl-color-text);
  }

  /* ---- Even tighter chips on very narrow screens ---- */
  @media (max-width: 480px) {
    .tag-chip {
      font-size: 0.72rem;
      padding: 0.2rem 0.55rem;
    }
    .tag-count {
      font-size: 0.68rem;
    }
  }
</style>
