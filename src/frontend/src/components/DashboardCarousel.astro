---
import { Icon } from '@astrojs/starlight/components';
import ThemeImage from '@components/ThemeImage.astro';
import type { ImageMetadata } from 'astro';

import PauseIcon from '@assets/icons/pause.svg';
import PlayIcon from '@assets/icons/play.svg';

import resourcesGraphLight from '@assets/dashboard/landing/resources-graph-light.png';
import resourcesGraphDark from '@assets/dashboard/landing/resources-graph-dark.png';
import resourcesTableLight from '@assets/dashboard/landing/resources-table-light.png';
import resourcesTableDark from '@assets/dashboard/landing/resources-table-dark.png';
import consoleLight from '@assets/dashboard/landing/console-light.png';
import consoleDark from '@assets/dashboard/landing/console-dark.png';
import structuredLight from '@assets/dashboard/landing/structured-logs-light.png';
import structuredDark from '@assets/dashboard/landing/structured-logs-dark.png';
import tracesLight from '@assets/dashboard/landing/traces-light.png';
import tracesDark from '@assets/dashboard/landing/traces-dark.png';
import traceDetailLight from '@assets/dashboard/landing/trace-detail-light.png';
import traceDetailDark from '@assets/dashboard/landing/trace-detail-dark.png';
import metricsLight from '@assets/dashboard/landing/metrics-light.png';
import metricsDark from '@assets/dashboard/landing/metrics-dark.png';

interface Slide {
  id: string;
  label: string;
  alt: string;
  light: ImageMetadata;
  dark: ImageMetadata;
}

interface Props {
  autoplay?: boolean;
  presentation?: 'coverflow' | 'stage';
}

const { autoplay = true, presentation = 'coverflow' } = Astro.props as Props;

const slides: Slide[] = [
  {
    id: 'resources-graph',
    label: 'Resource graph',
    alt: 'Aspire dashboard resource graph showing the AspireShop services, databases, and caches connected as healthy nodes.',
    light: resourcesGraphLight,
    dark: resourcesGraphDark,
  },
  {
    id: 'resources-table',
    label: 'Resource dashboard',
    alt: 'Aspire dashboard resources table listing every running project, container, and executable with state, endpoints, and actions.',
    light: resourcesTableLight,
    dark: resourcesTableDark,
  },
  {
    id: 'console',
    label: 'Console logs',
    alt: 'Aspire dashboard console logs streaming interleaved, color-coded output from every resource in real time.',
    light: consoleLight,
    dark: consoleDark,
  },
  {
    id: 'structured-logs',
    label: 'Structured logs',
    alt: 'Aspire dashboard structured logs view with a filterable, searchable grid of OpenTelemetry log records.',
    light: structuredLight,
    dark: structuredDark,
  },
  {
    id: 'traces',
    label: 'Distributed traces',
    alt: 'Aspire dashboard traces list showing distributed traces with per-resource span counts and durations.',
    light: tracesLight,
    dark: tracesDark,
  },
  {
    id: 'trace-detail',
    label: 'Trace detail',
    alt: 'Aspire dashboard trace detail waterfall for an add-to-cart request across the frontend, basket service, and cache, with span attributes.',
    light: traceDetailLight,
    dark: traceDetailDark,
  },
  {
    id: 'metrics',
    label: 'Metrics',
    alt: 'Aspire dashboard metrics view charting HTTP server request duration percentiles for the frontend with dimension filters.',
    light: metricsLight,
    dark: metricsDark,
  },
];

const tt = (key: string, fallback: string, values?: Record<string, string | number>) => {
  const translated = Astro.locals.t(key as any, values as any);
  return translated && translated !== key ? translated : fallback;
};

const localizedSlides = slides.map((slide) => ({
  ...slide,
  label: tt(`landing.dashboardCarousel.slides.${slide.id}.label`, slide.label),
  alt: tt(`landing.dashboardCarousel.slides.${slide.id}.alt`, slide.alt),
}));

const carouselLabel = tt('landing.dashboardCarousel.label', 'Aspire dashboard views');
const chooseViewLabel = tt('landing.dashboardCarousel.chooseView', 'Choose a dashboard view');
const previousLabel = tt('landing.dashboardCarousel.previous', 'Previous view');
const nextLabel = tt('landing.dashboardCarousel.next', 'Next view');
const playLabel = tt('landing.dashboardCarousel.play', 'Play dashboard tour');
const pauseLabel = tt('landing.dashboardCarousel.pause', 'Pause dashboard tour');
const formatSlideLabel = (index: number, count: number, label: string) =>
  tt('landing.dashboardCarousel.slideLabel', '{{index}} of {{count}}: {{label}}', {
    index,
    count,
    label,
  });
---

<section
  class="dashboard-carousel not-content"
  data-dashboard-carousel
  role="group"
  aria-roledescription="carousel"
  aria-label={carouselLabel}
  data-autoplay={autoplay ? 'true' : 'false'}
  data-presentation={presentation}
>
  <div class="stage" data-stage>
    {
      localizedSlides.map((s, i) => (
        <div
          class="slide"
          data-slide
          data-index={i}
          data-slide-label={s.label}
          role="group"
          aria-roledescription="slide"
          aria-label={formatSlideLabel(i + 1, localizedSlides.length, s.label)}
        >
          <ThemeImage
            light={s.light}
            dark={s.dark}
            alt={s.alt}
            label={s.label}
            classOverride="dashboard-shot"
          />
        </div>
      ))
    }

    <button
      type="button"
      class="carousel-playback-btn"
      data-playback-toggle
      data-playing="false"
      data-label-play={playLabel}
      data-label-pause={pauseLabel}
      aria-label={pauseLabel}
      aria-pressed="false"
    >
      <span class="carousel-pause-icon" aria-hidden="true"><PauseIcon /></span>
      <span class="carousel-play-icon" aria-hidden="true"><PlayIcon /></span>
    </button>
  </div>

  <div class="carousel-progress" data-progress aria-hidden="true">
    <span class="carousel-progress-fill" data-progress-fill></span>
  </div>

  <div class="carousel-footer">
    <p class="active-label" data-active-label>{localizedSlides[0].label}</p>
    <div class="controls">
      <button type="button" class="nav-btn prev-btn" data-prev aria-label={previousLabel}>
        <Icon name="left-arrow" size="1.5rem" />
      </button>
      <div class="dots" role="group" aria-label={chooseViewLabel}>
        {
          localizedSlides.map((s, i) => (
            <button
              type="button"
              class="dot"
              data-dot
              data-index={i}
              aria-label={s.label}
              aria-pressed={i === 0 ? 'true' : 'false'}
            />
          ))
        }
      </div>
      <button type="button" class="nav-btn next-btn" data-next aria-label={nextLabel}>
        <Icon name="right-arrow" size="1.5rem" />
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    function init() {
      const root = document.querySelector('[data-dashboard-carousel]');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const stage = root.querySelector('[data-stage]');
      const slides = Array.from(root.querySelectorAll('[data-slide]'));
      const dots = Array.from(root.querySelectorAll('[data-dot]'));
      const label = root.querySelector('[data-active-label]');
      const prevBtn = root.querySelector('[data-prev]');
      const nextBtn = root.querySelector('[data-next]');
      const n = slides.length;
      if (!stage || n === 0) {
        delete root.dataset.initialized;
        return;
      }

      const reduce =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const autoplay = root.dataset.autoplay !== 'false';
      const stagePresentation = root.dataset.presentation === 'stage';
      if (reduce) root.classList.add('reduced-motion');

      const MAX_VISIBLE = 2;
      let active = 0;
      let zoomOpen = false;
      let zoomObserver = null;
      let cleaned = false;
      const cleanupTasks = [];

      const labels = slides.map((s) => s.dataset.slideLabel || '');
      const focusableSelector = [
        'a[href]',
        'button',
        'input',
        'select',
        'textarea',
        '[tabindex]',
      ].join(',');

      function addListener(target, type, handler, options) {
        target.addEventListener(type, handler, options);
        cleanupTasks.push(() => target.removeEventListener(type, handler, options));
      }

      function setSlideTabbable(slide, tabbable) {
        if (tabbable) {
          slide.removeAttribute('aria-hidden');
        } else {
          slide.setAttribute('aria-hidden', 'true');
        }
        slide.querySelectorAll(focusableSelector).forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          if (tabbable) {
            if (el.dataset.carouselTabindex === undefined) return;
            if (el.dataset.carouselTabindex === '') {
              el.removeAttribute('tabindex');
            } else {
              el.setAttribute('tabindex', el.dataset.carouselTabindex);
            }
            delete el.dataset.carouselTabindex;
          } else {
            if (el.dataset.carouselTabindex === undefined) {
              el.dataset.carouselTabindex = el.getAttribute('tabindex') ?? '';
            }
            el.setAttribute('tabindex', '-1');
          }
        });
      }

      function cleanup() {
        if (cleaned) return;
        cleaned = true;
        stopPlayback();
        if (zoomObserver) zoomObserver.disconnect();
        cleanupTasks.splice(0).forEach((dispose) => dispose());
        delete root.dataset.initialized;
      }

      addListener(document, 'astro:before-swap', cleanup, { once: true });
      addListener(window, 'pagehide', cleanup, { once: true });

      // Prevent the browser's native image drag/highlight ghost during swipe.
      slides.forEach((s) => {
        const img = s.querySelector('img');
        if (img) img.setAttribute('draggable', 'false');
      });

      // Shortest signed distance on the ring of slides (enables infinite coverflow).
      function ringOffset(i) {
        let o = i - active;
        if (o > n / 2) o -= n;
        if (o < -n / 2) o += n;
        return o;
      }

      // Per-offset coverflow tuning (index = absolute distance from center).
      // Neighbors step down in scale so the active slide reads larger; the far
      // edges recede, fade, and blur. The near slides stay fully opaque so they
      // cleanly occlude the far slide stacked behind them (no bleed-through);
      // only the outermost slides fade, and they sit over the page background.
      const STEP = 43; // percent of card width between neighbors
      const TUNE = [
        { scale: 1, tz: 0, rot: 0, op: 1, blur: 0 },
        { scale: 0.72, tz: -120, rot: 32, op: 1, blur: 1.3 },
        { scale: 0.58, tz: -230, rot: 42, op: 0.52, blur: 4.2 },
      ];

      function render() {
        for (let i = 0; i < n; i++) {
          const slide = slides[i];
          const o = ringOffset(i);
          const isActive = o === 0;

          if (stagePresentation) {
            slide.style.transform = 'none';
            slide.style.opacity = isActive ? '1' : '0';
            slide.style.zIndex = isActive ? '2' : '1';
            slide.style.filter = 'none';
            slide.style.pointerEvents = isActive ? 'auto' : 'none';
            slide.classList.toggle('is-active', isActive);
            setSlideTabbable(slide, isActive);
            if (isActive) {
              slide.setAttribute('aria-current', 'true');
            } else {
              slide.removeAttribute('aria-current');
            }
            continue;
          }

          const abs = Math.abs(o);
          const sign = Math.sign(o);
          const hidden = abs > MAX_VISIBLE;
          const t = TUNE[Math.min(abs, TUNE.length - 1)];

          const x = o * STEP; // percent of card width -> horizontal spacing / overlap
          const rotateY = o === 0 ? 0 : sign * -t.rot;

          slide.style.transform =
            `translate(-50%, -50%) translateX(${x}%) translateZ(${t.tz}px)` +
            ` rotateY(${rotateY}deg) scale(${t.scale})`;
          slide.style.opacity = hidden ? '0' : String(t.op);
          slide.style.zIndex = String(100 - abs);
          slide.style.filter = t.blur ? `blur(${t.blur}px)` : 'none';
          slide.style.pointerEvents = hidden ? 'none' : 'auto';
          slide.classList.toggle('is-active', o === 0);
          setSlideTabbable(slide, o === 0);
          if (o === 0) {
            slide.setAttribute('aria-current', 'true');
          } else {
            slide.removeAttribute('aria-current');
          }
        }
        dots.forEach((d, i) => d.setAttribute('aria-pressed', i === active ? 'true' : 'false'));
        if (label) label.textContent = labels[active] || '';
      }

      function setActive(i) {
        active = ((i % n) + n) % n;
        render();
      }

      function next() {
        setActive(active + 1);
      }
      function prev() {
        setActive(active - 1);
      }

      function measure() {
        // Keep the stage exactly as tall as the centered (unscaled) slide.
        const centered = slides[active];
        const h = centered.getBoundingClientRect().height;
        if (h) stage.style.height = `${Math.round(h)}px`;
      }

      // --- Controls ---
      nextBtn && addListener(nextBtn, 'click', () => manualNav(next));
      prevBtn && addListener(prevBtn, 'click', () => manualNav(prev));
      dots.forEach((d) =>
        addListener(d, 'click', () => manualNav(() => setActive(Number(d.dataset.index) || 0)))
      );

      // Click a side slide to bring it to the center.
      slides.forEach((s) =>
        addListener(s, 'click', () => {
          if (!s.classList.contains('is-active'))
            manualNav(() => setActive(Number(s.dataset.index) || 0));
        })
      );

      // Keyboard navigation when the carousel has focus.
      root.setAttribute('tabindex', '0');
      addListener(root, 'keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          manualNav(next);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          manualNav(prev);
        }
      });

      // Pointer / touch swipe. Works for mouse drag and finger swipe. We lock
      // onto the gesture only once horizontal movement dominates, so vertical
      // finger scrolling still pans the page normally.
      const SWIPE_THRESHOLD = 40; // px of travel required to change slides
      const INTENT_SLOP = 8; // px before we decide swipe vs. scroll
      let startX = null;
      let startY = null;
      let swiping = false; // horizontal gesture claimed
      let dragged = false; // moved enough to suppress the trailing click

      addListener(
        root,
        'pointerdown',
        (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          startX = e.clientX;
          startY = e.clientY;
          swiping = false;
          dragged = false;
        },
        { passive: true }
      );

      addListener(
        root,
        'pointermove',
        (e) => {
          if (startX === null) return;
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          if (!swiping) {
            if (Math.abs(dx) < INTENT_SLOP && Math.abs(dy) < INTENT_SLOP) return;
            if (Math.abs(dx) > Math.abs(dy)) {
              swiping = true; // horizontal -> we own this gesture
            } else {
              startX = null; // vertical -> let the page scroll
              return;
            }
          }
          dragged = true;
          if (e.cancelable) e.preventDefault(); // block scroll/selection mid-swipe
        },
        { passive: false }
      );

      function endSwipe(e) {
        if (startX === null) {
          swiping = false;
          return;
        }
        const dx = e.clientX - startX;
        const wasSwiping = swiping;
        startX = null;
        startY = null;
        swiping = false;
        if (wasSwiping && Math.abs(dx) > SWIPE_THRESHOLD) {
          manualNav(dx < 0 ? next : prev);
        }
      }
      addListener(root, 'pointerup', endSwipe);
      addListener(root, 'pointercancel', () => {
        startX = null;
        startY = null;
        swiping = false;
      });

      // A swipe must not also fire the trailing click (which would zoom the
      // active image or re-center a side slide). Swallow it in the capture
      // phase before the slide/zoom handlers see it.
      addListener(
        root,
        'click',
        (e) => {
          if (dragged) {
            e.stopPropagation();
            e.preventDefault();
            dragged = false;
          }
        },
        true
      );

      // --- Playback engine (rAF progress + optional visible controls) ---
      // A steady progress bar drives auto-advance. Visible playback UI (the
      // bottom-left play/pause button and the progress bar) is only shown for
      // the stage presentation; the coverflow presentation keeps the classic
      // silent hover-to-pause autoplay with no chrome.
      const DURATION = 7000; // ms spent on each slide while playing
      const toggleBtn = root.querySelector('[data-playback-toggle]');
      const progressFill = root.querySelector('[data-progress-fill]');
      const PLAY_LABEL = (toggleBtn && toggleBtn.dataset.labelPlay) || 'Play';
      const PAUSE_LABEL = (toggleBtn && toggleBtn.dataset.labelPause) || 'Pause';
      const controlsEnabled = stagePresentation && !reduce;
      root.dataset.playback = controlsEnabled ? 'on' : 'off';

      let isPlaying = autoplay && !reduce;
      let progress = 0; // 0..1 through the current slide
      let rafId = null;
      let lastTs = 0;
      let hovered = false;
      let focusWithin = false;

      function suspended() {
        if (zoomOpen || document.hidden) return true;
        // In coverflow mode the pointer/focus pause keeps the marquee polite.
        // In stage mode the explicit button owns the play state, so hovering
        // must not fight the user's choice.
        if (!controlsEnabled && (hovered || focusWithin)) return true;
        return false;
      }

      function updateProgressUI() {
        if (!progressFill) return;
        const p = Math.max(0, Math.min(1, progress));
        progressFill.style.transform = `scaleX(${p})`;
      }

      function updateToggleUI() {
        if (!toggleBtn) return;
        toggleBtn.dataset.playing = isPlaying ? 'true' : 'false';
        toggleBtn.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
        toggleBtn.setAttribute('aria-label', isPlaying ? PAUSE_LABEL : PLAY_LABEL);
      }

      function stopRaf() {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        lastTs = 0;
      }

      function tick(ts) {
        rafId = null;
        if (!isPlaying || suspended()) return; // resume() restarts the loop
        if (lastTs === 0) lastTs = ts;
        const dt = ts - lastTs;
        lastTs = ts;
        progress += dt / DURATION;
        if (progress >= 1) {
          progress = 0;
          setActive(active + 1);
        }
        updateProgressUI();
        rafId = requestAnimationFrame(tick);
      }

      function resume() {
        if (!isPlaying || suspended() || rafId !== null) return;
        lastTs = 0;
        rafId = requestAnimationFrame(tick);
      }

      // Re-evaluate suspension after a hover/focus/visibility/zoom change.
      function refreshPlayback() {
        if (!isPlaying) return;
        if (suspended()) {
          stopRaf();
        } else {
          resume();
        }
      }

      function setPlaying(next) {
        if (isPlaying === next) return;
        isPlaying = next;
        updateToggleUI();
        if (isPlaying) {
          resume();
        } else {
          stopRaf();
        }
        updateProgressUI();
      }

      // Manual navigation resets the current slide's progress. In stage mode it
      // also drops into manual mode (paused); pressing play then resumes from
      // the start of whatever slide is now centered. Coverflow keeps playing.
      function manualNav(navFn) {
        navFn();
        progress = 0;
        if (controlsEnabled) {
          setPlaying(false);
        } else {
          lastTs = 0;
        }
        updateProgressUI();
      }

      toggleBtn && addListener(toggleBtn, 'click', () => setPlaying(!isPlaying));

      addListener(root, 'pointerenter', () => {
        hovered = true;
        refreshPlayback();
      });
      addListener(root, 'pointerleave', () => {
        hovered = false;
        refreshPlayback();
      });
      addListener(root, 'focusin', () => {
        focusWithin = true;
        refreshPlayback();
      });
      addListener(root, 'focusout', (e) => {
        if (root.contains(e.relatedTarget)) return;
        focusWithin = false;
        refreshPlayback();
      });
      addListener(document, 'visibilitychange', refreshPlayback);

      function stopPlayback() {
        stopRaf();
      }

      // Pause autoplay while an image is zoomed open. starlight-image-zoom adds
      // the `starlight-image-zoom-opened` class to <body> for the duration.
      const body = document.body;
      zoomObserver = new MutationObserver(() => {
        const open = body.classList.contains('starlight-image-zoom-opened');
        if (open === zoomOpen) return;
        zoomOpen = open;
        refreshPlayback();
      });
      zoomObserver.observe(body, { attributes: true, attributeFilter: ['class'] });

      addListener(window, 'resize', measure);

      // Initial paint.
      root.classList.add('is-ready');
      requestAnimationFrame(() => {
        measure();
        render();
        updateToggleUI();
        updateProgressUI();
        resume();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .dashboard-carousel {
    --carousel-primary: var(--aspire-color-primary);
    position: relative;
    max-width: 78rem;
    margin: 2rem auto 2.5rem;
    padding: 0;
    outline: none;
    /* Reserve horizontal drags for the swipe handler; vertical still scrolls. */
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    /* Fade the far edges softly instead of a hard clip at the stage boundary. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 11%,
      #000 89%,
      transparent 100%
    );
    mask-image: linear-gradient(to right, transparent 0, #000 11%, #000 89%, transparent 100%);
  }
  .dashboard-carousel:focus-visible {
    outline: 0.1875rem solid var(--carousel-primary);
    outline-offset: 0.25rem;
  }

  .dashboard-carousel[data-presentation='stage'] {
    max-width: none;
    margin: 0;
    padding: clamp(1rem, 2.5vw, 2rem);
    -webkit-mask-image: none;
    mask-image: none;
  }

  .dashboard-carousel[data-presentation='stage'] .stage {
    height: auto;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(229, 226, 244, 0.14);
    border-radius: 0.7rem;
    perspective: none;
    transform-style: flat;
    background: #151423;
  }

  .dashboard-carousel[data-presentation='stage'] .slide {
    inset: 0;
    top: 0;
    left: 0;
    width: 100%;
    transform: none;
    border: 0;
    border-radius: 0.65rem;
    cursor: default;
    box-shadow: none;
    transition: opacity 420ms ease;
  }

  .dashboard-carousel[data-presentation='stage'] .slide.is-active {
    box-shadow: none;
  }

  .dashboard-carousel[data-presentation='stage'] .carousel-footer {
    flex-direction: row;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .dashboard-carousel[data-presentation='stage'] .active-label {
    color: #ded9eb;
    font: 650 0.78rem/1.2 var(--__sl-font-mono);
  }

  .dashboard-carousel[data-presentation='stage'] .dot {
    position: relative;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid transparent;
    background: transparent;
  }

  .dashboard-carousel[data-presentation='stage'] .dot::after {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #8d879d;
    content: '';
    transform: translate(-50%, -50%);
  }

  .dashboard-carousel[data-presentation='stage'] .dot[aria-pressed='true'] {
    border-color: rgba(195, 173, 255, 0.38);
    background: rgba(195, 173, 255, 0.09);
    transform: none;
  }

  .dashboard-carousel[data-presentation='stage'] .dot[aria-pressed='true']::after {
    background: #c3adff;
  }

  /* --- Playback controls (only rendered for the stage presentation) --- */
  .carousel-playback-btn,
  .carousel-progress {
    display: none;
  }

  .dashboard-carousel[data-playback='on'] .carousel-playback-btn {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 120;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(229, 226, 244, 0.22);
    border-radius: 0.625rem;
    color: #ded9eb;
    background: rgba(15, 14, 26, 0.66);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      transform 120ms ease;
  }

