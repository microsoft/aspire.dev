---
import { Icon } from '@astrojs/starlight/components';

import AspireLogo from '@assets/aspire-logo-32.svg';
import notFoundImage from '@assets/not-found.webp';
---

<section class="not-found-story not-content" aria-labelledby="not-found-title">
  <div class="not-found-grid" aria-hidden="true"></div>
  <div class="not-found-glow" aria-hidden="true"></div>

  <div class="not-found-layout">
    <div class="not-found-copy">
      <p class="not-found-eyebrow">
        <span aria-hidden="true"></span>
        404 / Not found
      </p>
      <h1 id="not-found-title">Wrong <span>route?</span></h1>
      <p class="not-found-summary">
        The page you're looking for isn't available. Explore the docs or retrace your steps to a
        familiar route.
      </p>
      <div class="not-found-actions">
        <a class="not-found-action primary" href="/">
          Go home
          <AspireLogo class="not-found-action-logo" aria-hidden="true" />
        </a>
        <a
          class="not-found-action secondary"
          href="/"
          onclick="event.preventDefault(); history.back();"
        >
          <Icon name="left-arrow" size="1.05rem" />
          Go back
        </a>
      </div>
    </div>

    <div class="not-found-art" aria-hidden="true">
      <div class="not-found-orbit orbit-one"></div>
      <div class="not-found-orbit orbit-two"></div>
      <img
        src={notFoundImage.src}
        alt=""
        width={notFoundImage.width}
        height={notFoundImage.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        data-zoom-off
      />
    </div>
  </div>
</section>

<style>
  :global(main > .content-panel:has(.not-found-story)) {
    padding: 0;
    overflow: clip;
  }

  :global(main:has(.not-found-story) > .content-panel:first-of-type) {
    display: none;
  }

  :global(main > .content-panel:has(.not-found-story) > .sl-container) {
    max-width: none;
    margin-inline: 0;
  }

  :global(.sl-container:has(.not-found-story) > .sl-markdown-content) {
    max-width: none;
    margin-top: 0;
  }

  :global(.sl-container:has(.not-found-story) > .footer-wrapper) {
    width: min(calc(100% - 3rem), 67.5rem);
    margin-inline: auto;
  }

  :global(body:has(.not-found-story) header.header) {
    background: color-mix(in srgb, var(--sl-color-bg) 94%, transparent);
    border-block-end-color: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
    backdrop-filter: blur(1rem) saturate(140%);
  }

  .not-found-story {
    --not-found-bg: #f5f6f8;
    --not-found-surface: #ffffff;
    --not-found-border: rgba(31, 30, 51, 0.14);
    --not-found-text: #1f1e33;
    --not-found-muted: #575469;
    --not-found-purple: #512bd4;
    --not-found-glow: rgba(124, 82, 255, 0.3);
    --not-found-grid-line: rgba(31, 30, 51, 0.07);
    --not-found-image-blend: normal;
    --not-found-image-shadow: 0 1.5rem 3.5rem rgba(49, 24, 139, 0.18);
    --not-found-image-filter: saturate(0.98) brightness(1.04)
      drop-shadow(0 1rem 1.75rem rgba(49, 24, 139, 0.12));
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    min-height: calc(100svh - var(--sl-nav-height, 4rem));
    overflow: clip;
    padding: clamp(3rem, 7vw, 7rem) 1.5rem;
    color: var(--not-found-text);
    background: var(--not-found-bg);
  }

  :global([data-theme='dark']) .not-found-story {
    --not-found-bg: #151423;
    --not-found-surface: #201e31;
    --not-found-border: rgba(229, 226, 244, 0.16);
    --not-found-text: #f7f5ff;
    --not-found-muted: #c5c0d5;
    --not-found-purple: #a98bff;
    --not-found-glow: rgba(115, 67, 255, 0.32);
    --not-found-grid-line: rgba(229, 226, 244, 0.07);
    --not-found-image-blend: normal;
    --not-found-image-shadow: 0 1.5rem 3.5rem rgba(7, 4, 24, 0.45);
    --not-found-image-filter: saturate(1.08) brightness(0.88)
      drop-shadow(0 1rem 1.75rem rgba(7, 4, 24, 0.28));
  }

  .not-found-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.42;
    background-image:
      linear-gradient(to right, var(--not-found-grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--not-found-grid-line) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 82%, transparent);
  }

  .not-found-glow {
    position: absolute;
    inset: -20% -10%;
    z-index: -1;
    background:
      radial-gradient(circle at 72% 48%, var(--not-found-glow), transparent 32rem),
      radial-gradient(circle at 18% 28%, rgba(81, 43, 212, 0.18), transparent 25rem);
  }

  .not-found-layout {
    width: min(calc(100% - clamp(3rem, 10vw, 8rem)), 82rem);
    min-height: calc(100svh - var(--sl-nav-height, 4rem) - clamp(6rem, 14vw, 14rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(32rem, 1.28fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 4rem);
  }

  .not-found-copy {
    position: relative;
    z-index: 2;
  }

  .not-found-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.25rem;
    color: var(--not-found-muted);
    font: 600 0.76rem/1.2 var(--__sl-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .not-found-eyebrow span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #f070a1;
    box-shadow: 0 0 0 0.3rem rgba(240, 112, 161, 0.14);
  }

  .not-found-copy h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--not-found-text);
    font-size: clamp(3.3rem, 5vw, 5.75rem);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .not-found-copy h1 span {
    color: var(--not-found-purple);
  }

  .not-found-summary {
    max-width: 35rem;
    margin: 1.55rem 0 0;
    color: var(--not-found-muted);
    font-size: clamp(1.05rem, 1.45vw, 1.3rem);
    line-height: 1.65;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.9rem;
  }

  .not-found-action {
    min-height: 3.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--not-found-border);
    border-radius: 0.65rem;
    color: var(--not-found-text);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .not-found-action:hover {
    transform: translateY(-2px);
    filter: none;
  }

  .not-found-action-logo {
    width: 1.15rem;
    height: 1.15rem;
  }

  .not-found-action.primary {
    color: #ffffff;
    border-color: #7455dd;
    background: #7455dd;
    box-shadow: 0 0.7rem 1.7rem rgba(116, 85, 221, 0.26);
  }

  .not-found-action.primary:hover {
    border-color: #886df0;
    background: #886df0;
    box-shadow: 0 0.9rem 2rem rgba(116, 85, 221, 0.34);
  }

  .not-found-action.secondary {
    background: color-mix(in srgb, var(--not-found-surface) 78%, transparent);
  }

  .not-found-action.secondary:hover {
    border-color: color-mix(in srgb, var(--not-found-purple) 55%, var(--not-found-border));
    background: var(--not-found-surface);
  }

  .not-found-action:focus-visible {
    outline: 0.1875rem solid var(--not-found-purple);
    outline-offset: 0.25rem;
  }

  .not-found-art {
    position: relative;
    width: min(44rem, 45vw);
    justify-self: start;
  }

  .not-found-art :global(img) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--not-found-border);
    border-radius: 1.25rem;
    box-shadow: var(--not-found-image-shadow);
    mix-blend-mode: var(--not-found-image-blend);
    filter: var(--not-found-image-filter);
  }

  .not-found-orbit {
    position: absolute;
    left: 50%;
    top: 52%;
    border: 1px solid color-mix(in srgb, var(--not-found-purple) 30%, transparent);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-8deg);
  }

  .orbit-one {
    width: 86%;
    height: 56%;
  }

  .orbit-two {
    width: 68%;
    height: 44%;
    transform: translate(-50%, -50%) rotate(14deg);
  }

  @media (max-width: 64rem) {
    .not-found-layout {
      grid-template-columns: minmax(16rem, 0.8fr) minmax(26rem, 1.2fr);
    }

    .not-found-art {
      width: min(40rem, 44vw);
      justify-self: start;
    }
  }

  @media (max-width: 49.99rem) {
    .not-found-story {
      min-height: 0;
      padding: 2.75rem 1rem 4rem;
    }

    .not-found-grid {
      background-size: 3rem 3rem;
    }

    .not-found-layout {
      width: 100%;
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .not-found-copy {
      text-align: center;
    }

    .not-found-eyebrow {
      margin-bottom: 1rem;
    }

    .not-found-copy h1 {
      max-width: 11ch;
      margin-inline: auto;
      font-size: clamp(2.75rem, 13vw, 4.25rem);
    }

    .not-found-summary {
      max-width: 36rem;
      margin-inline: auto;
      font-size: 1.02rem;
    }

    .not-found-actions {
      justify-content: center;
    }

    .not-found-art {
      grid-row: 1;
      width: min(34.5rem, 84vw);
      margin-inline: -6vw;
      justify-self: center;
    }
  }

  @media (max-width: 30rem) {
    .not-found-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .not-found-action {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .not-found-action {
      transition:
        transform 180ms ease,
        border-color 180ms ease,
        background-color 180ms ease,
        box-shadow 180ms ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found-action {
      transition: none;
    }

    .not-found-action:hover {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .not-found-story,
    .not-found-action {
      border-color: CanvasText;
    }

    .not-found-action.primary {
      color: ButtonText;
      background: ButtonFace;
    }

    .not-found-eyebrow span {
      background: Highlight;
      box-shadow: none;
    }
  }
</style>
