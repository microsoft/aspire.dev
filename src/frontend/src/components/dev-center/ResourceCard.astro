---
import type { DevResource } from '../../utils/dev-center/resource-types';
import { resourceImages, type ResourceImages } from '../../utils/dev-center/resource-image';
import { resourceCardHtml } from '../../utils/dev-center/resource-card-html';
import '../../styles/link-underline.css';
import '../../styles/resource-card.css';

interface Props { resource: DevResource; image?: ResourceImages }
const { resource } = Astro.props;
const image = Astro.props.image ?? await resourceImages(resource);
const html = resourceCardHtml(resource, image);
---

<Fragment set:html={html} />
