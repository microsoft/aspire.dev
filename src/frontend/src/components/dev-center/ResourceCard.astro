---
import { getImage } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';
import type { DevResource } from '../../utils/dev-center/resource-types';
import { resourcePresentation } from '../../utils/dev-center/resource-presentation';
import { getTopic } from '../../utils/dev-center/topics';
import { resourceFacetLabel, resourceSearchEntry } from '../../utils/dev-center/resource-search';
import { stripSampleImageUrlSuffix } from '../../utils/samples';
import AspireLogo from '@assets/aspire-logo-32.svg';
import csharpIcon from '@assets/icons/csharp.svg';
import typescriptIcon from '@assets/icons/typescript.svg';
import javascriptIcon from '@assets/icons/javascript.svg';
import pythonIcon from '@assets/icons/python.svg';
import goIcon from '@assets/icons/go.svg';
import javaIcon from '@assets/icons/java.svg';
import rustIcon from '@assets/icons/rust.svg';
import '../../styles/link-underline.css';

interface Props { resource: DevResource }
const { resource } = Astro.props;
const presentation = resourcePresentation(resource);
const topic = getTopic(resource.topics[0]);
const titleId = `resource-${encodeURIComponent(resource.id)}`;
// Seed the grain placement by identity so filtering and pagination never reshuffle it.
const grainSeed = Array.from(resource.id).reduce((hash, character) => Math.imul(hash ^ character.charCodeAt(0), 16777619) >>> 0, 2166136261);
const grainEdge = grainSeed % 4;
const grainX = grainEdge === 0 ? 0 : grainEdge === 1 ? 100 : (grainSeed >>> 2) % 101;
const grainY = grainEdge === 2 ? 0 : grainEdge === 3 ? 100 : (grainSeed >>> 9) % 101;
const languageIcons: Record<string, ImageMetadata | undefined> = {
  csharp: csharpIcon, typescript: typescriptIcon, javascript: javascriptIcon,
  python: pythonIcon, go: goIcon, java: javaIcon, rust: rustIcon,
};
const languages = [...new Set(resource.languages.map((language) => language.toLowerCase()))];
const languageDescriptionId = `${titleId}-languages`;
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{png,jpg,jpeg,webp,avif}');
async function imageUrl(path: string): Promise<string> {
  if (!path.startsWith('~/assets/')) return path;
  const load = assets[stripSampleImageUrlSuffix(path).replace('~/', '/src/')];
  if (!load) throw new Error(`Missing resource thumbnail: ${path}`);
  const { default: image } = await load();
  return (await getImage({ src: image, width: 640, format: 'webp' })).src;
}
const image = resource.image && {
  light: await imageUrl(resource.image.light),
  dark: await imageUrl(resource.image.dark),
};
const artwork = !image || resource.image?.kind === 'logo';
const external = resource.href.startsWith('https://');
const date = resource.date && new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(new Date(resource.date));
---

<li class="browse-result" data-resource-entry={JSON.stringify(resourceSearchEntry(resource))} data-resource-type={resource.type} style={`--resource-accent: ${topic?.color ?? 'var(--sl-color-purple)'}; --grain-x: ${grainX}%; --grain-y: ${grainY}%`}>
  <a class="browse-card" data-underline-trigger href={resource.href} aria-labelledby={titleId} aria-describedby={languages.length ? languageDescriptionId : undefined}>
    <div class:list={['browse-card-preview', artwork && 'browse-card-artwork']} data-artwork={presentation.variant}>
      {image && !artwork ? (
        <>
          <img class="browse-image-light" src={image.light} alt="" width="640" height="360" loading="lazy" decoding="async" />
          {image.light !== image.dark && <img class="browse-image-dark" src={image.dark} alt="" width="640" height="360" loading="lazy" decoding="async" />}
        </>
      ) : !image && presentation.identifier ? (
        <div class="browse-artwork-detail" aria-hidden="true">
          {presentation.variant === 'release'
            ? <AspireLogo width="2rem" height="2rem" />
            : <Icon name={presentation.icon} size="1.75rem" />}
          <code data-search-highlight>{presentation.identifier}</code>
        </div>
      ) : (
        <>
          <div class="browse-artwork-symbol" aria-hidden="true">
            {image ? (
              <>
                <img class="browse-image-light" src={image.light} alt="" width="80" height="80" loading="lazy" decoding="async" />
                {image.light !== image.dark && <img class="browse-image-dark" src={image.dark} alt="" width="80" height="80" loading="lazy" decoding="async" />}
              </>
            ) : <Icon name={presentation.icon} size="3.5rem" />}
          </div>
        </>
      )}
      <div class="browse-card-badges">
        <span class="browse-card-kind">
          <Icon name={presentation.icon} size="1rem" />
          <span>{presentation.label}</span>
        </span>
        {languages.length > 0 && (
          <span class="browse-card-languages">
            <span class="sr-only" id={languageDescriptionId}>Languages: {languages.map(resourceFacetLabel).join(', ')}</span>
            {languages.map((language) => (
              <span class="browse-language" data-resource-language={language} title={resourceFacetLabel(language)} aria-hidden="true">
                {languageIcons[language]
                  ? <img src={languageIcons[language].src} alt="" width="18" height="18" loading="lazy" decoding="async" />
                  : <span>{resourceFacetLabel(language)}</span>}
              </span>
            ))}
          </span>
        )}
      </div>
    </div>
    <div class="browse-card-copy">
      <h3 id={titleId}><span data-link-underline data-search-highlight>{resource.title}</span></h3>
      <p data-search-highlight>{resource.description}</p>
      {(date || external) && <div class="browse-card-meta">
        {date && <time datetime={resource.date}>{date}</time>}
        {external && <Icon name="external" size="0.85rem" />}
      </div>}
    </div>
  </a>
</li>

<style>
  .browse-result { min-width: 0; }
  .browse-card {
    display: flex; flex-direction: column; align-items: stretch; height: 100%;
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.65rem;
    background: var(--sl-color-bg); color: var(--sl-color-text); text-decoration: none;
  }
  .browse-card:global(.external-link) { align-items: stretch; }
  .browse-card:global(.external-link)::after { content: none; }
  .browse-card:hover { border-color: var(--sl-color-gray-3); background: color-mix(in srgb, var(--resource-accent) 3%, var(--sl-color-bg)); }
  [data-link-underline] { display: inline-block; max-width: 100%; }
  .browse-card :global(mark.browse-search-match) {
    background: color-mix(in srgb, var(--sl-color-text-accent) 25%, var(--sl-color-bg)); color: var(--sl-color-accent-high);
    border-radius: 0.15em; padding: 0; box-decoration-break: clone;
  }
  .browse-card-copy { display: flex; flex-direction: column; flex: 1; gap: 0.6rem; padding: 1.1rem 1.25rem; min-width: 0; }
  .browse-card h3 { font-size: 1.1rem; line-height: 1.4; letter-spacing: -0.015em; overflow-wrap: anywhere; }
  .browse-card p {
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    font-size: 0.9375rem; line-height: 1.6; color: var(--sl-color-gray-2); overflow-wrap: anywhere;
  }
  .browse-card-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem;
    margin-top: auto; padding-top: 0.5rem; font-size: 0.75rem; color: var(--sl-color-gray-2);
  }
  .browse-card-badges {
    position: absolute; inset: auto 0.75rem 0.75rem; display: flex; align-items: end; justify-content: space-between; gap: 0.5rem;
  }
  .browse-card-kind {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.3rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.3rem;
    background: var(--sl-color-bg); color: var(--sl-color-text); font-size: 0.75rem; font-weight: 500; flex-shrink: 0;
  }
  .browse-card-languages { display: flex; flex-wrap: wrap; justify-content: end; align-items: center; gap: 0.25rem; min-width: 0; }
  .browse-language {
    display: inline-flex; align-items: center; justify-content: center; min-width: 1.75rem; height: 1.75rem; padding: 0.25rem;
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.3rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 65%, var(--sl-color-bg)); color: var(--sl-color-text); font-size: 0.65rem; font-weight: 600;
  }
  .browse-card-kind :global(svg) { flex-shrink: 0; }
  .browse-card-meta :global(svg) { margin-left: auto; flex-shrink: 0; }
  .browse-card-preview { position: relative; width: 100%; flex-shrink: 0; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 0.6rem 0.6rem 0 0; border-bottom: 1px solid var(--sl-color-gray-5); background: var(--sl-color-gray-6); }
  .browse-card-preview img { width: 100%; height: 100%; object-fit: contain; margin: 0; }
  .browse-language img { width: 1.125rem; height: 1.125rem; object-fit: contain; }
  :global([data-theme='dark']) .browse-language[data-resource-language='rust'] img { filter: invert(1); }
  .browse-image-dark { display: none; }
  :global([data-theme='dark']) .browse-card-preview:has(.browse-image-dark) .browse-image-light { display: none; }
  :global([data-theme='dark']) .browse-image-dark { display: block; }
  .browse-card-artwork {
    display: grid; place-items: center; isolation: isolate;
    background: color-mix(in srgb, var(--resource-accent) 10%, var(--sl-color-bg));
    color: var(--sl-color-text);
  }
  .browse-card-artwork::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: var(--resource-accent); opacity: 0.28;
    mask-image: url('../../assets/quickstart-grain.svg'),
      radial-gradient(ellipse at var(--grain-x) var(--grain-y), black, transparent 85%),
      radial-gradient(ellipse at center, transparent 18%, black 75%);
    mask-mode: luminance, alpha, alpha; mask-composite: intersect;
  }
  .browse-artwork-symbol {
    align-self: center; justify-self: center; display: grid; place-items: center;
    width: 5rem; height: 5rem; color: color-mix(in srgb, var(--resource-accent) 65%, var(--sl-color-white));
  }
  .browse-artwork-symbol img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .browse-artwork-detail {
    position: absolute; inset: 1rem 1rem 3.25rem;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem;
    text-align: center; color: var(--sl-color-text);
  }
  .browse-artwork-detail :global(svg) { flex-shrink: 0; }
  .browse-artwork-detail code {
    padding: 0; background: none; border: 0; color: inherit; font-family: var(--__sl-font-mono, monospace);
    font-size: 1.15rem; line-height: 1.35; font-weight: 600; overflow-wrap: anywhere; max-width: 100%;
  }
  [data-artwork='command'].browse-card-artwork { background: var(--sl-color-gray-6); }
  [data-artwork='diagnostic'] .browse-artwork-detail :global(svg) { color: var(--sl-color-orange-high); }
  [data-artwork='release'] .browse-artwork-detail code { font-size: 2rem; }
</style>
