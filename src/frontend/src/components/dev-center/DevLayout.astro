---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import '../../styles/dev-central.css';

interface Props {
  title: string;
  description: string;
  accent?: string;
  pageActions?: boolean;
  pagefind?: boolean;
  showDescription?: boolean;
  layout?: 'landing' | 'article';
  prev?: { label: string; link: string };
  next?: { label: string; link: string };
}

const { title, description, accent = 'var(--aspire-color-purple)', pageActions = true, pagefind = true, showDescription = true, layout = 'landing', prev, next } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
---

<StarlightPage
  frontmatter={{
    title,
    description,
    template: 'splash',
    prev: prev ?? false,
    next: next ?? false,
    tableOfContents: false,
    crumbs: false,
    lastUpdated: false,
    editUrl: false,
    giscus: false,
    pageActions,
    pagefind,
    ogImage: '/og-image.png',
  }}
>
  <div class="dev-center" data-dev-center style={`--dev-accent: ${accent}`}>
    {layout === 'landing' && (
      <>
        <div class="dev-breadcrumbs">
          <Breadcrumb crumbs={path === '/dev'
            ? [{ label: 'Home', href: '/' }, { label: 'Dev Hub' }]
            : [
              { label: 'Dev Hub', href: '/dev/', icon: 'dev-hub' },
              { label: path === '/dev/glossary' ? 'Glossary' : path === '/dev/browse' ? 'Resources' : title },
            ]} />
        </div>
        {showDescription && <p class="dev-description">{description}</p>}
      </>
    )}
    <slot />
  </div>
</StarlightPage>

<style is:global>
  html:has([data-dev-center]) {
    --sl-content-width: 76rem;
  }

  .dev-center .dev-description {
    margin: 0 0 1.25rem;
    max-width: 65ch;
    font-size: 1.05rem;
    color: var(--sl-color-gray-2);
    line-height: 1.65;
    font-weight: 400;
  }

  .dev-center {
    padding-bottom: 3rem;
    color: var(--sl-color-text);
  }

  .dev-center :where(h2, h3, p, ul) {
    margin: 0;
  }

  .dev-center :where(h2) {
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .dev-center :where(a) {
    text-underline-offset: 0.2em;
  }

  .dev-center :where(a, button, input, select, summary):focus-visible {
    outline: 3px solid var(--aspire-action-focus);
    outline-offset: 4px;
  }

  .dev-center :where(button, input, select) {
    font: inherit;
  }

  .dev-center :where(button) {
    cursor: pointer;
  }

  .dev-center :where([hidden]) {
    display: none !important;
  }

</style>
