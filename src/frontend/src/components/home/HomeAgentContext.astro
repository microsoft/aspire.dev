---
import { Image } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';

import claudeLogo from '@assets/icons/agent-claude.svg';
import openAiLogo from '@assets/icons/agent-openai.svg';
import { localizedHref } from '@utils/helpers';
import { getLocaleFromPath } from '@utils/locale-routes';

const t = Astro.locals.t;
const locale = getLocaleFromPath(Astro.url.pathname);

const contextLayers = [
  {
    title: t('home.agent.layerAppHostTitle'),
    description: t('home.agent.layerAppHostDescription'),
  },
  {
    title: t('home.agent.layerRuntimeTitle'),
    description: t('home.agent.layerRuntimeDescription'),
  },
  {
    title: t('home.agent.layerTelemetryTitle'),
    description: t('home.agent.layerTelemetryDescription'),
  },
] as const;

const agents = [
  {
    id: 'github-copilot',
    name: 'GitHub Copilot',
    icon: 'github',
    treatment: 'monochrome',
    routePath: 'M125 124 C170 156 235 176 310 194',
  },
  {
    id: 'claude',
    name: 'Claude',
    logo: claudeLogo,
    treatment: 'color',
    routePath: 'M360 124 C360 150 360 174 360 194',
  },
  {
    id: 'openai',
    name: 'OpenAI',
    logo: openAiLogo,
    treatment: 'monochrome',
    routePath: 'M595 124 C550 156 485 176 410 194',
  },
] as const;
---

<section
  class="home-section home-agent-context"
  aria-labelledby="home-agent-context-title"
  data-home-agent-context
>
  <div class="agent-grid" aria-hidden="true"></div>
  <div class="home-shell">
    <header class="agent-heading" data-home-reveal>
      <p class="section-index"><span>02</span> {t('home.agent.index')}</p>
      <div>
        <h2 id="home-agent-context-title">{t('home.agent.title')}</h2>
        <p>{t('home.agent.body')}</p>
      </div>
    </header>

    <div class="agent-layout">
      <div class="agent-copy" data-home-reveal>
        <ul class="agent-context-layers">
          {
            contextLayers.map((layer) => (
              <li>
                <h3>{layer.title}</h3>
                <p>{layer.description}</p>
              </li>
            ))
          }
        </ul>

        <a
          class="agent-link"
          href={localizedHref('/get-started/ai-coding-agents/', locale)}
          data-home-link
          data-home-link-icon
        >
          {t('home.agent.setupLink')}
          <Icon name="right-arrow" size="0.95rem" />
        </a>
      </div>

      <div
        class="agent-visual"
        data-home-reveal
        data-home-reveal-distance="major"
        data-home-reveal-anchor=".agent-network"
      >
        <div class="agent-network" data-agent-network>
          <svg
            class="agent-connections"
            viewBox="0 0 720 420"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <defs>
              <marker
                id="agent-route-arrow"
                viewBox="0 0 10 10"
                refX="5"
                refY="5"
                markerWidth="10"
                markerHeight="10"
                markerUnits="userSpaceOnUse"
                orient="auto-start-reverse"
              >
                <path class="agent-route-arrowhead" d="M1 1L5 5L1 9"></path>
              </marker>
            </defs>
            {
              agents.map((agent) => (
                <g class="agent-route" data-agent-route={agent.id}>
                  <path
                    class="agent-route-line"
                    d={agent.routePath}
                    marker-start="url(#agent-route-arrow)"
                    marker-end="url(#agent-route-arrow)"
                  />
                </g>
              ))
            }
          </svg>

          <div class="agent-core" aria-hidden="true">
            <span class="agent-core-icon">
              <Icon name="rocket" size="1.35rem" />
            </span>
            <small>Aspire</small>
            <strong>AppHost</strong>
            <p>{t('home.agent.coreCaption')}</p>
          </div>

          <ul class="agent-logo-list" aria-label={t('home.agent.anyTool')}>
            {
              agents.map((agent, index) => (
                <li class="agent-logo" data-agent-slot={String(index)}>
                  <div class="agent-logo-card" data-agent-logo={agent.id}>
                    {'icon' in agent ? (
                      <Icon name={agent.icon} size="3.25rem" class="agent-logo-icon" />
                    ) : (
                      <Image
                        src={agent.logo}
                        alt=""
                        width={72}
                        height={72}
                        class="agent-logo-image"
                        data-agent-logo-source="lobehub"
                        data-agent-logo-treatment={agent.treatment}
                        loading="lazy"
                      />
                    )}
                    <span class="agent-logo-name">{agent.name}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="agent-story">
          <p class="agent-story-sentence">{t('home.agent.statement')}</p>
          <p class="agent-any-ai-note">{t('home.agent.anyTool')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-agent-context {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 6.5vw, 6.5rem) 1.5rem;
    border-top: 1px solid var(--home-border);
    color: var(--home-text);
    background:
      radial-gradient(
        circle at 78% 46%,
        color-mix(in srgb, var(--home-purple) 12%, transparent),
        transparent 30rem
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--home-purple) 5%, var(--home-bg)),
        var(--home-bg) 42%
      );
  }

  .agent-grid {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background-image:
      linear-gradient(to right, var(--home-border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--home-border) 1px, transparent 1px);
    background-size: 5rem 5rem;
    mask-image: radial-gradient(circle at 76% 52%, #000, transparent 57%);
    pointer-events: none;
  }

  .home-shell {
    position: relative;
    width: min(100%, 84rem);
    margin-inline: auto;
  }

  .agent-heading {
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .section-index {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    color: var(--home-muted);
    font: 650 0.76rem/1.2 var(--__sl-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-index span {
    color: var(--home-purple);
  }

  .agent-heading h2 {
    max-width: 57rem;
    margin: 0;
    color: var(--home-text);
    font-size: clamp(2.7rem, 5vw, 4.75rem);
    font-weight: 620;
    line-height: 1.02;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .agent-heading > div > p {
    max-width: 51rem;
    margin: 1.4rem 0 0;
    color: var(--home-muted);
    font-size: clamp(1.02rem, 1.45vw, 1.22rem);
    line-height: 1.7;
  }

  .agent-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 5vw, 5rem);
    align-items: center;
    margin-top: clamp(2.75rem, 4vw, 3.75rem);
  }

  .agent-copy {
    min-width: 0;
  }

  .agent-context-layers {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--home-border);
    list-style: none;
  }

  .agent-context-layers li {
    display: grid;
    grid-template-columns: minmax(5rem, 0.55fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--home-border);
  }

  .agent-context-layers h3 {
    margin: 0;
    color: var(--home-text);
    font-size: 0.94rem;
    font-weight: 750;
    line-height: 1.3;
  }

  .agent-context-layers p {
    margin: 0;
    color: var(--home-muted);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .agent-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.75rem;
    color: var(--home-purple);
    font-size: 0.96rem;
    font-weight: 750;
    text-decoration: none;
  }

  .agent-link:focus-visible {
    outline: 0.1875rem solid var(--home-purple);
    outline-offset: 0.25rem;
    border-radius: 0.25rem;
  }

  .agent-visual {
    min-width: 0;
  }

  .agent-network {
    position: relative;
    min-height: 25.5rem;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--home-border);
    background:
      radial-gradient(
        circle at 50% 64%,
        color-mix(in srgb, var(--home-purple) 16%, transparent),
        transparent 38%
      ),
      color-mix(in srgb, var(--home-surface) 64%, transparent);
  }

  .agent-network::before {
    position: absolute;
    top: 64%;
    left: 50%;
    border: 1px solid color-mix(in srgb, var(--home-purple) 20%, transparent);
    border-radius: 50%;
    content: '';
    pointer-events: none;
    width: 19rem;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  .agent-network::after {
    display: none;
  }

  .agent-connections {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .agent-route {
    opacity: 1;
  }

  .agent-route > path {
    fill: none;
    stroke-width: 2.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .agent-route-line {
    stroke: var(--home-purple);
  }

  .agent-route-arrowhead {
    fill: none;
    stroke: var(--home-purple);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .agent-core {
    position: absolute;
    top: 64%;
    left: 50%;
    z-index: 3;
    width: 15rem;
    min-height: 10.5rem;
    display: grid;
    place-items: center;
    align-content: center;
    padding: 1.35rem;
    border: 1px solid color-mix(in srgb, var(--home-purple) 50%, var(--home-border));
    border-radius: 0.9rem;
    color: var(--home-text);
    background: color-mix(in srgb, var(--home-surface) 92%, transparent);
    box-shadow: 0 1.8rem 5rem color-mix(in srgb, var(--home-purple) 16%, transparent);
    transform: translate(-50%, -50%);
  }

  .agent-core-icon {
    position: relative;
    width: 2.65rem;
    height: 2.65rem;
    display: grid;
    place-items: center;
    margin-bottom: 0.8rem;
    border: 1px solid color-mix(in srgb, var(--home-purple) 42%, var(--home-border));
    border-radius: 50%;
    color: var(--home-purple);
    background: color-mix(in srgb, var(--home-purple) 9%, transparent);
  }

  .agent-core-icon::after {
    position: absolute;
    inset: -0.45rem;
    border: 1px solid color-mix(in srgb, var(--home-purple) 45%, transparent);
    border-radius: 50%;
    content: '';
    opacity: 0.45;
    transform: scale(1);
  }

  .agent-core small {
    color: var(--home-muted);
    font: 700 0.66rem/1.2 var(--__sl-font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .agent-core strong {
    margin-top: 0.3rem;
    font-size: 1.68rem;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .agent-core > p {
    margin: 0.42rem 0 0;
    color: var(--home-muted);
    font-size: 0.76rem;
    line-height: 1.4;
    text-align: center;
  }

  .agent-logo-list {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agent-logo {
    position: absolute;
    top: 2rem;
    width: 9rem;
    height: 7rem;
    transform: translateX(-50%);
  }

  .agent-logo-card {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-rows: 3.25rem auto;
    place-items: center;
    gap: 0.55rem;
    overflow: hidden;
    padding: 0.75rem 0.8rem;
    border: 1px solid var(--home-purple);
    border-radius: 0.75rem;
    color: inherit;
    background: color-mix(in srgb, var(--home-purple) 11%, var(--home-surface));
    box-shadow: 0 1rem 3rem rgba(17, 15, 35, 0.1);
    opacity: 1;
    transform: translateY(0);
  }

  .agent-logo-card :global(.agent-logo-image) {
    width: 3.25rem;
    height: 3.25rem;
    display: block;
    margin: 0;
    object-fit: contain;
  }

  .agent-logo-card :global(.agent-logo-icon) {
    width: 3.25rem;
    height: 3.25rem;
    color: var(--home-text);
  }

  .agent-logo-name {
    color: var(--home-text);
    font-size: 0.72rem;
    font-weight: 750;
    line-height: 1.2;
    text-align: center;
  }

  :global([data-theme='dark'])
    .agent-logo-card
    :global(.agent-logo-image[data-agent-logo-treatment='monochrome']) {
    filter: invert(1);
  }

  .agent-logo[data-agent-slot='0'] {
    left: 16.666%;
  }

  .agent-logo[data-agent-slot='1'] {
    left: 50%;
  }

  .agent-logo[data-agent-slot='2'] {
    left: 83.333%;
  }

  .agent-story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.4rem clamp(1.25rem, 3vw, 2rem);
    border-block: 1px solid var(--home-border);
    color: var(--home-text);
    background: color-mix(in srgb, var(--home-surface) 82%, transparent);
  }

  .agent-story-sentence {
    max-width: 55rem;
    margin: 0;
    color: var(--home-text);
    font-size: clamp(1.05rem, 1.45vw, 1.28rem);
    font-weight: 560;
    line-height: 1.55;
    text-wrap: balance;
  }

  .agent-story p.agent-any-ai-note {
    justify-self: end;
    margin: 0 0 0.15rem;
    color: var(--home-muted);
    font: 700 0.68rem/1.35 var(--__sl-font-mono);
    letter-spacing: 0.08em;
    text-align: right;
    text-transform: uppercase;
    text-wrap: nowrap;
    white-space: nowrap;
  }

  @media (max-width: 71.99rem) {
    .agent-heading,
    .agent-layout {
      grid-template-columns: 1fr;
    }

    .agent-heading {
      gap: 1.5rem;
    }

    .agent-layout {
      gap: 4rem;
    }

    .agent-visual {
      width: min(100%, 56rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 49.99rem) {
    .home-agent-context {
      padding: 4.5rem 1rem;
    }

    .agent-heading h2 {
      font-size: clamp(2.5rem, 11vw, 3.65rem);
    }

    .agent-layout {
      margin-top: 2.75rem;
    }

    .agent-network {
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
      border-bottom: 1px solid var(--home-border);
    }

    .agent-network::before,
    .agent-network::after,
    .agent-connections {
      display: none;
    }

    .agent-core {
      position: relative;
      inset: auto;
      width: 100%;
      min-height: 11.5rem;
      transform: none;
    }

    .agent-logo-list {
      position: relative;
      inset: auto;
      order: -1;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.55rem;
    }

    .agent-logo[data-agent-slot] {
      position: relative;
      inset: auto;
      left: auto;
      width: 100%;
      height: 7rem;
      transform: none;
    }

    .agent-logo-card {
      grid-template-rows: auto auto;
      align-content: center;
      padding: 0.65rem 0.45rem;
    }

    .agent-logo-card :global(.agent-logo-image) {
      width: 2.75rem;
      height: 2.75rem;
    }

    .agent-logo-card :global(.agent-logo-icon) {
      width: 2.75rem;
      height: 2.75rem;
    }

    .agent-story {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.25rem;
    }

    .agent-story-sentence {
      font-size: 1rem;
      text-wrap: pretty;
    }

    .agent-story p.agent-any-ai-note {
      font-size: 0.66rem;
    }
  }

  @media (max-width: 24rem) {
    .agent-context-layers li {
      grid-template-columns: 1fr;
      gap: 0.28rem;
    }

    .agent-core strong {
      font-size: 1.35rem;
    }

    .agent-story {
      padding-inline: 0.9rem;
    }
  }

  @media (forced-colors: active) {
    .agent-context-layers,
    .agent-context-layers li,
    .agent-network,
    .agent-core,
    .agent-core-icon,
    .agent-logo-card,
    .agent-story {
      border-color: CanvasText;
    }

    .agent-core,
    .agent-logo-card,
    .agent-story {
      background: Canvas;
    }

    .agent-route-line,
    .agent-route-arrowhead {
      stroke: CanvasText;
    }

    .agent-route-arrowhead {
      fill: none;
    }

    .agent-logo-card :global(.agent-logo-image) {
      forced-color-adjust: none;
    }
  }
</style>
