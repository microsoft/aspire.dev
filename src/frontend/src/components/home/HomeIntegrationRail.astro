---
import { Image } from 'astro:assets';
import PauseIcon from '@assets/icons/pause.svg';
import PlayIcon from '@assets/icons/play.svg';
import activeMq from '@assets/icons/activemq-icon.png';
import activeMqLight from '@assets/icons/activemq-light-icon.png';
import aws from '@assets/icons/aws-icon.png';
import awsLight from '@assets/icons/aws-light-icon.png';
import azureAiFoundry from '@assets/icons/azure-ai-foundry-icon.png';
import azureCosmosDb from '@assets/icons/azure-cosmosdb-icon.png';
import azure from '@assets/icons/azure-icon.png';
import azureServiceBus from '@assets/icons/azure-servicebus-icon.png';
import bun from '@assets/icons/bun-icon.png';
import dapr from '@assets/icons/dapr-icon.png';
import daprLight from '@assets/icons/dapr-light-icon.png';
import deno from '@assets/icons/deno-icon.png';
import denoLight from '@assets/icons/deno-light-icon.png';
import docker from '@assets/icons/docker.svg';
import elasticsearch from '@assets/icons/elastic-icon.png';
import go from '@assets/icons/go-icon.png';
import goLight from '@assets/icons/go-light-icon.png';
import github from '@assets/icons/github-icon.png';
import githubLight from '@assets/icons/github-light-icon.png';
import java from '@assets/icons/java-icon.png';
import keycloak from '@assets/icons/keycloak-icon.svg';
import kubernetes from '@assets/icons/kubernetes.svg';
import kurrentDb from '@assets/icons/kurrent-icon.png';
import kurrentDbLight from '@assets/icons/kurrent-light-icon.png';
import meilisearch from '@assets/icons/meilisearch-icon.png';
import milvus from '@assets/icons/milvus-icon.png';
import minio from '@assets/icons/minio-icon.png';
import mongodb from '@assets/icons/mongodb-icon.png';
import mysql from '@assets/icons/mysqlconnector-icon.png';
import nats from '@assets/icons/nats-icon.png';
import nodeJs from '@assets/icons/nodejs-icon.png';
import nodeJsLight from '@assets/icons/nodejs-light-icon.png';
import ollama from '@assets/icons/ollama-icon.png';
import openAi from '@assets/icons/openai-icon.png';
import openAiLight from '@assets/icons/openai-light-icon.png';
import postgresql from '@assets/icons/postgresql-icon.png';
import python from '@assets/icons/python.svg';
import qdrant from '@assets/icons/qdrant-icon.svg';
import rabbitMq from '@assets/icons/rabbitmq-icon.svg';
import react from '@assets/icons/react-icon.svg';
import redis from '@assets/icons/redis-icon.png';
import rust from '@assets/icons/rust-icon.png';
import seq from '@assets/icons/seq-icon.png';
import sqlite from '@assets/icons/sqlite-icon.png';
import typescript from '@assets/icons/typescript.svg';
import { localizedHref } from '@utils/helpers';

const foundationIntegrations = [
  { name: 'Redis', icon: redis, search: 'redis' },
  { name: 'PostgreSQL', icon: postgresql, search: 'postgresql' },
  { name: 'Docker', icon: docker, search: 'docker' },
  { name: 'Kubernetes', icon: kubernetes, search: 'kubernetes' },
  { name: 'Python', icon: python, search: 'python' },
  { name: 'React', icon: react, search: 'nodejs' },
  { name: 'RabbitMQ', icon: rabbitMq, search: 'rabbitmq' },
  { name: 'Azure', icon: azure, search: 'azure' },
  { name: 'AWS', icon: aws, lightIcon: awsLight, search: 'aws' },
  { name: 'GitHub', icon: github, lightIcon: githubLight, search: 'github' },
  { name: 'OpenAI', icon: openAi, lightIcon: openAiLight, search: 'openai' },
  { name: 'ActiveMQ', icon: activeMq, lightIcon: activeMqLight, search: 'activemq' },
] as const;

const dataIntegrations = [
  { name: 'MongoDB', icon: mongodb, search: 'mongodb' },
  { name: 'MySQL', icon: mysql, search: 'mysql' },
  { name: 'SQLite', icon: sqlite, search: 'sqlite' },
  { name: 'NATS', icon: nats, search: 'nats' },
  { name: 'Dapr', icon: dapr, lightIcon: daprLight, search: 'dapr' },
  { name: 'Keycloak', icon: keycloak, search: 'keycloak' },
  { name: 'MinIO', icon: minio, search: 'minio' },
  { name: 'Meilisearch', icon: meilisearch, search: 'meilisearch' },
  { name: 'Elasticsearch', icon: elasticsearch, search: 'elasticsearch' },
  { name: 'Ollama', icon: ollama, search: 'ollama' },
  { name: 'Qdrant', icon: qdrant, search: 'qdrant' },
  { name: 'Milvus', icon: milvus, search: 'milvus' },
] as const;

const runtimeIntegrations = [
  { name: 'Node.js', icon: nodeJs, lightIcon: nodeJsLight, search: 'nodejs' },
  { name: 'Bun', icon: bun, search: 'bun' },
  { name: 'Deno', icon: deno, lightIcon: denoLight, search: 'deno' },
  { name: 'Go', icon: go, lightIcon: goLight, search: 'golang gofeature' },
  { name: 'Java', icon: java, search: 'java' },
  { name: 'Rust', icon: rust, search: 'rust' },
  { name: 'TypeScript', icon: typescript, search: 'typescript' },
  { name: 'Azure Cosmos DB', icon: azureCosmosDb, search: 'cosmos' },
  { name: 'Azure Service Bus', icon: azureServiceBus, search: 'servicebus' },
  { name: 'Microsoft Foundry', icon: azureAiFoundry, search: 'foundry' },
  { name: 'Seq', icon: seq, search: 'seq' },
  {
    name: 'KurrentDB',
    icon: kurrentDb,
    lightIcon: kurrentDbLight,
    search: 'kurrentdb',
  },
] as const;

const lanes = [
  { direction: 'left', duration: '58s', integrations: foundationIntegrations },
  {
    direction: 'right',
    duration: '64s',
    integrations: dataIntegrations,
  },
  {
    direction: 'left',
    duration: '61s',
    integrations: runtimeIntegrations,
  },
] as const;

const t = Astro.locals.t;
const locale = Astro.locals.starlightRoute?.locale;
const pauseLabel = t('home.integrationRail.pauseAnimation');
const playLabel = t('home.integrationRail.playAnimation');
---

<div class="integration-rail" data-home-integration-rail>
  <div class="rail-lanes">
    {
      lanes.map((lane) => (
        <div
          class="rail-viewport"
          data-rail-direction={lane.direction}
          style={`--rail-duration: ${lane.duration}`}
        >
          <div class="rail-track">
            <div class="rail-group">
              {lane.integrations.map((integration) => (
                <a
                  href={localizedHref(
                    `/integrations/gallery/?search=${encodeURIComponent(integration.search)}`,
                    locale
                  )}
                  class="integration-logo"
                  data-integration-name={integration.name}
                  aria-label={t('integrations.explore', { integration: integration.name })}
                >
                  {'lightIcon' in integration ? (
                    <>
                      <Image
                        src={integration.icon}
                        alt=""
                        class="integration-icon integration-icon-dark"
                      />
                      <Image
                        src={integration.lightIcon}
                        alt=""
                        class="integration-icon integration-icon-light"
                      />
                    </>
                  ) : (
                    <Image src={integration.icon} alt="" class="integration-icon" />
                  )}
                </a>
              ))}
            </div>
            <div class="rail-group" aria-hidden="true">
              {lane.integrations.map((integration) => (
                <a
                  href={localizedHref(
                    `/integrations/gallery/?search=${encodeURIComponent(integration.search)}`,
                    locale
                  )}
                  class="integration-logo"
                  data-integration-name={integration.name}
                  tabindex="-1"
                >
                  {'lightIcon' in integration ? (
                    <>
                      <Image
                        src={integration.icon}
                        alt=""
                        class="integration-icon integration-icon-dark"
                      />
                      <Image
                        src={integration.lightIcon}
                        alt=""
                        class="integration-icon integration-icon-light"
                      />
                    </>
                  ) : (
                    <Image src={integration.icon} alt="" class="integration-icon" />
                  )}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <button
    type="button"
    class="rail-control"
    data-rail-control
    aria-label={pauseLabel}
    aria-pressed="false"
    title={pauseLabel}
    data-label-pause={pauseLabel}
    data-label-play={playLabel}
  >
    <span data-rail-control-pause aria-hidden="true">
      <PauseIcon width="20" height="20" />
    </span>
    <span data-rail-control-play aria-hidden="true" hidden>
      <PlayIcon width="20" height="20" />
    </span>
  </button>
</div>

<script>
  import { createViewportActivationObserver } from '@utils/viewport-activation';

  function initializeIntegrationRails() {
    document.querySelectorAll('[data-home-integration-rail]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.initialized === 'true') return;
      const control = root.querySelector('[data-rail-control]');
      if (!(control instanceof HTMLButtonElement)) return;
      const pauseIcon = control.querySelector('[data-rail-control-pause]');
      const playIcon = control.querySelector('[data-rail-control-play]');
      if (!(pauseIcon instanceof HTMLElement) || !(playIcon instanceof HTMLElement)) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mobileViewport = window.matchMedia('(max-width: 49.999rem)');
      const laneViewports = Array.from(root.querySelectorAll<HTMLElement>('.rail-viewport'));
      const interactionTimers = new Map<HTMLElement, number>();
      let manuallyPaused = false;
      let isVisible = false;
      let documentVisible = document.visibilityState === 'visible';

      function getMobileScrollLimit(viewport: HTMLElement) {
        const group = viewport.querySelector<HTMLElement>('.rail-group');
        return Math.max(0, (group?.scrollWidth ?? 0) - viewport.clientWidth);
      }

      function stopInteraction(viewport: HTMLElement) {
        const timer = interactionTimers.get(viewport);
        if (timer) window.clearTimeout(timer);
        interactionTimers.delete(viewport);
        viewport.removeAttribute('data-rail-interacting');
      }

      function markInteraction(viewport: HTMLElement) {
        if (!mobileViewport.matches) return;
        const timer = interactionTimers.get(viewport);
        if (timer) window.clearTimeout(timer);
        viewport.setAttribute('data-rail-interacting', '');
        interactionTimers.set(
          viewport,
          window.setTimeout(() => stopInteraction(viewport), 900)
        );
      }

      function syncMobileLanes() {
        for (const viewport of laneViewports) {
          if (!mobileViewport.matches) {
            stopInteraction(viewport);
            viewport.scrollLeft = 0;
            delete viewport.dataset.mobilePositioned;
            continue;
          }

          const limit = getMobileScrollLimit(viewport);
          if (viewport.dataset.mobilePositioned !== 'true') {
            viewport.dataset.mobilePositioned = 'true';
            viewport.scrollLeft = limit / 2;
          } else {
            viewport.scrollLeft = Math.min(Math.max(0, viewport.scrollLeft), limit);
          }
        }
      }

      function update() {
        const paused = manuallyPaused || reducedMotion.matches;
        const label = paused
          ? (control.dataset.labelPlay ?? 'Play integration animation')
          : (control.dataset.labelPause ?? 'Pause integration animation');
        root.classList.toggle('paused', paused);
        root.toggleAttribute('data-rail-motion-active', isVisible && documentVisible && !paused);
        control.hidden = reducedMotion.matches;
        control.setAttribute('aria-pressed', String(paused));
        control.setAttribute('aria-label', label);
        control.setAttribute('title', label);
        pauseIcon.hidden = paused;
        playIcon.hidden = !paused;
        syncMobileLanes();
      }

      const toggle = () => {
        manuallyPaused = !manuallyPaused;
        update();
      };
      const handlePreference = () => update();
      const handleViewport = () => update();
      const handleVisibility = () => {
        documentVisible = document.visibilityState === 'visible';
        update();
      };
      const laneListeners = laneViewports.map((viewport) => {
        const handlePointerDown = () => markInteraction(viewport);
        const handleScroll = () => {
          if (!mobileViewport.matches) return;
          const limit = getMobileScrollLimit(viewport);
          if (viewport.scrollLeft > limit) viewport.scrollLeft = limit;
          if (viewport.scrollLeft < 0) viewport.scrollLeft = 0;
          markInteraction(viewport);
        };

        viewport.addEventListener('pointerdown', handlePointerDown, { passive: true });
        viewport.addEventListener('scroll', handleScroll, { passive: true });

        return { viewport, handlePointerDown, handleScroll };
      });
      const motionObserver = createViewportActivationObserver(
        (_, active) => {
          isVisible = active;
          update();
        },
        { requireComplete: false, waitForReveal: false }
      );
      const resizeObserver =
        'ResizeObserver' in window ? new ResizeObserver(() => syncMobileLanes()) : null;
      const cleanup = () => {
        control.removeEventListener('click', toggle);
        reducedMotion.removeEventListener('change', handlePreference);
        mobileViewport.removeEventListener('change', handleViewport);
        document.removeEventListener('visibilitychange', handleVisibility);
        laneListeners.forEach(({ viewport, handlePointerDown, handleScroll }) => {
          viewport.removeEventListener('pointerdown', handlePointerDown);
          viewport.removeEventListener('scroll', handleScroll);
          stopInteraction(viewport);
        });
        motionObserver.disconnect();
        resizeObserver?.disconnect();
        root.removeAttribute('data-rail-motion-active');
        delete root.dataset.initialized;
      };

      control.addEventListener('click', toggle);
      reducedMotion.addEventListener('change', handlePreference);
      mobileViewport.addEventListener('change', handleViewport);
      document.addEventListener('visibilitychange', handleVisibility);
      motionObserver.observe(root);
      resizeObserver?.observe(root);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
      root.dataset.initialized = 'true';
      update();
    });
  }

  document.addEventListener('astro:page-load', initializeIntegrationRails);
  initializeIntegrationRails();
</script>

<style>
  .integration-rail {
    display: grid;
    gap: 1rem;
    margin-top: clamp(3.5rem, 6vw, 5rem);
  }

  .rail-lanes {
    display: grid;
    gap: 1rem;
  }

  .rail-viewport {
    min-width: 0;
    margin-block: -0.625rem;
    padding-block: 0.625rem;
    overflow-x: clip;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .rail-track {
    display: flex;
    width: max-content;
    backface-visibility: hidden;
  }

  .rail-group {
    display: flex;
    flex: none;
    gap: 1rem;
    padding-right: 1rem;
  }

  .integration-logo {
    position: relative;
    z-index: 0;
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(5rem, 8vw, 7rem);
    aspect-ratio: 1;
    margin: 0;
    padding: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--home-border);
    border-radius: 1rem;
    background: var(--home-surface);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--home-text) 6%, transparent);
  }

  a.integration-logo:hover,
  a.integration-logo:focus-visible {
    z-index: 2;
    border-color: color-mix(in srgb, var(--home-accent) 62%, var(--home-border));
  }

  a.integration-logo:focus-visible {
    outline: 0.1875rem solid var(--home-accent);
    outline-offset: 0.2rem;
  }

  .integration-logo :global(.integration-icon) {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    display: block;
    object-fit: contain;
  }

  .integration-logo :global(.integration-icon-light) {
    display: none;
  }

  :global([data-theme='light']) .integration-logo :global(.integration-icon-dark) {
    display: none;
  }

  :global([data-theme='light']) .integration-logo :global(.integration-icon-light) {
    display: block;
  }

  .rail-control {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0;
    border: 1px solid var(--home-border);
    border-radius: 0.625rem;
    background: var(--home-surface);
    color: var(--home-text);
    cursor: pointer;
  }

  .rail-control:hover {
    border-color: color-mix(in srgb, var(--home-accent) 62%, var(--home-border));
  }

  .rail-control:focus-visible {
    outline: 0.1875rem solid var(--home-accent);
    outline-offset: 0.2rem;
  }

  .rail-control[hidden] {
    display: none;
  }

  .rail-control > span {
    display: grid;
    place-items: center;
    line-height: 0;
  }

  .rail-control > span[hidden] {
    display: none;
  }

  .rail-control :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  @keyframes integration-scroll-left {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes integration-scroll-right {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rail-track {
      animation-duration: var(--rail-duration);
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-play-state: paused;
      will-change: transform;
    }

    .integration-rail[data-rail-motion-active] .rail-track {
      animation-play-state: running;
    }

    .rail-viewport[data-rail-direction='left'] .rail-track {
      animation-name: integration-scroll-left;
    }

    .rail-viewport[data-rail-direction='right'] .rail-track {
      animation-name: integration-scroll-right;
    }

    .integration-logo,
    .rail-control {
      transition:
        border-color 180ms ease,
        opacity 180ms ease,
        transform 180ms ease;
    }

    a.integration-logo:hover,
    a.integration-logo:focus-visible {
      transform: translateY(-2px) scale(1.025);
    }

    .rail-control:active {
      transform: translateY(1px);
    }

    .integration-rail.paused .rail-track {
      animation-play-state: paused;
    }

    .rail-viewport[data-rail-interacting] .rail-track {
      animation-play-state: paused;
    }
  }

  @media (max-width: 49.999rem) {
    .integration-rail {
      margin-top: 3rem;
    }

    .rail-lanes {
      display: grid;
      gap: 0.7rem;
    }

    .rail-viewport {
      margin-block: -0.5rem;
      padding-block: 0.5rem;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
      touch-action: pan-x pan-y;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 14%,
        black 86%,
        transparent 100%
      );
      mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%);
    }

    .rail-viewport::-webkit-scrollbar {
      display: none;
    }

    .rail-group {
      gap: 0.7rem;
      padding-right: 0.7rem;
    }

    .integration-logo {
      width: clamp(4.4rem, 21vw, 5.25rem);
      padding: clamp(0.85rem, 4vw, 1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-viewport[data-rail-direction] .rail-track {
      animation: none;
      transform: none;
      will-change: auto;
    }

    .integration-logo,
    .rail-control {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .integration-logo,
    .rail-control {
      border-color: CanvasText;
    }
  }
</style>
