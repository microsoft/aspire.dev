---
import { Image } from 'astro:assets';
import { Code } from 'astro:components';
import { Icon } from '@astrojs/starlight/components';

import aspireLogo from '@assets/aspire-logo-32.svg';
import csharpIcon from '@assets/icons/csharp.svg';
import dockerIcon from '@assets/icons/docker.svg';
import garnetIcon from '@assets/icons/garnet-icon.png';
import goIcon from '@assets/icons/go-light-icon.png';
import javaIcon from '@assets/icons/java.svg';
import javascriptIcon from '@assets/icons/javascript.svg';
import mongodbIcon from '@assets/icons/mongodb-icon.png';
import mysqlIcon from '@assets/icons/mysqlconnector-icon.png';
import PauseIcon from '@assets/icons/pause.svg';
import PlayIcon from '@assets/icons/play.svg';
import postgresqlIcon from '@assets/icons/postgresql-icon.png';
import pythonIcon from '@assets/icons/python.svg';
import reactIcon from '@assets/icons/react-icon.svg';
import redisIcon from '@assets/icons/redis-icon.png';
import rustIcon from '@assets/icons/rust-icon.png';
import sqliteIcon from '@assets/icons/sqlite-icon.png';
import typescriptIcon from '@assets/icons/typescript.svg';
import valkeyIcon from '@assets/icons/valkey-icon.png';
import DashboardCarousel from '@components/DashboardCarousel.astro';
import HomeAgentBadge from './HomeAgentBadge.astro';
import HomeAgentContext from './HomeAgentContext.astro';
import HomeEnvironment from './HomeEnvironment.astro';
import HomeIntegrationRail from './HomeIntegrationRail.astro';
import HomeTestimonials from './HomeTestimonials.astro';

const languages = [
  { name: 'C#', icon: csharpIcon },
  { name: 'TypeScript', icon: typescriptIcon },
  { name: 'JavaScript', icon: javascriptIcon },
  { name: 'Python', icon: pythonIcon },
  { name: 'Java', icon: javaIcon },
  { name: 'Go', icon: goIcon },
  { name: 'Rust', icon: rustIcon },
  { name: 'Containers', icon: dockerIcon },
] as const;

const modelCodeThemes = { light: 'catppuccin-latte', dark: 'laserwave' } as const;

const modelAppHostTypescript = `import { createBuilder } from "./.aspire/modules/aspire.mjs";

const builder = await createBuilder();
const postgres = await builder
    .addPostgres("postgres")
    .addDatabase("catalogdb");
const cache = await builder.addRedis("basketcache");

const catalog = await builder
    .addNodeApp("catalogservice", "./catalog", "src/index.ts")
    .withReference(postgres);

await builder.addViteApp("frontend", "./frontend")
    .withReference(catalog)
    .withReference(cache);

await builder.build().run();
`;

const modelAppHostCsharp = `var builder = DistributedApplication.CreateBuilder(args);

var postgres = builder.AddPostgres("postgres")
    .AddDatabase("catalogdb");
var cache = builder.AddRedis("basketcache");

var catalog = builder
    .AddProject<Projects.CatalogService>("catalogservice")
    .WithReference(postgres);

builder.AddProject<Projects.Frontend>("frontend")
    .WithReference(catalog)
    .WithReference(cache);

builder.Build().Run();
`;

const frontendResourceIcons = [reactIcon, typescriptIcon, javascriptIcon] as const;
const apiResourceIcons = [csharpIcon, javaIcon, pythonIcon, goIcon] as const;
const databaseResourceIcons = [postgresqlIcon, mongodbIcon, mysqlIcon, sqliteIcon] as const;
const cacheResourceIcons = [redisIcon, valkeyIcon, garnetIcon] as const;
const modelResourceMotion = {
  frontend: { duration: 10.8, offset: -1.4 },
  api: { duration: 13.6, offset: -5.7 },
  database: { duration: 11.9, offset: -8.2 },
  cache: { duration: 15.2, offset: -3.3 },
} as const;

const getModelResourceDelay = (
  resource: keyof typeof modelResourceMotion,
  count: number,
  index: number
) => {
  const motion = modelResourceMotion[resource];
  return motion.offset + index * (motion.duration / count);
};

const principles = [
  {
    number: '01',
    icon: 'laptop',
    title: 'Model the app in code',
    description:
      'Define services, containers, data stores, references, and configuration in a readable AppHost.',
    href: '/get-started/app-host/',
    label: 'Explore the AppHost',
  },
  {
    number: '02',
    icon: 'rocket',
    title: 'Run the whole system',
    description:
      'Start every dependency together, with service discovery, local endpoints, and dev-time configuration already connected.',
    href: '/reference/cli/commands/aspire-run/',
    label: 'Learn about aspire run',
  },
  {
    number: '03',
    icon: 'magnifier',
    title: 'Observe from the first request',
    description:
      'Use built-in OpenTelemetry to move from a resource to its logs, traces, metrics, and health without extra setup.',
    href: '/dashboard/',
    label: 'Explore the dashboard',
  },
  {
    number: '04',
    icon: 'star',
    title: 'Deploy without losing the model',
    description:
      'Create deployment artifacts for cloud services, containers, Kubernetes, or the infrastructure path your team already uses.',
    href: '/deployment/',
    label: 'Explore deployment options',
  },
] as const;
---

<div class="aspire-home not-content">
  <section class="home-section home-languages" aria-labelledby="home-languages-title">
    <div class="home-shell">
      <header class="language-heading" data-home-reveal>
        <p class="section-index"><span>01</span> Polyglot by design</p>
        <div>
          <h2 id="home-languages-title">Bring every service into the same picture.</h2>
          <p>
            Keep each part of the application in the language and framework that fits it. Aspire
            gives the whole stack one model and one workflow.
          </p>
        </div>
      </header>

      <ul
        class="language-list"
        aria-label="Languages and workloads supported by Aspire"
        data-language-list
      >
        {
          languages.map((language, index) => (
            <li data-home-reveal style={`--home-reveal-delay: ${index * 45}ms`}>
              <Image src={language.icon} alt="" class="language-icon" width="48" height="48" />
              <span>{language.name}</span>
            </li>
          ))
        }
      </ul>
      <a
        class="text-link"
        href="/get-started/resources/"
        data-home-link
        data-home-link-icon
        data-home-reveal
      >
        Explore application resources
        <Icon name="right-arrow" size="1rem" />
      </a>
    </div>
  </section>
  <HomeAgentContext />

  <section class="home-section home-model" aria-labelledby="home-model-title">
    <div class="home-shell">
      <header class="section-heading split-heading" data-home-reveal>
        <p class="section-index"><span>03</span> One application model</p>
        <div>
          <h2 id="home-model-title">Go from repository to running system without the glue work.</h2>
          <p>
            The AppHost is the source of truth for how the application fits together. Aspire uses
            that model throughout development, diagnostics, and deployment.
          </p>
          <HomeAgentBadge
            id="model-ai-context"
            label="Built for your AI agent"
            description="Aspire gives connected AI tools the resource graph, references, configuration, and commands represented here."
          />
        </div>
      </header>

      <div class="model-layout">
        <div
          class="model-proof"
          data-home-reveal
          data-home-reveal-distance="major"
          data-model-story
          data-story-stage="code"
          data-story-language="typescript"
        >
          <div class="model-terminal">
            <div class="model-window" aria-hidden="true">
              <div class="model-window-bar" aria-hidden="true">
                <span><i></i><i></i><i></i></span>
                <strong>terminal</strong>
                <small>aspire-shop</small>
              </div>
              <pre><code><span class="terminal-line terminal-command"><span>$</span> <b data-terminal-command data-command="aspire run">aspire run</b><i class="terminal-caret" /></span>
<span class="terminal-line" data-terminal-output data-stage="code"><span class="term-ok">&check;</span> Building apphost&hellip;</span>
<span class="terminal-line" data-terminal-output data-stage="topology"><span class="term-ok">&check;</span> Starting dashboard&hellip;</span>
<span class="terminal-line term-grid" data-terminal-output data-stage="topology"><em class="term-key">AppHost</em><span class="term-val">AspireShop.AppHost</span></span>
<span class="terminal-line term-grid" data-terminal-output data-stage="dashboard"><em class="term-key">Dashboard</em><a class="term-link" tabindex="-1">https://localhost:17178/login?t=b3f9c1e0</a></span>
<span class="terminal-line term-grid" data-terminal-output data-stage="dashboard"><em class="term-key">Logs</em><span class="term-val">~/.aspire/cli/logs/apphost-2f8c.log</span></span>
<span class="terminal-line term-hint" data-terminal-output data-stage="dashboard">Press <b>CTRL+C</b> to stop the apphost and exit.</span></code></pre>
            </div>

            <button
              type="button"
              class="model-story-toggle"
              data-model-story-toggle
              data-paused="false"
              aria-label="Pause runtime story"
              aria-pressed="false"
            >
              <span class="model-story-pause-icon" aria-hidden="true">
                <PauseIcon />
              </span>
              <span class="model-story-play-icon" aria-hidden="true">
                <PlayIcon />
              </span>
            </button>
          </div>

          <p class="model-story-summary">
            Running aspire run turns the AppHost application model into a live resource topology,
            then exposes every healthy resource in the Aspire dashboard.
          </p>

          <div class="model-story-stage">
            <div class="model-story-progress" role="group" aria-label="Choose a runtime stage">
              <button
                type="button"
                class="model-story-tab"
                data-model-stage-label="code"
                data-active="true"
                aria-pressed="true"
              >
                <span class="model-tab-icon model-tab-lang" aria-hidden="true">
                  <Image
                    src={typescriptIcon}
                    alt=""
                    class="model-tab-lang-icon model-tab-lang-typescript"
                    width="18"
                    height="18"
                    loading="eager"
                  />
                  <Image
                    src={csharpIcon}
                    alt=""
                    class="model-tab-lang-icon model-tab-lang-csharp"
                    width="18"
                    height="18"
                    loading="eager"
                  />
                </span>
                <span class="model-tab-text">AppHost</span>
              </button>
              <button
                type="button"
                class="model-story-tab"
                data-model-stage-label="topology"
                data-active="false"
                aria-pressed="false"
              >
                <span class="model-tab-icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    focusable="false"
                  >
                    <rect width="6" height="6" x="16" y="16" rx="1"></rect>
                    <rect width="6" height="6" x="2" y="16" rx="1"></rect>
                    <rect width="6" height="6" x="9" y="2" rx="1"></rect>
                    <path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3m-7-4V8"></path>
                  </svg>
                </span>
                <span class="model-tab-text">Topology</span>
              </button>
              <button
                type="button"
                class="model-story-tab"
                data-model-stage-label="dashboard"
                data-active="false"
                aria-pressed="false"
              >
                <span class="model-tab-icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    focusable="false"
                  >
                    <rect width="7" height="9" x="3" y="3" rx="1"></rect>
                    <rect width="7" height="5" x="14" y="3" rx="1"></rect>
                    <rect width="7" height="9" x="14" y="12" rx="1"></rect>
                    <rect width="7" height="5" x="3" y="16" rx="1"></rect>
                  </svg>
                </span>
                <span class="model-tab-text">Dashboard</span>
              </button>
            </div>

            <div class="model-story-viewport" aria-hidden="true">
              <div class="model-story-panel model-code" data-story-panel="code">
                <div class="model-code-variant" data-model-code-language="typescript">
                  <Code code={modelAppHostTypescript} lang="typescript" themes={modelCodeThemes} />
                </div>

                <div class="model-code-variant" data-model-code-language="csharp">
                  <Code code={modelAppHostCsharp} lang="csharp" themes={modelCodeThemes} />
                </div>
              </div>

              <div
                class="model-story-panel model-graph"
                data-story-panel="topology"
                data-model-graph
              >
                <svg class="graph-flow" viewBox="0 0 100 100" aria-hidden="true">
                  <path class="graph-flow-line flow-1" data-flow-edge d=""></path>
                  <path class="graph-flow-line flow-2" data-flow-edge d=""></path>
                  <path class="graph-flow-line flow-3" data-flow-edge d=""></path>
                </svg>
                <div class="graph-resources">
                  <div class="graph-resource resource-frontend">
                    <span class="graph-resource-card">
                      <span class="graph-handle graph-handle-right" aria-hidden="true"></span>
                      <span class="graph-node-head">
                        <span class="graph-resource-icon-cycle cycle-three">
                          {
                            frontendResourceIcons.map((icon, index) => (
                              <Image
                                src={icon}
                                alt=""
                                class="graph-resource-icon"
                                width="28"
                                height="28"
                                loading="eager"
                                style={`--resource-icon-delay: ${getModelResourceDelay('frontend', frontendResourceIcons.length, index)}s`}
                              />
                            ))
                          }
                        </span>
                        <span class="graph-node-type">Frontend</span>
                      </span>
                      <span class="graph-node-name">frontend</span>
                    </span>
                  </div>
                  <div class="graph-resource resource-api">
                    <span class="graph-resource-card">
                      <span class="graph-handle graph-handle-left" aria-hidden="true"></span>
                      <span class="graph-handle graph-handle-right" aria-hidden="true"></span>
                      <span class="graph-node-head">
                        <span class="graph-resource-icon-cycle cycle-four">
                          {
                            apiResourceIcons.map((icon, index) => (
                              <Image
                                src={icon}
                                alt=""
                                class="graph-resource-icon"
                                width="28"
                                height="28"
                                loading="eager"
                                style={`--resource-icon-delay: ${getModelResourceDelay('api', apiResourceIcons.length, index)}s`}
                              />
                            ))
                          }
                        </span>
                        <span class="graph-node-type">Service</span>
                      </span>
                      <span class="graph-node-name">catalogservice</span>
                    </span>
                  </div>
                  <div class="graph-resource resource-database">
                    <span class="graph-resource-card">
                      <span class="graph-handle graph-handle-left" aria-hidden="true"></span>
                      <span class="graph-node-head">
                        <span class="graph-resource-icon-cycle cycle-four">
                          {
                            databaseResourceIcons.map((icon, index) => (
                              <Image
                                src={icon}
                                alt=""
                                class="graph-resource-icon"
                                width="28"
                                height="28"
                                loading="eager"
                                style={`--resource-icon-delay: ${getModelResourceDelay('database', databaseResourceIcons.length, index)}s`}
                              />
                            ))
                          }
                        </span>
                        <span class="graph-node-type">Database</span>
                      </span>
                      <span class="graph-node-name">postgres</span>
                    </span>
                  </div>
                  <div class="graph-resource resource-cache">
                    <span class="graph-resource-card">
                      <span class="graph-handle graph-handle-left" aria-hidden="true"></span>
                      <span class="graph-node-head">
                        <span class="graph-resource-icon-cycle cycle-three">
                          {
                            cacheResourceIcons.map((icon, index) => (
                              <Image
                                src={icon}
                                alt=""
                                class={`graph-resource-icon${index === 0 ? ' cache-icon' : ''}`}
                                width="28"
                                height="28"
                                loading="eager"
                                style={`--resource-icon-delay: ${getModelResourceDelay('cache', cacheResourceIcons.length, index)}s`}
                              />
                            ))
                          }
                        </span>
                        <span class="graph-node-type">Cache</span>
                      </span>
                      <span class="graph-node-name">basketcache</span>
                    </span>
                  </div>
                </div>

                <div class="graph-flow-labels" aria-hidden="true">
                  <span class="graph-flow-label label-discovery">
                    <svg
                      class="flow-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"><path d="M4 12h13m-5-5 5 5-5 5"></path></svg
                    >
                    <span>service discovery</span>
                  </span>
                  <span class="graph-flow-label label-connection">
                    <svg
                      class="flow-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"><path d="M4 12h13m-5-5 5 5-5 5"></path></svg
                    >
                    <span>connection string</span>
                  </span>
                  <span class="graph-flow-label label-cache">
                    <svg
                      class="flow-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"><path d="M4 12h13m-5-5 5 5-5 5"></path></svg
                    >
                    <span>cache client</span>
                  </span>
                </div>
              </div>

              <div
                class="model-story-panel model-dashboard"
                data-story-panel="dashboard"
                data-model-dashboard
              >
                <div class="dash-head" aria-hidden="true">
                  <span class="dash-col-name">Name</span>
                  <span class="dash-col-state">State</span>
                  <span class="dash-col-source">Source</span>
                  <span class="dash-col-url">URLs</span>
                </div>
                <div class="dash-body">
                  <div class="dash-row" data-dash-row>
                    <span class="dash-name">
                      <Image src={postgresqlIcon} alt="" class="dash-icon" width="22" height="22" />
                      <span>postgres</span>
                    </span>
                    <span class="dash-state">
                      <span class="dash-dot" aria-hidden="true"></span>
                      <span class="dash-state-text"></span>
                    </span>
                    <span class="dash-source">docker.io/library/postgres:18.3</span>
                    <span class="dash-url"
                      ><a class="dash-link" tabindex="-1">tcp://localhost:5432</a></span
                    >
                  </div>
                  <div class="dash-row" data-dash-row>
                    <span class="dash-name">
                      <Image src={redisIcon} alt="" class="dash-icon" width="22" height="22" />
                      <span>basketcache</span>
                    </span>
                    <span class="dash-state">
                      <span class="dash-dot" aria-hidden="true"></span>
                      <span class="dash-state-text"></span>
                    </span>
                    <span class="dash-source">docker.io/library/redis:8.6</span>
                    <span class="dash-url"
                      ><a class="dash-link" tabindex="-1">tcp://localhost:6379</a></span
                    >
                  </div>
                  <div class="dash-row" data-dash-row>
                    <span class="dash-name">
                      <Image src={csharpIcon} alt="" class="dash-icon" width="22" height="22" />
                      <span>catalogservice</span>
                    </span>
                    <span class="dash-state">
                      <span class="dash-dot" aria-hidden="true"></span>
                      <span class="dash-state-text"></span>
                    </span>
                    <span class="dash-source">AspireShop.CatalogService.csproj</span>
                    <span class="dash-url"
                      ><a class="dash-link" tabindex="-1">https://localhost:7099</a></span
                    >
                  </div>
                  <div class="dash-row" data-dash-row>
                    <span class="dash-name">
                      <Image src={reactIcon} alt="" class="dash-icon" width="22" height="22" />
                      <span>frontend</span>
                    </span>
                    <span class="dash-state">
                      <span class="dash-dot" aria-hidden="true"></span>
                      <span class="dash-state-text"></span>
                    </span>
                    <span class="dash-source">AspireShop.Frontend.csproj</span>
                    <span class="dash-url"
                      ><a class="dash-link" tabindex="-1">https://localhost:7188</a></span
                    >
                  </div>
                </div>
                <div class="dash-foot" aria-hidden="true">
                  <span class="dash-foot-count"
                    ><b data-dash-count>0</b> of 4 resources running</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <ol class="principle-list">
          {
            principles.map((principle, index) => (
              <li data-home-reveal style={`--home-reveal-delay: ${index * 70}ms`}>
                <span class="principle-number">{principle.number}</span>
                <div class="principle-icon" aria-hidden="true">
                  <Icon name={principle.icon} size="1.25rem" />
                </div>
                <div>
                  <h3>{principle.title}</h3>
                  <p>{principle.description}</p>
                  <a href={principle.href} data-home-link data-home-link-icon>
                    {principle.label}
                    <Icon name="right-arrow" size="0.95rem" />
                  </a>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <HomeEnvironment />

  <section class="home-section home-dashboard" aria-labelledby="home-dashboard-title">
    <div class="home-shell">
      <header class="section-heading dashboard-heading" data-home-reveal>
        <p class="section-index"><span>05</span> Observability included</p>
        <h2 id="home-dashboard-title">See the whole application. Not just one service.</h2>
        <p>
          Follow a request across resources, move between structured logs and traces, inspect
          metrics, and act on resource health from one developer dashboard.
        </p>
        <HomeAgentBadge
          id="dashboard-ai-context"
          label="Agents act on these signals"
          description="Aspire gives connected AI tools dashboard context, including logs, traces, metrics, health, and resource commands."
          tone="dark"
          align="center"
        />
        <a class="text-link" href="/dashboard/" data-home-link data-home-link-icon>
          Explore the Aspire dashboard
          <Icon name="right-arrow" size="1rem" />
        </a>
      </header>

      <div class="dashboard-stage" data-home-reveal data-home-reveal-distance="major">
        <div class="dashboard-stage-bar" aria-hidden="true">
          <span><i></i><i></i><i></i></span>
          <strong>Aspire dashboard</strong>
          <small>Resources / Graph</small>
        </div>
        <DashboardCarousel autoplay={true} presentation="stage" />
      </div>
    </div>
  </section>

  <section class="home-section home-integrations" aria-labelledby="home-integrations-title">
    <div class="home-shell">
      <header class="section-heading integrations-heading" data-home-reveal>
        <p class="section-index"><span>06</span> Extensible by default</p>
        <h2 id="home-integrations-title">Use the services you already trust.</h2>
        <p>
          Add databases, caches, messaging, cloud resources, and community integrations through the
          same fluent application model.
        </p>
      </header>
      <div data-home-reveal data-home-reveal-distance="major">
        <HomeIntegrationRail />
      </div>
      <a
        class="text-link integration-link"
        href="/integrations/"
        data-home-link
        data-home-link-icon
        data-home-reveal
      >
        Browse every integration
        <Icon name="right-arrow" size="1rem" />
      </a>
    </div>
  </section>

  <HomeTestimonials />

  <section class="home-section home-closing" aria-labelledby="home-closing-title">
    <div class="closing-grid" aria-hidden="true"></div>
    <div class="closing-orbit orbit-a" aria-hidden="true"></div>
    <div class="closing-orbit orbit-b" aria-hidden="true"></div>
    <div class="home-shell closing-content" data-home-reveal data-home-reveal-distance="major">
      <p class="section-index"><span>08</span> Start with your stack</p>
      <h2 id="home-closing-title">Make the whole application easier to build.</h2>
      <p>
        Install the Aspire CLI, initialize an existing repository or start fresh, then bring every
        resource into one clear development loop.
      </p>
      <div class="closing-actions">
        <a class="closing-action primary" href="/get-started/install-cli/">
          Install Aspire
          <Icon name="right-arrow" size="1rem" />
        </a>
        <a class="closing-action secondary" href="/get-started/first-app/">
          Build your first app
        </a>
        <a class="closing-action tertiary" href="https://github.com/dotnet/aspire">
          <Icon name="github" size="1.1rem" />
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  type AppHostLanguage = 'csharp' | 'typescript';
  type ModelStoryStage = 'code' | 'topology' | 'dashboard';

  function isAppHostLanguage(value: unknown): value is AppHostLanguage {
    return value === 'csharp' || value === 'typescript';
  }

  function randomizeLanguageOrder(page: HTMLElement) {
    const list = page.querySelector<HTMLElement>('[data-language-list]');
    if (!list || list.dataset.randomized === 'true') return;

    const items = Array.from(list.querySelectorAll<HTMLElement>(':scope > li'));
    for (let index = items.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [items[index], items[randomIndex]] = [items[randomIndex]!, items[index]!];
    }

    const fragment = document.createDocumentFragment();
    items.forEach((item, index) => {
      item.style.setProperty('--home-reveal-delay', `${index * 45}ms`);
      fragment.append(item);
    });
    list.append(fragment);
    list.dataset.randomized = 'true';
  }

  function createModelStory(root: HTMLElement, reducedMotion: boolean) {
    const command = root.querySelector<HTMLElement>('[data-terminal-command]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-model-story-toggle]');
    const outputLines = Array.from(root.querySelectorAll<HTMLElement>('[data-terminal-output]'));
    const stageLabels = Array.from(root.querySelectorAll<HTMLElement>('[data-model-stage-label]'));
    const graph = root.querySelector<HTMLElement>('[data-model-graph]');
    if (!command || !toggle) return null;

    const commandText = command.dataset.command ?? 'aspire run';
    const cycleDuration = 10_800;
    const commandStart = 280;
    const commandInterval = 58;
    const commandEnd = commandStart + Math.max(commandText.length - 1, 0) * commandInterval;
    const stageOrder: Record<ModelStoryStage, number> = { code: 0, topology: 1, dashboard: 2 };
    const stageResumeAt: Record<ModelStoryStage, number> = {
      code: 1_500,
      topology: 3_800,
      dashboard: 6_400,
    };
    const timers = new Set<number>();
    let playing = false;
    let playbackAllowed = false;
    let manuallyPaused = false;
    let cycleElapsed = 0;
    let cycleStartedAt = 0;

    const dashboard = root.querySelector<HTMLElement>('[data-model-dashboard]');
    const dashRows = dashboard
      ? Array.from(dashboard.querySelectorAll<HTMLElement>('[data-dash-row]'))
      : [];
    const dashCount = dashboard?.querySelector<HTMLElement>('[data-dash-count]') ?? null;
    const dashTimers = new Set<number>();
    let dashState: 'idle' | 'animating' | 'final' = 'idle';

    const clearDashTimers = () => {
      dashTimers.forEach((timer) => window.clearTimeout(timer));
      dashTimers.clear();
    };

    const setDashCount = (value: number) => {
      if (dashCount) dashCount.textContent = String(value);
    };

    const resetDashboard = () => {
      if (!dashboard || dashState === 'idle') return;
      clearDashTimers();
      dashState = 'idle';
      dashRows.forEach((row) => row.classList.remove('is-visible', 'is-online'));
      setDashCount(0);
    };

    const finalizeDashboard = () => {
      if (!dashboard) return;
      clearDashTimers();
      dashState = 'final';
      dashRows.forEach((row) => row.classList.add('is-visible', 'is-online'));
      setDashCount(dashRows.length);
    };

    const animateDashboard = () => {
      if (!dashboard || dashState === 'animating') return;
      clearDashTimers();
      dashState = 'animating';
      dashRows.forEach((row) => row.classList.remove('is-visible', 'is-online'));
      setDashCount(0);
      let online = 0;
      dashRows.forEach((row, index) => {
        const appearAt = 140 + index * 300;
        const onlineAt = appearAt + 900 + index * 160;
        const appearTimer = window.setTimeout(() => {
          dashTimers.delete(appearTimer);
          row.classList.add('is-visible');
        }, appearAt);
        dashTimers.add(appearTimer);
        const onlineTimer = window.setTimeout(() => {
          dashTimers.delete(onlineTimer);
          row.classList.add('is-online');
          online += 1;
          setDashCount(online);
        }, onlineAt);
        dashTimers.add(onlineTimer);
      });
    };

    const showDashboard = (animate: boolean) => {
      if (animate) animateDashboard();
      else finalizeDashboard();
    };

    const clearTimers = () => {
      timers.forEach((timer) => window.clearTimeout(timer));
      timers.clear();
    };

    const scheduleAt = (callback: () => void, timestamp: number) => {
      const delay = timestamp - cycleElapsed;
      if (delay < 0) return;

      const timer = window.setTimeout(() => {
        timers.delete(timer);
        if (playing) callback();
      }, delay);
      timers.add(timer);
    };

    const updateControl = () => {
      toggle.dataset.paused = String(manuallyPaused);
      toggle.setAttribute('aria-pressed', String(manuallyPaused));
      toggle.setAttribute(
        'aria-label',
        manuallyPaused ? 'Play runtime story' : 'Pause runtime story'
      );
    };

    const setStage = (stage: ModelStoryStage) => {
      root.dataset.storyStage = stage;
      stageLabels.forEach((label) => {
        const active = label.dataset.modelStageLabel === stage;
        label.dataset.active = String(active);
        label.setAttribute('aria-pressed', String(active));
      });
      graph?.toggleAttribute('data-graph-active', playing && stage === 'topology');
      if (stage === 'dashboard') {
        showDashboard(playing && !reducedMotion);
      } else {
        resetDashboard();
      }
    };

    const revealOutput = (index: number) => {
      outputLines[index]?.classList.add('is-visible');
    };

    const snapToStage = (stage: ModelStoryStage) => {
      manuallyPaused = true;
      updateControl();
      pause();
      command.textContent = commandText;
      root.removeAttribute('data-terminal-typing');
      const order = stageOrder[stage];
      outputLines.forEach((line) => {
        const lineStage = (line.dataset.stage as ModelStoryStage) ?? 'code';
        line.classList.toggle('is-visible', stageOrder[lineStage] <= order);
      });
      setStage(stage);
      graph?.toggleAttribute('data-graph-active', stage === 'topology');
      cycleElapsed = stageResumeAt[stage];
    };

    const handleStageClick = (event: Event) => {
      const stage = (event.currentTarget as HTMLElement).dataset.modelStageLabel;
      if (stage === 'code' || stage === 'topology' || stage === 'dashboard') {
        snapToStage(stage);
      }
    };

    const setLanguage = (language: AppHostLanguage) => {
      root.dataset.storyLanguage = language;
    };

    const reset = () => {
      command.textContent = '';
      outputLines.forEach((line) => line.classList.remove('is-visible'));
      root.setAttribute('data-terminal-typing', 'true');
      setStage('code');
    };

    const pause = () => {
      if (playing) {
        cycleElapsed = Math.min(cycleDuration, performance.now() - cycleStartedAt);
      }
      playing = false;
      clearTimers();
      root.removeAttribute('data-terminal-typing');
      root.dataset.storyPlaying = 'false';
      graph?.removeAttribute('data-graph-active');
    };

    const showFinalState = () => {
      pause();
      command.textContent = commandText;
      outputLines.forEach((line) => line.classList.add('is-visible'));
      setStage('dashboard');
      cycleElapsed = cycleDuration;
    };

    const scheduleTimeline = () => {
      Array.from(commandText).forEach((_, index) => {
        scheduleAt(
          () => {
            command.textContent = commandText.slice(0, index + 1);
            if (index === commandText.length - 1) {
              root.removeAttribute('data-terminal-typing');
            }
          },
          commandStart + index * commandInterval
        );
      });

      scheduleAt(() => revealOutput(0), 1_250);
      scheduleAt(() => {
        revealOutput(1);
        setStage('topology');
      }, 2_350);
      scheduleAt(() => revealOutput(2), 3_300);
      scheduleAt(() => {
        revealOutput(3);
        setStage('dashboard');
      }, 4_600);
      scheduleAt(() => revealOutput(4), 5_300);
      scheduleAt(() => revealOutput(5), 6_100);
      scheduleAt(() => {
        cycleElapsed = 0;
        cycleStartedAt = performance.now();
        reset();
        scheduleTimeline();
      }, cycleDuration);
    };

    const resume = () => {
      if (playing || reducedMotion || manuallyPaused || !playbackAllowed) return;

      if (cycleElapsed >= cycleDuration) {
        cycleElapsed = 0;
      }
      if (cycleElapsed === 0) {
        reset();
      }

      clearTimers();
      playing = true;
      cycleStartedAt = performance.now() - cycleElapsed;
      root.dataset.storyPlaying = 'true';
      root.toggleAttribute('data-terminal-typing', cycleElapsed < commandEnd);
      graph?.toggleAttribute('data-graph-active', root.dataset.storyStage === 'topology');
      scheduleTimeline();
    };

    const syncPlayback = () => {
      if (playbackAllowed && !manuallyPaused) {
        resume();
      } else {
        pause();
      }
    };

    const setPlaybackAllowed = (allowed: boolean) => {
      playbackAllowed = allowed;
      syncPlayback();
    };

    const handleToggle = () => {
      manuallyPaused = !manuallyPaused;
      updateControl();
      syncPlayback();
    };

    const flowSvg = graph?.querySelector<SVGSVGElement>('.graph-flow') ?? null;
    const edgeSpecs = [
      {
        path: '.flow-1',
        from: '.resource-frontend .graph-handle-right',
        to: '.resource-api .graph-handle-left',
        label: '.label-discovery',
      },
      {
        path: '.flow-2',
        from: '.resource-api .graph-handle-right',
        to: '.resource-database .graph-handle-left',
        label: '.label-connection',
      },
      {
        path: '.flow-3',
        from: '.resource-frontend .graph-handle-right',
        to: '.resource-cache .graph-handle-left',
        label: '.label-cache',
      },
    ];

    const handleCenter = (el: Element, originX: number, originY: number) => {
      const r = el.getBoundingClientRect();
      return { x: r.left + r.width / 2 - originX, y: r.top + r.height / 2 - originY };
    };

    const routeEdges = () => {
      if (!graph || !flowSvg) return;
      const rect = flowSvg.getBoundingClientRect();
      if (rect.width < 1 || rect.height < 1) return;
      flowSvg.setAttribute('viewBox', `0 0 ${rect.width.toFixed(1)} ${rect.height.toFixed(1)}`);
      for (const spec of edgeSpecs) {
        const path = flowSvg.querySelector<SVGPathElement>(spec.path);
        const fromEl = graph.querySelector(spec.from);
        const toEl = graph.querySelector(spec.to);
        if (!path || !fromEl || !toEl) continue;
        const s = handleCenter(fromEl, rect.left, rect.top);
        const t = handleCenter(toEl, rect.left, rect.top);
        const k = Math.max(26, Math.abs(t.x - s.x) * 0.5);
        path.setAttribute(
          'd',
          `M ${s.x.toFixed(1)} ${s.y.toFixed(1)} C ${(s.x + k).toFixed(1)} ${s.y.toFixed(1)}, ${(t.x - k).toFixed(1)} ${t.y.toFixed(1)}, ${t.x.toFixed(1)} ${t.y.toFixed(1)}`
        );
        const label = graph.querySelector<HTMLElement>(spec.label);
        if (label) {
          label.style.left = `${((s.x + t.x) / 2).toFixed(1)}px`;
          label.style.top = `${((s.y + t.y) / 2).toFixed(1)}px`;
          const arrow = label.querySelector<SVGElement>('.flow-arrow');
          if (arrow) {
            const angle = (Math.atan2(t.y - s.y, t.x - s.x) * 180) / Math.PI;
            arrow.style.transform = `rotate(${angle.toFixed(1)}deg)`;
          }
        }
      }
    };

    let routeRaf = 0;
    const routeTick = () => {
      routeEdges();
      routeRaf = requestAnimationFrame(routeTick);
    };
    const stopRouting = () => {
      if (routeRaf) {
        cancelAnimationFrame(routeRaf);
        routeRaf = 0;
      }
    };
    const startRouting = () => {
      stopRouting();
      routeRaf = reducedMotion
        ? requestAnimationFrame(() => {
            routeEdges();
            routeRaf = 0;
          })
        : requestAnimationFrame(routeTick);
    };
    const handleGraphActive = () => {
      if (graph?.hasAttribute('data-graph-active')) startRouting();
      else stopRouting();
    };

    let graphActiveObserver: MutationObserver | null = null;
    let graphResizeObserver: ResizeObserver | null = null;
    if (graph && flowSvg) {
      graphActiveObserver = new MutationObserver(handleGraphActive);
      graphActiveObserver.observe(graph, {
        attributes: true,
        attributeFilter: ['data-graph-active'],
      });
      if (typeof ResizeObserver !== 'undefined') {
        graphResizeObserver = new ResizeObserver(() => routeEdges());
        graphResizeObserver.observe(graph);
      }
      handleGraphActive();
    }

    const destroy = () => {
      pause();
      stopRouting();
      clearDashTimers();
      graphActiveObserver?.disconnect();
      graphResizeObserver?.disconnect();
      toggle.removeEventListener('click', handleToggle);
      stageLabels.forEach((label) => label.removeEventListener('click', handleStageClick));
    };

    toggle.addEventListener('click', handleToggle);
    stageLabels.forEach((label) => label.addEventListener('click', handleStageClick));
    updateControl();

    if (reducedMotion) {
      toggle.disabled = true;
      showFinalState();
    }

    return { destroy, setLanguage, setPlaybackAllowed };
  }

  function initializeHomeReveals() {
    const page = document.querySelector<HTMLElement>('.aspire-home');
    if (!page || page.dataset.revealsInitialized === 'true') return;

    randomizeLanguageOrder(page);
    page.dataset.revealsInitialized = 'true';
    document.documentElement.dataset.homeJs = 'true';
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-home-reveal]'));
    const modelStoryRoot = page.querySelector<HTMLElement>('[data-model-story]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const modelStory = modelStoryRoot
      ? createModelStory(modelStoryRoot, reducedMotion.matches)
      : null;
    const selectedLanguage = page.querySelector<HTMLButtonElement>(
      '.home-hero-product .lang-toggle[aria-pressed="true"]'
    )?.dataset.lang;
    if (modelStory && isAppHostLanguage(selectedLanguage)) {
      modelStory.setLanguage(selectedLanguage);
    }

    const handleAppHostLanguageChange = (event: Event) => {
      const language = (event as CustomEvent<{ language?: unknown }>).detail?.language;
      if (modelStory && isAppHostLanguage(language)) {
        modelStory.setLanguage(language);
      }
    };
    document.addEventListener('aspire:apphost-language-change', handleAppHostLanguageChange);

    const canObserve = 'IntersectionObserver' in window;
    let modelStoryVisible = false;

    let observer: IntersectionObserver | null = null;
    if (reducedMotion.matches || !canObserve) {
      items.forEach((item) => item.classList.add('home-visible'));
    } else {
      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('home-visible');
            observer?.unobserve(entry.target);
          });
        },
        {
          rootMargin: '0px 0px -9% 0px',
          threshold: 0.08,
        }
      );
      items.forEach((item) => observer?.observe(item));
    }

    const updateModelStoryPlayback = () => {
      if (!modelStory || reducedMotion.matches) return;
      modelStory.setPlaybackAllowed(modelStoryVisible && !document.hidden);
    };

    const storyObserver =
      modelStoryRoot && modelStory && canObserve && !reducedMotion.matches
        ? new IntersectionObserver(
            ([entry]) => {
              modelStoryVisible = entry?.isIntersecting ?? false;
              updateModelStoryPlayback();
            },
            { rootMargin: '-10% 0px', threshold: 0.2 }
          )
        : null;
    if (modelStoryRoot && storyObserver) {
      storyObserver.observe(modelStoryRoot);
    } else if (modelStory && !reducedMotion.matches) {
      modelStoryVisible = true;
      updateModelStoryPlayback();
    }

    document.addEventListener('visibilitychange', updateModelStoryPlayback);

    document.addEventListener(
      'astro:before-swap',
      () => {
        observer?.disconnect();
        storyObserver?.disconnect();
        modelStory?.destroy();
        document.removeEventListener('visibilitychange', updateModelStoryPlayback);
        document.removeEventListener('aspire:apphost-language-change', handleAppHostLanguageChange);
        delete page.dataset.revealsInitialized;
      },
      { once: true }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeHomeReveals, { once: true });
  } else {
    initializeHomeReveals();
  }
  document.addEventListener('astro:after-swap', initializeHomeReveals);
</script>

