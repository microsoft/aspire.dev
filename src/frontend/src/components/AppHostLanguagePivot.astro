---
import Pivot from '@components/Pivot.astro';
import {
  getAppHostLanguage,
  type AppHostLanguageId,
} from '@utils/apphost-languages';

interface Props {
  id: AppHostLanguageId;
}

const { id } = Astro.props;
const language = getAppHostLanguage(id);
---

{language.enabled && <Pivot {id}><slot /></Pivot>}
