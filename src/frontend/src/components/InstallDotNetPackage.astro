---
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';

export interface Props {
  packageName: string;
}

const { packageName } = Astro.props;

const cliCommandTitle = `.NET CLI — Add ${packageName} package`;
const cliCode = `dotnet add package ${packageName}`;

const packageReferenceTitle = `XML — Add ${packageName} package reference`;
const packageCode = `<PackageReference Include="${packageName}" Version="*" />`;
const integrationId = packageName.toLowerCase();
const publisher = integrationId.startsWith('aspire.') ? 'official' : 'community';
---

<div
  data-integration-context
  data-funnel="integration_adoption"
  data-funnel-surface="integration_page"
  data-funnel-integration={integrationId}
  data-funnel-publisher={publisher}
  data-funnel-integration-kind="client"
>
  <Tabs syncKey="dotnet-install">
    <TabItem label=".NET CLI">
      <div
        data-funnel-step="install_command_copied"
        data-funnel-trigger="copy"
        data-funnel-method="dotnet_cli"
        data-funnel-language="csharp"
      >
        <Code lang="bash" frame="terminal" title={cliCommandTitle} code={cliCode} />
      </div>
    </TabItem>
    <TabItem label="Program.cs (C# file-based app)">
      <div
        data-funnel-step="install_command_copied"
        data-funnel-trigger="copy"
        data-funnel-method="file_directive"
        data-funnel-language="csharp"
      >
        <Code lang="csharp" title={`Program.cs`} code={`#:package ${packageName}@*`} />
      </div>
    </TabItem>
    <TabItem label="PackageReference (*.csproj)">
      <div
        data-funnel-step="install_command_copied"
        data-funnel-trigger="copy"
        data-funnel-method="package_reference"
        data-funnel-language="csharp"
      >
        <Code lang="xml" title={packageReferenceTitle} code={packageCode} />
      </div>
    </TabItem>
  </Tabs>
</div>
