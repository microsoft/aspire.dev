---
import { Tabs, TabItem } from '@astrojs/starlight/components';

interface Props {
  syncKey?: string;
}

const { syncKey = 'terminal' } = Astro.props;
---

<Tabs syncKey={syncKey}>
  <TabItem label="Bash" icon="seti:shell">
    <slot name="unix" />
  </TabItem>
  <TabItem label="PowerShell" icon="seti:powershell">
    <slot name="windows" />
  </TabItem>
</Tabs>

{syncKey && <span hidden data-os-aware-tabs-sync-key={syncKey} />}

<script>
  // Bundled once per site instead of an inline script per component instance.
  import { initOsAwareTabs } from '@scripts/os-aware-tabs';

  initOsAwareTabs();
  document.addEventListener('astro:page-load', initOsAwareTabs);
</script>
