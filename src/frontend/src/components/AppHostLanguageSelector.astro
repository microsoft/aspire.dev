---
import PivotSelector from '@components/PivotSelector.astro';
import { getEnabledAppHostLanguages } from '@utils/apphost-languages';

interface Props {
  title?: string;
  marginTop?: number | null;
}

const {
  title = 'Select your AppHost language',
  marginTop,
} = Astro.props;
const options = getEnabledAppHostLanguages().map((language) => ({
  id: language.id,
  title: language.label,
  badge: language.experimental ? 'Experimental' : undefined,
}));
---

<PivotSelector key="aspire-lang" {options} {title} {marginTop} />
