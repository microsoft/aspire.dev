{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@playwright/test": ["./tests/cdp/playwright-test-shim.ts"],
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@data/*": ["./src/data/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@tests/e2e/*": ["./tests/e2e/*"],
      "@tests/typecheck/*": ["./tests/typecheck/*"],
      "@tests/unit/*": ["./tests/unit/*"],
      "@tests/*": ["./tests/*"],
      "@utils/*": ["./src/utils/*"]
    }
  }
}
