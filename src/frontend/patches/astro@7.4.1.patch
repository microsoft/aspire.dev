+const routeDependencyHashes = new WeakMap();
+/**
+* The route's module-graph hash plus the stylesheets its HTML links. CSS generated after
+* transform (UnoCSS fills a placeholder) is invisible to the module graph, so without the
+* emitted sheets a restored page can link a stylesheet this build no longer writes.
+*/
+function getRouteDependencyHash(internals, route) {
+	let hash = routeDependencyHashes.get(route);
+	if (hash !== undefined) return hash;
+	hash = internals.pageDependencyHashes?.get(route.component) ?? "";
+	const sheets = getPageData(internals, route.route, route.component)?.styles.map(({ sheet }) => sheet.type === "external" ? `external:${sheet.src}` : `inline:${sheet.content}`).sort();
