+        } catch (error) {
+          if (signal.aborted) return;
+          console.error(error);
+          copyButtonClass = "error";
+        } finally {
+          copyButton.disabled = false;
+          if (!signal.aborted) {
+            copyButton.classList.add(copyButtonClass);
+            const timer = setTimeout(() => {
