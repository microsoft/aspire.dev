<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.3653345">
  <PropertyGroup>
    <PublishAssetsDirectory>$(MSBuildProjectDirectory)/dist</PublishAssetsDirectory>
    <PublishAssetsDirectory Condition="'$(ASPIRE_HYBRID_API_DOCS)' == '1'">$(MSBuildProjectDirectory)/dist-hybrid/client</PublishAssetsDirectory>
    <BuildCommand>pnpm run build</BuildCommand>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <!-- Disables running the build (or compile) script located on package.json during Build -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)/obj/$(Configuration)</IntermediateOutputPath>
    <IntermediateOutputPath Condition="'$(ASPIRE_HYBRID_API_DOCS)' == '1'">$(MSBuildProjectDirectory)/obj/$(Configuration)/hybrid</IntermediateOutputPath>
  </PropertyGroup>
</Project>