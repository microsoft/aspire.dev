{
  "viewport": { "width": 1280, "height": 800, "deviceScaleFactor": 2 },
  "padding": 16,
  "notes": "out.dark / out.light are paths relative to src/frontend/src/assets/dashboard. Steps: click(text) clickSel(css) hover(text) fill([css,value]) press(key) wait(ms). clip = css selector (cropped with padding). callouts = css selectors outlined in red.",
  "shots": [
    { "id": "landing-resources", "autoCrop": true, "out": { "dark": "landing/resources-table-dark.png", "light": "landing/resources-table-light.png" }, "route": "resources" },
    { "id": "landing-graph", "out": { "dark": "landing/resources-graph-dark.png", "light": "landing/resources-graph-light.png" }, "route": "resources", "steps": [{ "clickSel": "[aria-label*='Settings' i]" }, { "wait": 600 }, { "click": "Graph" }, { "wait": 600 }, { "closeDialog": true }, { "wait": 800 }, { "click": "Overview" }, { "wait": 2500 }] },
    { "id": "landing-console", "out": { "dark": "landing/console-dark.png", "light": "landing/console-light.png" }, "route": "consolelogs/resource/apiservice" },
    { "id": "landing-structured", "out": { "dark": "landing/structured-logs-dark.png", "light": "landing/structured-logs-light.png" }, "route": "structuredlogs" },
    { "id": "landing-traces", "out": { "dark": "landing/traces-dark.png", "light": "landing/traces-light.png" }, "route": "traces" },
    { "id": "landing-trace-detail", "height": 560, "out": { "dark": "landing/trace-detail-dark.png", "light": "landing/trace-detail-light.png" }, "route": "traces", "steps": [{ "click": "webfrontend: GET" }, { "wait": 2000 }] },
    { "id": "landing-metrics", "out": { "dark": "landing/metrics-dark.png", "light": "landing/metrics-light.png" }, "route": "metrics/resource/apiservice" },

    { "id": "projects", "autoCrop": true, "out": { "dark": "explore/projects.png", "light": "explore/projects-light.png" }, "route": "resources" },
    { "id": "resource-details", "out": { "dark": "explore/resource-details.png", "light": "explore/resource-details-light.png" }, "route": "resources", "steps": [{ "click": "apiservice" }, { "wait": 1500 }] },
    { "id": "resource-actions", "out": { "dark": "explore/resource-actions.png", "light": "explore/resource-actions-light.png" }, "route": "resources", "steps": [{ "hover": "apiservice" }, { "wait": 400 }, { "clickSel": "[aria-label^='Actions for' i]" }, { "wait": 600 }], "callouts": ["[role=menu]"] },
    { "id": "project-logs", "out": { "dark": "explore/project-logs.png", "light": "explore/project-logs-light.png" }, "route": "consolelogs/resource/apiservice" },
    { "id": "structured-logs", "out": { "dark": "explore/structured-logs.png", "light": "explore/structured-logs-light.png" }, "route": "structuredlogs" },
    { "id": "structured-logs-errors", "out": { "dark": "explore/structured-logs-errors.png", "light": "explore/structured-logs-errors-light.png" }, "route": "structuredlogs?logLevel=error" },
    { "id": "traces", "out": { "dark": "explore/traces.png", "light": "explore/traces-light.png" }, "route": "traces" },
    { "id": "trace", "height": 560, "out": { "dark": "explore/trace.png", "light": "explore/trace-light.png" }, "route": "traces", "steps": [{ "click": "webfrontend: GET" }, { "wait": 2000 }] },
    { "id": "metrics-view", "out": { "dark": "explore/metrics-view.png", "light": "explore/metrics-view-light.png" }, "route": "metrics/resource/apiservice" },
    { "id": "dashboard-help", "out": { "dark": "explore/dashboard-help.png", "light": "explore/dashboard-help-light.png" }, "route": "resources", "steps": [{ "clickSel": "[aria-label*='Help' i]" }, { "wait": 800 }] },
    { "id": "notification-center-open", "out": { "dark": "explore/notification-center-open.png", "light": "explore/notification-center-open-light.png" }, "route": "resources", "steps": [{ "clickSel": "[aria-label*='Notification' i]" }, { "wait": 800 }] },
    { "id": "theme-selection", "out": { "dark": "explore/theme-selection.png", "light": "explore/theme-selection-light.png" }, "route": "resources", "steps": [{ "clickSel": "[aria-label*='Settings' i]" }, { "wait": 800 }] },
    { "id": "manage-data", "out": { "dark": "explore/manage-data-dialog.png", "light": "explore/manage-data-dialog-light.png" }, "route": "resources", "steps": [{ "clickSel": "[aria-label*='Settings' i]" }, { "wait": 600 }, { "click": "Manage" }, { "wait": 800 }] }
  ]
}
